---
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<div class={`deco-rule${cls ? ' ' + cls : ''}`} aria-hidden="true">
  <span class="deco-line"></span>
  <span class="deco-diamond">◆</span>
  <span class="deco-line"></span>
</div>

<style>
.deco-rule {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  width: 100%;
  max-width: 24rem;
  margin-inline: auto;
  padding-block: 0.25rem;
}
.deco-line {
  flex: 1;
  height: 1px;
  background: var(--gold);
  opacity: 0.6;
}
.deco-diamond {
  font-size: 0.45rem;
  color: var(--gold);
  opacity: 0.8;
  line-height: 1;
}
</style>
