---
// Shared floorplan zoom modal — used by wohngemeinschaften index and verfügbarkeit.
// Trigger any button/element with:  data-fp-open  data-fp-src="..."  data-fp-title-de="..."  data-fp-title-en="..."
---

<div id="vtfp-overlay" class="vtfp-overlay hidden" aria-hidden="true">
  <div class="vtfp-modal" role="dialog" aria-modal="true">
    <div class="vtfp-header">
      <p class="vtfp-title" id="vtfp-title"></p>
      <div class="vtfp-controls">
        <button class="vtfp-ctrl" id="vtfp-out" aria-label="Verkleinern">−</button>
        <span class="vtfp-pct" id="vtfp-pct">100%</span>
        <button class="vtfp-ctrl" id="vtfp-in" aria-label="Vergrößern">+</button>
        <button class="vtfp-ctrl vtfp-close" id="vtfp-close" aria-label="Schließen">×</button>
      </div>
    </div>
    <div id="vtfp-stage" class="vtfp-stage">
      <div id="vtfp-wrap" class="vtfp-wrap">
        <img id="vtfp-img" src="" alt="" />
      </div>
    </div>
  </div>
</div>

<style>
.vtfp-overlay {
  position: fixed;
  inset: 0;
  background: rgba(28, 26, 23, 0.6);
  display: grid;
  place-items: center;
  padding: 2rem;
  z-index: 400;
}
.vtfp-overlay.hidden { display: none; }
.vtfp-modal {
  background: var(--bg);
  width: min(100%, 820px);
  height: min(90vh, 700px);
  border: 1px solid var(--border);
  box-shadow: 0 24px 64px rgba(28, 26, 23, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.vtfp-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.6rem 1rem;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.vtfp-title {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  flex: 1;
  margin: 0;
}
.vtfp-controls { display: flex; align-items: center; gap: 0.4rem; }
.vtfp-ctrl {
  background: none;
  border: 1px solid var(--border);
  width: 28px;
  height: 28px;
  font-size: 1rem;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  cursor: pointer;
  flex-shrink: 0;
  transition: border-color var(--ease), color var(--ease);
}
.vtfp-ctrl:hover { border-color: var(--gold); color: var(--ink); }
.vtfp-pct {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  color: var(--muted);
  min-width: 3rem;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vtfp-stage {
  flex: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: grab;
  user-select: none;
  background: var(--bg);
}
.vtfp-stage.dragging { cursor: grabbing; }
.vtfp-wrap {
  transform-origin: center center;
  transition: transform 0.15s ease;
  will-change: transform;
}
.vtfp-wrap.no-transition { transition: none; }
.vtfp-wrap img {
  display: block;
  max-width: 100%;
  max-height: 100%;
  pointer-events: none;
  border: 1px solid var(--border);
}
</style>

<script>
  const overlay   = document.getElementById('vtfp-overlay')!;
  const titleEl   = document.getElementById('vtfp-title')!;
  const zoomImg   = document.getElementById('vtfp-img') as HTMLImageElement;
  const zoomWrap  = document.getElementById('vtfp-wrap')!;
  const zoomStage = document.getElementById('vtfp-stage')!;
  const pctEl     = document.getElementById('vtfp-pct')!;
  const lang      = () => document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'de';
  let zoom = 1, panX = 0, panY = 0;

  function applyTransform(animate = true) {
    if (!animate) zoomWrap.classList.add('no-transition');
    zoomWrap.style.transform = `translate(${panX}px,${panY}px) scale(${zoom})`;
    if (!animate) requestAnimationFrame(() => zoomWrap.classList.remove('no-transition'));
  }
  function setZoom(z: number) {
    zoom = Math.min(2.5, Math.max(0.5, z));
    pctEl.textContent = Math.round(zoom * 100) + '%';
    applyTransform();
  }
  function closeModal() {
    overlay.classList.add('hidden');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-fp-open]') as HTMLElement | null;
    if (btn && !btn.classList.contains('fp-placeholder')) {
      e.preventDefault();
      e.stopPropagation();
      const src     = btn.getAttribute('data-fp-src') || '';
      const titleDE = btn.getAttribute('data-fp-title-de') || '';
      const titleEN = btn.getAttribute('data-fp-title-en') || '';
      titleEl.textContent = lang() === 'en' ? titleEN : titleDE;
      panX = 0; panY = 0;
      const preload = new Image();
      const showModal = () => {
        zoomImg.src = src;
        overlay.classList.remove('hidden');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        const sw = zoomStage.clientWidth;
        const sh = zoomStage.clientHeight;
        const iw = preload.naturalWidth  || zoomImg.naturalWidth;
        const ih = preload.naturalHeight || zoomImg.naturalHeight;
        zoom = (sw && sh && iw && ih) ? Math.min(1, Math.min(sw / iw, sh / ih)) : 1;
        pctEl.textContent = Math.round(zoom * 100) + '%';
        applyTransform(false);
      };
      preload.onload = showModal;
      preload.onerror = showModal;
      preload.src = src;
      return;
    }
    if ((e.target as Element).closest('#vtfp-close') || e.target === overlay) closeModal();
    if ((e.target as Element).closest('#vtfp-in'))  setZoom(zoom + 0.25);
    if ((e.target as Element).closest('#vtfp-out')) setZoom(zoom - 0.25);
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Scroll to zoom
  let wheelLocked = false;
  zoomStage.addEventListener('wheel', (e) => {
    e.preventDefault();
    if (wheelLocked) return;
    wheelLocked = true;
    setZoom(zoom + (e.deltaY < 0 ? 0.1 : -0.1));
    setTimeout(() => { wheelLocked = false; }, 100);
  }, { passive: false });

  // Drag to pan — mouse
  let isDragging = false, dX = 0, dY = 0, pX0 = 0, pY0 = 0;
  zoomStage.addEventListener('mousedown', (e) => {
    if (e.button !== 0) return;
    isDragging = true; dX = e.clientX; dY = e.clientY; pX0 = panX; pY0 = panY;
    zoomStage.classList.add('dragging'); zoomWrap.classList.add('no-transition');
  });
  window.addEventListener('mousemove', (e) => {
    if (!isDragging) return;
    panX = pX0 + (e.clientX - dX); panY = pY0 + (e.clientY - dY);
    applyTransform(false);
  });
  window.addEventListener('mouseup', () => {
    if (!isDragging) return;
    isDragging = false; zoomStage.classList.remove('dragging'); zoomWrap.classList.remove('no-transition');
  });

  // Drag to pan — touch
  let touch0: Touch | null = null;
  zoomStage.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) return;
    touch0 = e.touches[0]; pX0 = panX; pY0 = panY;
    zoomWrap.classList.add('no-transition');
  }, { passive: true });
  zoomStage.addEventListener('touchmove', (e) => {
    if (!touch0 || e.touches.length !== 1) return;
    e.preventDefault();
    const t = e.touches[0];
    panX = pX0 + (t.clientX - touch0.clientX); panY = pY0 + (t.clientY - touch0.clientY);
    applyTransform(false);
  }, { passive: false });
  zoomStage.addEventListener('touchend', () => { touch0 = null; zoomWrap.classList.remove('no-transition'); });
</script>
