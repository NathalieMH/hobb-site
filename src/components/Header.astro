---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">

<!-- Left group: DE|EN far-left + left nav right-aligned against wordmark -->
<div class="header-left">
  <button class="lang-toggle" id="lang-toggle" aria-label="Sprache wechseln">
    <span class="lang-opt" id="lang-de">DE</span>
    <span class="lang-sep">|</span>
    <span class="lang-opt" id="lang-en">EN</span>
  </button>
  <nav class="split-nav split-nav-left" aria-label="Hauptnavigation links">
    <a class="animated-link" href={`${base}wohngemeinschaften/`} data-astro-prefetch>
      <span data-de>Die WGs</span>
      <span data-en>Apartments</span>
    </a>
    <a class="animated-link" href={`${base}haus/`} data-astro-prefetch>
      <span data-de>Das Haus</span>
      <span data-en>The Villa</span>
    </a>
  </nav>
</div>

  <!-- Center: Wordmark -->
  <a class="wordmark" href={`${base}home/`} aria-label="Haderslebener 26 — Home">
    <span class="wordmark-title">
      <span class="wordmark-main">Haderslebener 26</span>
      <span class="wordmark-rule"></span>
    </span>
    <span class="wordmark-sub" data-de>WGs für Studierende bei der FU</span>
    <span class="wordmark-sub" data-en>Student Shared Apartments close to FU Berlin</span>
  </a>

  <!-- Right group: right nav left-aligned against wordmark + hamburger far-right on narrow -->
  <div class="header-right">
    <nav class="split-nav split-nav-right" aria-label="Hauptnavigation rechts">
      <a class="animated-link" href={`${base}lage/`} data-astro-prefetch>
        <span data-de>Lage</span>
        <span data-en>Location</span>
      </a>
      <a class="animated-link" href={`${base}verfuegbarkeit/`} data-astro-prefetch>
        <span data-de>Verfügbarkeit</span>
        <span data-en>Availability</span>
      </a>
      <a class="animated-link" href={`${base}impressum-kontakt/`} data-astro-prefetch>
        <span data-de>Kontakt</span>
        <span data-en>Contact</span>
      </a>
    </nav>
    <button class="menu-btn narrow-only" id="menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Dropdown (narrow only) -->
  <nav class="dropdown-nav" id="site-nav">
    <a class="animated-link" href={`${base}home/`}><span data-de>Home</span><span data-en>Home</span></a>
    <a class="animated-link" href={`${base}wohngemeinschaften/`}><span data-de>Die WGs</span><span data-en>Shared Apartments</span></a>
    <a class="animated-link" href={`${base}lage/`}><span data-de>Die Lage</span><span data-en>Location</span></a>
    <a class="animated-link" href={`${base}haus/`}><span data-de>Das Haus</span><span data-en>The Villa</span></a>
    <a class="animated-link" href={`${base}verfuegbarkeit/`}><span data-de>Verfügbarkeit</span><span data-en>Availability</span></a>
    <a class="animated-link" href={`${base}impressum-kontakt/`}><span data-de>Impressum & Kontakt</span><span data-en>Legal & Contact</span></a>
  </nav>

</header>

<style>
.site-header {
  background: var(--bg);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 0 1rem;
  padding: 1.1rem clamp(1.25rem, 5vw, 3rem);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 200;
}

/* ── Wordmark ────────────────────────────────────────────────── */
.wordmark {
  grid-column: 2;
  justify-self: center;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  padding-inline: 2rem;
}
.wordmark-main {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(1rem, 2vw, 1.35rem);
  letter-spacing: 0.08em;
  text-indent: 0.08em;
  text-transform: uppercase;
  line-height: 1;
  font-variant-numeric: lining-nums;
}
.wordmark-title {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}
.wordmark-rule {
  display: block;
  width: 90%;
  height: 1px;
  background: var(--gold);
}
.wordmark-sub {
  font-family: var(--font-sans);
  font-size: 0.52rem;
  letter-spacing: 0.16em;
  text-indent: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
  white-space: nowrap;
}

/* ── Left / right containers ─────────────────────────────────── */
.header-left {
  grid-column: 1;
  display: flex;
  align-items: center;
  justify-content: space-between; /* DE|EN far-left, nav hugs wordmark */
}
.header-right {
  grid-column: 3;
  display: flex;
  align-items: center;
  justify-content: flex-end; /* hamburger far-right on narrow */
}
@media (min-width: 920px) {
  .header-right { justify-content: flex-start; } /* nav hugs wordmark on wide */
}

/* ── Split nav (wide screens) ───────────────────────────────── */
.split-nav {
  display: none;
  align-items: center;
  gap: 1.5rem;
}
.split-nav a {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
  transition: color var(--ease);
}
.split-nav a:hover { color: var(--ink); }
.split-nav-right { gap: 1.25rem; }

/* ── Language toggle ─────────────────────────────────────────── */
.lang-toggle {
  background: none;
  border: none;
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.2rem 0;
  cursor: pointer;
  transition: color var(--ease);
  flex-shrink: 0;
}
.lang-toggle:hover { color: var(--ink); }
.lang-sep { opacity: 0.4; }
.lang-opt.active { color: var(--ink); font-weight: 500; }

/* ── Hamburger ───────────────────────────────────────────────── */
.menu-btn {
  width: 28px;
  height: 18px;
  padding: 0;
  border: 0;
  background: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
}
.menu-btn span {
  height: 1px;
  background: var(--ink);
  border-radius: 1px;
  display: block;
  transition: opacity var(--ease);
}
.menu-btn:hover span { opacity: 0.5; }

/* ── Dropdown (narrow) ───────────────────────────────────────── */
.dropdown-nav {
  display: none;
  position: absolute;
  top: 100%;
  right: clamp(1.25rem, 5vw, 3rem);
  background: var(--bg);
  flex-direction: column;
  min-width: 240px;
  border: 1px solid var(--border);
  box-shadow: 0 12px 32px rgba(28, 26, 23, 0.08);
  z-index: 201;
}
.dropdown-nav.open { display: flex; }
.dropdown-nav a {
  text-decoration: none;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink);
  padding: 0.85rem 1.25rem;
  border-bottom: 1px solid var(--border);
  transition: background var(--ease), color var(--ease);
}
.dropdown-nav a:last-child { border-bottom: none; }
.dropdown-nav a:hover { background: var(--ink); color: var(--ink-light); }

/* ── Responsive ──────────────────────────────────────────────── */
.narrow-only { display: flex; }

@media (max-width: 500px) {
  .wordmark-sub { display: none; }
  .wordmark { gap: 0.15rem; }
}

@media (min-width: 920px) {
  .split-nav   { display: flex; }
  .narrow-only { display: none; }
}
</style>

<script>
  function applyLang(lang: string) {
    document.documentElement[lang === 'en' ? 'setAttribute' : 'removeAttribute']('data-lang', 'en');
    localStorage.setItem('vt-lang', lang);
    ['lang-de', 'lang-en'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.toggle('active', id.includes(lang === 'en' ? 'en' : 'de'));
    });
  }

  // Runs on every navigation — re-attaches handlers to the fresh DOM nodes
  // that ViewTransitions swaps in each time.
  document.addEventListener("astro:page-load", () => {
    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("site-nav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });

    applyLang(localStorage.getItem('vt-lang') || 'de');
    document.getElementById('lang-toggle')?.addEventListener('click', () => {
      applyLang(document.documentElement.getAttribute('data-lang') === 'en' ? 'de' : 'en');
    });
  });

  // Registered once; queries fresh elements at click time so it never holds
  // stale references to nodes swapped out by ViewTransitions.
  document.addEventListener("click", (e) => {
    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("site-nav");
    if (btn && nav && !btn.contains(e.target as Node) && !nav.contains(e.target as Node)) {
      nav.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    }
  });
</script>
