---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <!-- Left: DE | EN toggle -->
  <button class="lang-toggle" id="lang-toggle" aria-label="Sprache wechseln / Switch language">
    <span class="lang-opt" id="lang-de">DE</span>
    <span class="lang-sep">|</span>
    <span class="lang-opt" id="lang-en">EN</span>
  </button>

  <!-- Center: Wordmark -->
  <a class="wordmark" href={`${base}home/`} aria-label="Villa Theo — Home">
    <span class="wordmark-main">Villa Theo</span>
    <span class="wordmark-rule"></span>
    <span class="wordmark-sub">Berlin · Steglitz · Dahlem</span>
  </a>

  <!-- Right: inline nav (wide screens) + hamburger (narrow screens) -->
  <div class="header-right">
    <nav class="inline-nav" aria-label="Hauptnavigation">
      <a href={`${base}wohngemeinschaften/`}>
        <span data-de>Wohngemeinschaften</span>
        <span data-en>Apartments</span>
      </a>
      <a href={`${base}verfuegbarkeit/`}>
        <span data-de>Verfügbarkeit</span>
        <span data-en>Availability</span>
      </a>
      <a href={`${base}lage/`}>
        <span data-de>Lage</span>
        <span data-en>Location</span>
      </a>
      <a href={`${base}haus/`}>
        <span data-de>Das Haus</span>
        <span data-en>The Villa</span>
      </a>
      <a href={`${base}impressum-kontakt/`}>
        <span data-de>Kontakt</span>
        <span data-en>Contact</span>
      </a>
    </nav>
    <button class="menu-btn" id="menu-toggle" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Dropdown nav (narrow screens only) -->
  <nav class="dropdown-nav" id="site-nav" aria-label="Hauptnavigation">
    <a href={`${base}home/`}>
      <span data-de>Home</span>
      <span data-en>Home</span>
    </a>
    <a href={`${base}wohngemeinschaften/`}>
      <span data-de>Die Wohngemeinschaften</span>
      <span data-en>Shared Apartments</span>
    </a>
    <a href={`${base}verfuegbarkeit/`}>
      <span data-de>Verfügbarkeit</span>
      <span data-en>Availability</span>
    </a>
    <a href={`${base}lage/`}>
      <span data-de>Die Lage</span>
      <span data-en>Location</span>
    </a>
    <a href={`${base}haus/`}>
      <span data-de>Das Haus</span>
      <span data-en>The Villa</span>
    </a>
    <a href={`${base}impressum-kontakt/`}>
      <span data-de>Impressum & Kontakt</span>
      <span data-en>Legal & Contact</span>
    </a>
  </nav>
</header>

<style>
.site-header {
  background: var(--bg);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 1.1rem clamp(1.25rem, 5vw, 3rem);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 200;
}

/* Wordmark — center */
.wordmark {
  grid-column: 2;
  justify-self: center;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
}
.wordmark-main {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(1rem, 2vw, 1.35rem);
  letter-spacing: 0.28em;
  text-transform: uppercase;
  line-height: 1;
}
.wordmark-rule {
  display: block;
  width: 2rem;
  height: 1px;
  background: var(--gold);
}
.wordmark-sub {
  font-family: var(--font-sans);
  font-size: 0.55rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}

/* Left: language toggle */
.lang-toggle {
  grid-column: 1;
  justify-self: start;
  background: none;
  border: none;
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.25rem 0;
  transition: color var(--ease);
}
.lang-toggle:hover { color: var(--ink); }
.lang-sep { opacity: 0.4; }
.lang-opt.active { color: var(--ink); font-weight: 500; }

/* Right: container for inline-nav + hamburger */
.header-right {
  grid-column: 3;
  justify-self: end;
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

/* ── Inline nav (wide screens only) ─────────────────────────── */
.inline-nav {
  display: none;
}
.inline-nav a {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  white-space: nowrap;
  transition: color var(--ease);
}
.inline-nav a:hover { color: var(--ink); }

/* ── Hamburger (narrow screens only) ────────────────────────── */
.menu-btn {
  width: 28px;
  height: 18px;
  padding: 0;
  border: 0;
  background: none;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: stretch;
  flex-shrink: 0;
}
.menu-btn span {
  height: 1px;
  background: var(--ink);
  border-radius: 1px;
  display: block;
  transition: opacity var(--ease);
}
.menu-btn:hover span { opacity: 0.5; }

/* ── Dropdown nav (narrow screens) ──────────────────────────── */
.dropdown-nav {
  display: none;
  position: absolute;
  top: 100%;
  right: clamp(1.25rem, 5vw, 3rem);
  background: var(--bg);
  flex-direction: column;
  min-width: 240px;
  border: 1px solid var(--border);
  box-shadow: 0 12px 32px rgba(28, 26, 23, 0.08);
  z-index: 201;
}
.dropdown-nav.open { display: flex; }
.dropdown-nav a {
  text-decoration: none;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink);
  padding: 0.85rem 1.25rem;
  border-bottom: 1px solid var(--border);
  transition: background var(--ease), color var(--ease);
}
.dropdown-nav a:last-child { border-bottom: none; }
.dropdown-nav a:hover { background: var(--ink); color: var(--ink-light); }

/* ── Responsive breakpoint ───────────────────────────────────── */
@media (min-width: 920px) {
  .inline-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .menu-btn { display: none; }
}
</style>

<script>
  // Hamburger toggle
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("menu-toggle");
    const nav = document.getElementById("site-nav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
    document.addEventListener("click", (e) => {
      if (!btn?.contains(e.target as Node) && !nav?.contains(e.target as Node)) {
        nav?.classList.remove("open");
        btn?.setAttribute("aria-expanded", "false");
      }
    });
  });

  // Language toggle
  function applyLang(lang: string) {
    const html = document.documentElement;
    if (lang === 'en') {
      html.setAttribute('data-lang', 'en');
    } else {
      html.removeAttribute('data-lang');
    }
    localStorage.setItem('vt-lang', lang);
    document.getElementById('lang-de')?.classList.toggle('active', lang === 'de');
    document.getElementById('lang-en')?.classList.toggle('active', lang === 'en');
  }

  document.addEventListener("DOMContentLoaded", () => {
    const saved = localStorage.getItem('vt-lang') || 'de';
    applyLang(saved);
    document.getElementById('lang-toggle')?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'de';
      applyLang(current === 'de' ? 'en' : 'de');
    });
  });
</script>
