---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";
import fs from "node:fs/promises";
import path from "node:path";

const base = import.meta.env.BASE_URL;
function entrySlug(id: string) { return id.replace(/\.[^.]+$/, '').toLowerCase(); }
const apartments = (await getCollection("apartments"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

async function findCover(imageFolder: string | undefined): Promise<string> {
  if (!imageFolder) return '';
  const dir = path.resolve(process.cwd(), "public", "wohngemeinschaften", imageFolder);
  try {
    const files = await fs.readdir(dir);
    const found = files.find(f => /^cover\./i.test(f));
    return found ? `wohngemeinschaften/${imageFolder}/${found}` : '';
  } catch {
    return '';
  }
}

const coverMap = Object.fromEntries(
  await Promise.all(
    apartments.map(async (a) => [entrySlug(a.id), await findCover(a.data.image_folder)])
  )
);
---

<Layout title="Haderslebener 26 — Die Wohngemeinschaften" noPadding={true}>

  <section class="subpage-hero">
    <div class="hero-image-wrap">
      <img
        src={`${base}home/titelbild-fuer-home.png`}
        alt="Haderslebener 26, Eingangsbereich"
        loading="eager"
        fetchpriority="high"
        data-always-fade
        style="object-position: center 52%;"
      />
    </div>
  </section>

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow reveal" data-de>Wohnen</span>
      <span class="eyebrow reveal" data-en>Living</span>
      <h1 class="reveal" data-de>Die WGs</h1>
      <h1 class="reveal" data-en>Shared Apartments</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Intro + includes -->
  <section class="section intro-section">
    <div class="container intro-cols">
      <p class="reveal" data-de>
        Die ersten beiden Wohnungen mit insgesamt 9 Zimmern werden ab Mai 2026 vermietet.<br>
        Bis 2027 soll das Angebot auf bis zu fünf WGs für Studierende mit insgesamt 22–25 Zimmern und zwei privat bewohnten Wohnungen in Stadtvilla und Anbau wachsen.
      </p>
      <p class="reveal" data-en>
        The first two apartments with a total of 9 rooms will be available for rent from May 2026.<br>
        By 2027, this is set to grow to up to five student shared apartments with 22–25 rooms in total, plus two privately occupied apartments in the villa and annex.
      </p>
      <div class="includes">
        <span class="eyebrow reveal" data-de>In der Miete inbegriffen</span>
        <span class="eyebrow reveal" data-en>Included in the rent</span>
        <ul class="reveal-stagger">
         <li class="reveal-child"><span data-de>Möblierung: Bett, Schrank, Schreibtisch, Stuhl, Vorhänge — sowie viel Raum für euren eigenen Stil</span><span data-en>Furnishings: bed, wardrobe, desk, chair, curtains — plenty of room for your own style</span></li>
         <li class="reveal-child"><span data-de>Küche Grundausstattung mit Geschirr, Töpfe etc.</span><span data-en>Basic kitchen equipment including dishes, pots, etc.</span></li>
         <li class="reveal-child"><span data-de>Wasser, Heizung, Strom</span><span data-en>Water, heating, electricity</span></li>
         <li class="reveal-child"><span data-de>Waschmaschine, Trockner, Bügeleisen und -brett</span><span data-en>Washing machine, dryer, iron and ironing board</span></li>
         <li class="reveal-child"><span data-de>High-Speed Internet im Haus</span><span data-en>High-speed internet in the building</span></li>
         <li class="reveal-child"><span data-de>Haushaltsschrank mit Staubsauger, Putzmitteln etc. </span><span data-en>Cleaning closet with vacuum, mop, and cleaning supplies</span></li>
         <li class="reveal-child"><span data-de>Digitales Schloss für jedes Zimmer</span><span data-en>Digital lock for each room</span></li>
         <li class="reveal-child"><span data-de>Regelmäßige Grundreinigung der Gemeinschaftsräume (wöchentliches Putzen bleibt WG-Aufgabe)</span><span data-en>Regular deep cleaning of shared areas (weekly cleaning is the residents' responsibility)</span></li>

        </ul>
      </div>
    </div>
  </section>

  <!-- Requirements callout -->
  <section class="requirements-section">
    <div class="container">
      <p class="requirements-note reveal" data-de>Eine gültige Immatrikulationsbescheinigung ist Voraussetzung für die Anmietung eines Zimmers. Die Kaution beträgt [#] Monatskomplettmieten und wird nach Auszug unkompliziert und zeitnah zurückerstattet.</p>
      <p class="requirements-note reveal" data-en>A valid university enrollment certificate is required to rent a room. The deposit is [#] months' total rent and will be returned promptly after move-out.</p>
    </div>
  </section>

  <!-- Apartment cards -->

  <section class="section apt-section">
    <div class="container">
      <div class="apt-grid reveal-stagger">
        {apartments.map((apt) => {
          const slug = entrySlug(apt.id);
          const { data } = apt;
          const cover = coverMap[slug];
          return (
          <a class="apt-card reveal-child" href={`${base}wohngemeinschaften/${slug}/`}>
            <div class="apt-cover">
              {cover
                ? <img
                    src={`${base}${cover}`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                : <div class="cover-placeholder">
                    <span class="placeholder-label" data-de>Foto folgt</span>
                    <span class="placeholder-label" data-en>Photo coming soon</span>
                  </div>
              }
            </div>
            <div class="apt-caption">
              <span class="eyebrow" data-de>Wohngemeinschaft</span>
              <span class="eyebrow" data-en>Shared Apartment</span>
              <span class="apt-title" data-de>{data.title_de}</span>
              <span class="apt-title" data-en>{data.title_en}</span>
              {data.description_de && <p class="apt-desc" data-de>{data.description_de}</p>}
              {data.description_en && <p class="apt-desc" data-en>{data.description_en}</p>}
              <span class="apt-cta" data-de>Zimmer & Details →</span>
              <span class="apt-cta" data-en>Rooms & Details →</span>
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>


</Layout>

<style>
/* Intro */
.intro-section { padding-top: 0; padding-bottom: clamp(1rem, 2vw, 1.75rem); }
.intro-cols {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}
.intro-cols > p {
  color: var(--muted);
  font-size: 0.95rem;
  text-align: center;
  max-width: 60ch;
}
.includes {
  width: 100%;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.includes ul {
  list-style: none;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.35rem 2rem;
}
.includes li {
  font-size: 0.85rem;
  color: var(--muted);
  padding-left: 0;
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
}
.includes li::before {
  content: '◆';
  flex-shrink: 0;
  font-size: 0.455rem;
  color: var(--gold);
  margin-top: 0.52rem;
  line-height: 1;
}

/* Apartment grid */
.requirements-section { padding-block: 0 1.5rem; }
.requirements-note {
  font-size: 0.85rem;
  color: var(--muted);
  max-width: none;
  padding: 0.9rem 1.25rem;
  border-left: 2px solid var(--gold);
  background: rgba(184, 149, 42, 0.04);
}

.apt-section { padding-top: 1rem; }
.apt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem 2.5rem;
}
.apt-card {
  min-width: 0;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Cover image area */
.apt-cover {
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  aspect-ratio: 4 / 3;
  background: var(--bg);
}
.apt-cover img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease, opacity 0.7s ease;
}
.apt-card:hover .apt-cover img { transform: scale(1.03); }

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-label {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}

.apt-caption { display: flex; flex-direction: column; gap: 0.35rem; }
.apt-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 300;
  letter-spacing: 0.04em;
}
.apt-desc { font-size: 0.88rem; color: var(--muted); max-width: 46ch; }
.apt-cta {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
  margin-top: 0.15rem;
}
.apt-card:hover .apt-cta { text-decoration: underline; }


@media (max-width: 860px) {
  .includes ul { grid-template-columns: 1fr; }
  .apt-grid { grid-template-columns: 1fr; }
}
</style>
