---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const apartments = (await getCollection("apartments"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const FALLBACK = `${base}home-wohngemeinschaften.png`;
---

<Layout title="Villa Theo — Die Wohngemeinschaften">
  <!-- Page header -->
  <section class="page-header section">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Wohnen</span>
      <span class="eyebrow" data-en>Living</span>
      <h1 data-de>Die Wohngemeinschaften</h1>
      <h1 data-en>Shared Apartments</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Intro -->
  <section class="section intro-section">
    <div class="container intro-cols">
      <p data-de>
        Ab Dezember 2025 werden die ersten zwei Wohnungen mit insgesamt neun Zimmern im ersten und zweiten Obergeschoss bezugsfertig sein. Ab Frühjahr bzw. Sommer 2026 kommen nochmals sieben bzw. sechs Zimmer über zwei Etagen in Altbau und Anbau dazu.
      </p>
      <p data-en>
        From December 2025, the first two apartments with nine rooms on the first and second floors will be ready to move into. A further seven and six rooms across two floors in the main building and annex will follow in spring and summer 2026.
      </p>
      <div class="includes">
        <h3 data-de>In der Miete inbegriffen</h3>
        <h3 data-en>Included in the rent</h3>
        <ul>
          <li>
            <span data-de>Möblierung: Bett, Schrank, Schreibtisch, Stuhl</span>
            <span data-en>Furnishings: bed, wardrobe, desk, chair</span>
          </li>
          <li>
            <span data-de>Wasser, Heizung, Strom</span>
            <span data-en>Water, heating, electricity</span>
          </li>
          <li>
            <span data-de>Waschmaschine & Trockenraum</span>
            <span data-en>Washing machine & drying room</span>
          </li>
          <li>
            <span data-de>Regelmäßige Grundreinigung der Gemeinschaftsräume</span>
            <span data-en>Regular cleaning of shared areas</span>
          </li>
          <li>
            <span data-de>Internetzugang</span>
            <span data-en>Internet access</span>
          </li>
          <li>
            <span data-de>Gartennutzung, Terrasse & Boule-Bahn</span>
            <span data-en>Garden, terrace & pétanque court</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Apartment cards -->
  <section class="section apartments-section">
    <div class="container">
      <div class="apt-grid">
        {apartments.map(({ data, slug }) => {
          const thumb = data.thumbnail ?? FALLBACK;
          return (
            <a class="apt-card" href={`${base}wohngemeinschaften/${slug}/`}>
              <div class="apt-img-wrap">
                <img src={thumb} alt="" loading="lazy" />
              </div>
              <div class="apt-caption">
                <span class="eyebrow" data-de>Wohnung</span>
                <span class="eyebrow" data-en>Apartment</span>
                <span class="apt-title" data-de>{data.title_de}</span>
                <span class="apt-title" data-en>{data.title_en}</span>
                {data.description_de && (
                  <p class="apt-desc" data-de>{data.description_de}</p>
                )}
                {data.description_en && (
                  <p class="apt-desc" data-en>{data.description_en}</p>
                )}
                <span class="apt-link" data-de>Zimmer ansehen →</span>
                <span class="apt-link" data-en>View rooms →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<style>
/* Page header */
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1rem;
}

/* Intro */
.intro-section { padding-top: 0; }
.intro-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2.5rem 4rem;
  align-items: start;
}
.intro-cols p { color: var(--muted); }
.includes { grid-column: 1 / -1; padding-top: var(--sp-md); border-top: 1px solid var(--border); }
.includes h3 { margin-bottom: 1rem; }
.includes ul {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 0.5rem 2rem;
}
.includes li {
  font-size: 0.9rem;
  color: var(--muted);
  padding-left: 1rem;
  position: relative;
}
.includes li::before {
  content: '◆';
  position: absolute;
  left: 0;
  font-size: 0.4rem;
  color: var(--gold);
  top: 0.45em;
}

/* Apartment grid */
.apt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 4rem 3rem;
}
.apt-card {
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}
.apt-img-wrap {
  overflow: hidden;
  aspect-ratio: 4 / 3;
}
.apt-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.apt-card:hover .apt-img-wrap img { transform: scale(1.03); }
.apt-caption { display: flex; flex-direction: column; gap: 0.4rem; }
.apt-title {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 300;
  letter-spacing: 0.04em;
}
.apt-desc { font-size: 0.9rem; color: var(--muted); max-width: 48ch; }
.apt-link {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
  margin-top: 0.25rem;
}
.apt-card:hover .apt-link { text-decoration: underline; }

@media (max-width: 900px) {
  .intro-cols { grid-template-columns: 1fr; }
  .apt-grid { grid-template-columns: 1fr; }
}
</style>
