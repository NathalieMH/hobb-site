---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const apartments = (await getCollection("apartments"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Villa Theo — Die Wohngemeinschaften">

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Wohnen</span>
      <span class="eyebrow" data-en>Living</span>
      <h1 data-de>Die Wohngemeinschaften</h1>
      <h1 data-en>Shared Apartments</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Intro + includes -->
  <section class="section intro-section">
    <div class="container intro-cols">
      <p data-de>
        Ab Dezember 2025 werden die ersten zwei Wohnungen mit insgesamt neun Zimmern im ersten und zweiten Obergeschoss bezugsfertig sein. Ab Frühjahr bzw. Sommer 2026 kommen nochmals sieben bzw. sechs Zimmer über zwei Etagen in Altbau und Anbau dazu.
      </p>
      <p data-en>
        From December 2025, the first two apartments with nine rooms on the first and second floors will be ready. A further seven and six rooms across two floors in the main building and annex follow in spring and summer 2026.
      </p>
      <div class="includes">
        <span class="eyebrow" data-de>In der Miete inbegriffen</span>
        <span class="eyebrow" data-en>Included in the rent</span>
        <ul>
          <li><span data-de>Möblierung: Bett, Schrank, Schreibtisch, Stuhl sowie viel Raum für euren eigenen Stil</span><span data-en>Furnishings: bed, wardrobe, desk, chair — plus plenty of room for your own style</span></li>
          <li><span data-de>Wasser, Heizung, Strom</span><span data-en>Water, heating, electricity</span></li>
          <li><span data-de>Internetzugang</span><span data-en>Internet access</span></li>
          <li><span data-de>Waschmaschinen- und Trockenraum</span><span data-en>Washing machine & drying room</span></li>
          <li><span data-de>Gartennutzung bzw. Terrasse und Boule-Bahn</span><span data-en>Use of the garden, terrace and pétanque court</span></li>
          <li><span data-de>Regelmäßige Grundreinigung der Gemeinschaftsräume (tägliches Putzen ist WG-Aufgabe, Putz-App optional)</span><span data-en>Regular deep-cleaning of shared areas (day-to-day tidying is a flatmate task, cleaning app optional)</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Apartment cards -->

  <section class="section apt-section">
    <div class="container">
      <div class="apt-grid">
        {apartments.map(({ data, slug }) => (
          <a class="apt-card" href={`${base}wohngemeinschaften/${slug}/`}>
            <div class="apt-floorplan">
              {data.floorplan
                ? <>
                    <img src={`${base}${data.floorplan}`} alt="" loading="lazy" />
                    <button
                      class="fp-zoom-btn"
                      data-src={`${base}${data.floorplan}`}
                      data-title-de={data.title_de}
                      data-title-en={data.title_en}
                      aria-label="Grundriss vergrößern"
                    >
                      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                        <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                        <line x1="10" y1="10" x2="14" y2="14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        <line x1="6.5" y1="4" x2="6.5" y2="9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        <line x1="4" y1="6.5" x2="9" y2="6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </>
                : <div class="floorplan-placeholder">
                    <svg viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect x="10" y="10" width="140" height="100" stroke="#B8952A" stroke-opacity="0.35" stroke-width="1.5"/>
                      <rect x="10" y="10" width="80" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="90" y="10" width="60" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="90" y="50" width="60" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="10" y="70" width="50" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="60" y="70" width="30" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <line x1="35" y1="70" x2="35" y2="110" stroke="#B8952A" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="3 3"/>
                    </svg>
                    <span class="placeholder-label" data-de>Grundriss folgt</span>
                    <span class="placeholder-label" data-en>Floorplan coming soon</span>
                  </div>
              }
            </div>
            <div class="apt-caption">
              <span class="eyebrow" data-de>Wohngemeinschaft</span>
              <span class="eyebrow" data-en>Shared Apartment</span>
              <span class="apt-title" data-de>{data.title_de}</span>
              <span class="apt-title" data-en>{data.title_en}</span>
              {data.description_de && <p class="apt-desc" data-de>{data.description_de}</p>}
              {data.description_en && <p class="apt-desc" data-en>{data.description_en}</p>}
              <span class="apt-cta" data-de>Zimmer & Details →</span>
              <span class="apt-cta" data-en>Rooms & Details →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

<!-- Floorplan zoom modal -->
<div id="fp-zoom-overlay" class="fp-zoom-overlay hidden" aria-hidden="true">
  <div class="fp-zoom-modal" role="dialog" aria-modal="true">
    <div class="fp-zoom-header">
      <p class="fp-zoom-title" id="fp-zoom-title"></p>
      <div class="fp-zoom-controls">
        <button class="fp-zoom-ctrl" id="fp-zoom-out" aria-label="Verkleinern">−</button>
        <span class="fp-zoom-pct" id="fp-zoom-pct">100%</span>
        <button class="fp-zoom-ctrl" id="fp-zoom-in" aria-label="Vergrößern">+</button>
        <button class="fp-zoom-close" id="fp-zoom-close" aria-label="Schließen">×</button>
      </div>
    </div>
    <div class="fp-zoom-stage" id="fp-zoom-stage">
      <div class="fp-zoom-img-wrap" id="fp-zoom-img-wrap">
        <img id="fp-zoom-img" src="" alt="" />
      </div>
    </div>
  </div>
</div>

</Layout>

<style>
/* Intro */
.intro-section { padding-top: 0; }
.intro-cols {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}
.intro-cols > p {
  color: var(--muted);
  font-size: 0.95rem;
  text-align: center;
  max-width: 60ch;
}
.includes {
  width: 100%;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.includes ul {
  list-style: none;
  display: grid;
  grid-template-columns: 5fr 4fr 6fr;
  gap: 0.35rem 2rem;
}
.includes li {
  font-size: 0.85rem;
  color: var(--muted);
  padding-left: 0;
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
}
.includes li::before {
  content: '◆';
  flex-shrink: 0;
  font-size: 0.455rem;
  color: var(--gold);
  margin-top: 0.42em;
  line-height: 1;
}

/* Apartment grid */
.apt-section { padding-top: 1rem; }
.apt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem 2.5rem;
}
.apt-card {
  min-width: 0;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Floorplan area */
.apt-floorplan {
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  aspect-ratio: 4 / 3;
  background: var(--bg);
}
.apt-floorplan img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 1rem;
  transition: transform 0.5s ease;
}
.apt-card:hover .apt-floorplan img { transform: scale(1.02); }

.floorplan-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1.5rem;
}
.floorplan-placeholder svg { width: 100%; max-width: 180px; opacity: 0.7; }
.placeholder-label {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}

.apt-caption { display: flex; flex-direction: column; gap: 0.35rem; }
.apt-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 300;
  letter-spacing: 0.04em;
}
.apt-desc { font-size: 0.88rem; color: var(--muted); max-width: 46ch; }
.apt-cta {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
  margin-top: 0.15rem;
}
.apt-card:hover .apt-cta { text-decoration: underline; }

/* Floorplan zoom button */
.apt-floorplan { position: relative; }
.fp-zoom-btn {
  position: absolute;
  bottom: 0.6rem;
  right: 0.6rem;
  width: 32px;
  height: 32px;
  background: rgba(250, 248, 243, 0.92);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  cursor: pointer;
  opacity: 0;
  transition: opacity var(--ease), color var(--ease);
  z-index: 2;
}
.apt-card:hover .fp-zoom-btn { opacity: 1; }
.fp-zoom-btn:hover { color: var(--ink); }

/* Floorplan zoom modal */
.fp-zoom-overlay {
  position: fixed;
  inset: 0;
  background: rgba(28, 26, 23, 0.6);
  display: grid;
  place-items: center;
  padding: 2rem;
  z-index: 400;
}
.fp-zoom-overlay.hidden { display: none; }
.fp-zoom-modal {
  background: var(--bg);
  width: min(100%, 800px);
  max-height: 92vh;
  border: 1px solid var(--border);
  box-shadow: 0 24px 64px rgba(28, 26, 23, 0.2);
  display: flex;
  flex-direction: column;
}
.fp-zoom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.25rem;
  border-bottom: 1px solid var(--border);
  gap: 1rem;
  flex-shrink: 0;
}
.fp-zoom-title {
  font-family: var(--font-sans);
  font-size: 0.68rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--muted);
}
.fp-zoom-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.fp-zoom-ctrl {
  background: none;
  border: 1px solid var(--border);
  width: 28px;
  height: 28px;
  font-size: 1rem;
  line-height: 1;
  color: var(--muted);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: color var(--ease), border-color var(--ease);
}
.fp-zoom-ctrl:hover { color: var(--ink); border-color: var(--ink); }
.fp-zoom-pct { font-size: 0.72rem; color: var(--muted); min-width: 3rem; text-align: center; }
.fp-zoom-close {
  background: none;
  border: none;
  font-size: 1.6rem;
  line-height: 1;
  color: var(--muted);
  cursor: pointer;
  padding: 0 0.25rem;
}
.fp-zoom-close:hover { color: var(--ink); }
.fp-zoom-stage {
  overflow: auto;
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 1.5rem;
}
.fp-zoom-img-wrap {
  transform-origin: top center;
  transition: transform 0.2s ease;
}
.fp-zoom-img-wrap img { display: block; max-width: 100%; border: 1px solid var(--border); }

@media (max-width: 860px) {
  .includes li:nth-child(n) { grid-column: span 6; }
  .apt-grid { grid-template-columns: 1fr; }
}
@media (max-width: 540px) {
  .includes li:nth-child(n) { grid-column: span 12; }
}
</style>

<script>
  const overlay  = document.getElementById('fp-zoom-overlay')!;
  const zoomImg  = document.getElementById('fp-zoom-img') as HTMLImageElement;
  const imgWrap  = document.getElementById('fp-zoom-img-wrap')!;
  const titleEl  = document.getElementById('fp-zoom-title')!;
  const pctEl    = document.getElementById('fp-zoom-pct')!;
  const lang     = () => document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'de';
  let zoom = 1;

  function setZoom(z: number) {
    zoom = Math.min(3, Math.max(0.5, z));
    imgWrap.style.transform = `scale(${zoom})`;
    pctEl.textContent = Math.round(zoom * 100) + '%';
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('.fp-zoom-btn') as HTMLElement | null;
    if (btn) {
      e.preventDefault();
      e.stopPropagation();
      const src   = btn.getAttribute('data-src') || '';
      const title = lang() === 'en'
        ? (btn.getAttribute('data-title-en') || '')
        : (btn.getAttribute('data-title-de') || '');
      titleEl.textContent = title;
      zoomImg.src = src;
      zoom = 1;
      imgWrap.style.transform = 'scale(1)';
      pctEl.textContent = '100%';
      overlay.classList.remove('hidden');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      return;
    }

    if ((e.target as Element).closest('#fp-zoom-close') || e.target === overlay) {
      overlay.classList.add('hidden');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });

  document.getElementById('fp-zoom-in')!.addEventListener('click',  () => setZoom(zoom + 0.25));
  document.getElementById('fp-zoom-out')!.addEventListener('click', () => setZoom(zoom - 0.25));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
      overlay.classList.add('hidden');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });
</script>
