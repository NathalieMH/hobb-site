---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";
import fs from "node:fs/promises";
import path from "node:path";

const base = import.meta.env.BASE_URL;
function entrySlug(id: string) { return id.replace(/\.[^.]+$/, '').toLowerCase(); }
const apartments = (await getCollection("apartments"))
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

async function findGrundriss(imageFolder: string | undefined): Promise<string> {
  if (!imageFolder) return '';
  const dir = path.resolve(process.cwd(), "public", "wohngemeinschaften", imageFolder);
  try {
    const files = await fs.readdir(dir);
    const found = files.find(f => /^grundriss\./i.test(f));
    return found ? `wohngemeinschaften/${imageFolder}/${found}` : '';
  } catch {
    return '';
  }
}

const grundrissMap = Object.fromEntries(
  await Promise.all(
    apartments.map(async (a) => [entrySlug(a.id), await findGrundriss(a.data.image_folder)])
  )
);
---

<Layout title="Theodor — Die Wohngemeinschaften" noPadding={true}>

  <section class="subpage-hero">
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Eingangsbereich.jpeg`}
        alt="Theodor, Eingangsbereich"
        loading="eager"
        fetchpriority="high"
        data-always-fade
        style="object-position: center 60%;"
      />
    </div>
  </section>

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow reveal" data-de>Wohnen</span>
      <span class="eyebrow reveal" data-en>Living</span>
      <h1 class="reveal" data-de>Die Wohngemeinschaften</h1>
      <h1 class="reveal" data-en>Shared Apartments</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Intro + includes -->
  <section class="section intro-section">
    <div class="container intro-cols">
      <p class="reveal" data-de>
        Die Vermietung der ersten beiden Wohnungen mit insgesamt neun Zimmern im ersten und zweiten Obergeschoss ist im April 2026 gestartet. Mittelfristig wächst das Angebot auf insgesamt fünf WGs für Studierende sowie zwei privat bewohnte Wohnungen in Stadtvilla und Anbau. Für ein gut organisiertes Zusammenleben steht eine WG-App zur Koordination gemeinsamer Aufgaben wie Reinigung oder Einkauf zur Verfügung. Der Vermieter ist jederzeit persönlich ansprechbar bei organisatorischen Fragen.
      </p>
      <p class="reveal" data-en>
        Rental of the first two apartments with a total of nine rooms on the first and second floors started in April 2026. In the medium term, the property will offer five student shared apartments as well as two privately occupied apartments in the villa and annex. A WG app is available to coordinate shared tasks such as cleaning and shopping. The landlord is available at all times for organizational questions.
      </p>
      <div class="includes">
        <span class="eyebrow reveal" data-de>In der Miete inbegriffen</span>
        <span class="eyebrow reveal" data-en>Included in the rent</span>
        <ul class="reveal-stagger">
          <li class="reveal-child"><span data-de>Möblierung: Bett, Schrank, Schreibtisch, Stuhl, Vorhänge, Lampen sowie viel Raum für euren eigenen Stil</span><span data-en>Furnishings: bed, wardrobe, desk, chair, curtains, lamps — plus plenty of room for your own style</span></li>
          <li class="reveal-child"><span data-de>Wasser, Heizung, Strom</span><span data-en>Water, heating, electricity</span></li>
          <li class="reveal-child"><span data-de>Wäscheraum im Haus mit Waschmaschine, Trockner, Bügelbrett und -eisen</span><span data-en>In-house laundry room with washing machine, dryer, ironing board and iron</span></li>
          <li class="reveal-child"><span data-de>Digitales Schloss / Chipschlüssel für jedes Zimmer</span><span data-en>Digital lock / chip key for each room</span></li>
          <li class="reveal-child"><span data-de>Internetzugang</span><span data-en>Internet access</span></li>
          <li class="reveal-child"><span data-de>Regelmäßige Grundreinigung der Gemeinschaftsräume (tägliches Putzen ist WG-Aufgabe, Putz-App verfügbar)</span><span data-en>Regular cleaning of shared areas (daily cleaning is a shared responsibility, cleaning app available)</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Requirements callout -->
  <section class="requirements-section">
    <div class="container">
      <p class="requirements-note reveal" data-de>Eine gültige Immatrikulationsbescheinigung ist Voraussetzung für die Anmietung eines Zimmers. Die Kaution beträgt [#] Monatskomplettmieten und wird nach Auszug unkompliziert und zeitnah zurückerstattet.</p>
      <p class="requirements-note reveal" data-en>A valid university enrollment certificate is required to rent a room. The deposit is [#] months' total rent and will be returned promptly and without complications after moving out.</p>
    </div>
  </section>

  <!-- Apartment cards -->

  <section class="section apt-section">
    <div class="container">
      <div class="apt-grid reveal-stagger">
        {apartments.map((apt) => {
          const slug = entrySlug(apt.id);
          const { data } = apt;
          const grundriss = grundrissMap[slug];
          return (
          <a class="apt-card reveal-child" href={`${base}wohngemeinschaften/${slug}/`}>
            <div class="apt-floorplan">
              {grundriss
                ? <>
                    <img
                      src={`${base}${grundriss}`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      data-iz-open
                      data-iz-src={`${base}${grundriss}`}
                      data-iz-title-de={data.title_de}
                      data-iz-title-en={data.title_en}
                    />
                    <button
                      class="fp-zoom-btn"
                      data-iz-open
                      data-iz-src={`${base}${grundriss}`}
                      data-iz-title-de={data.title_de}
                      data-iz-title-en={data.title_en}
                      aria-label="Grundriss vergrößern"
                    >
                      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                        <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                        <line x1="10" y1="10" x2="14" y2="14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        <line x1="6.5" y1="4" x2="6.5" y2="9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                        <line x1="4" y1="6.5" x2="9" y2="6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      </svg>
                    </button>
                  </>
                : <div class="floorplan-placeholder">
                    <svg viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <rect x="10" y="10" width="140" height="100" stroke="#B8952A" stroke-opacity="0.35" stroke-width="1.5"/>
                      <rect x="10" y="10" width="80" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="90" y="10" width="60" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="90" y="50" width="60" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="10" y="70" width="50" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <rect x="60" y="70" width="30" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                      <line x1="35" y1="70" x2="35" y2="110" stroke="#B8952A" stroke-opacity="0.15" stroke-width="1" stroke-dasharray="3 3"/>
                    </svg>
                    <span class="placeholder-label" data-de>Grundriss folgt</span>
                    <span class="placeholder-label" data-en>Floorplan coming soon</span>
                  </div>
              }
            </div>
            <div class="apt-caption">
              <span class="eyebrow" data-de>Wohngemeinschaft</span>
              <span class="eyebrow" data-en>Shared Apartment</span>
              <span class="apt-title" data-de>{data.title_de}</span>
              <span class="apt-title" data-en>{data.title_en}</span>
              {data.description_de && <p class="apt-desc" data-de>{data.description_de}</p>}
              {data.description_en && <p class="apt-desc" data-en>{data.description_en}</p>}
              <span class="apt-cta" data-de>Zimmer & Details →</span>
              <span class="apt-cta" data-en>Rooms & Details →</span>
            </div>
          </a>
          );
        })}
      </div>
    </div>
  </section>


</Layout>

<style>
/* Intro */
.intro-section { padding-top: 0; padding-bottom: clamp(1rem, 2vw, 1.75rem); }
.intro-cols {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
  align-items: center;
}
.intro-cols > p {
  color: var(--muted);
  font-size: 0.95rem;
  text-align: center;
  max-width: 60ch;
}
.includes {
  width: 100%;
  padding-top: 1.5rem;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.includes ul {
  list-style: none;
  display: grid;
  grid-template-columns: 2fr 1fr 2fr;
  gap: 0.35rem 2rem;
}
.includes li {
  font-size: 0.85rem;
  color: var(--muted);
  padding-left: 0;
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
}
.includes li::before {
  content: '◆';
  flex-shrink: 0;
  font-size: 0.455rem;
  color: var(--gold);
  margin-top: 0.52rem;
  line-height: 1;
}

/* Apartment grid */
.requirements-section { padding-block: 0 1.5rem; }
.requirements-note {
  font-size: 0.85rem;
  color: var(--muted);
  max-width: none;
  padding: 0.9rem 1.25rem;
  border-left: 2px solid var(--gold);
  background: rgba(184, 149, 42, 0.04);
}

.apt-section { padding-top: 1rem; }
.apt-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3rem 2.5rem;
}
.apt-card {
  min-width: 0;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* Floorplan area */
.apt-floorplan {
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--border);
  aspect-ratio: 4 / 3;
  background: var(--bg);
}
.apt-floorplan img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 1rem;
  transition: transform 0.5s ease, opacity 0.7s ease;
}
.apt-card:hover .apt-floorplan img { transform: scale(1.02); }

.floorplan-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 1.5rem;
}
.floorplan-placeholder svg { width: 100%; max-width: 180px; opacity: 0.7; }
.placeholder-label {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}

.apt-caption { display: flex; flex-direction: column; gap: 0.35rem; }
.apt-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 300;
  letter-spacing: 0.04em;
}
.apt-desc { font-size: 0.88rem; color: var(--muted); max-width: 46ch; }
.apt-cta {
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--gold);
  margin-top: 0.15rem;
}
.apt-card:hover .apt-cta { text-decoration: underline; }

/* Floorplan zoom button */
.apt-floorplan { position: relative; }
.apt-floorplan img[data-iz-open] { cursor: pointer; }
.fp-zoom-btn {
  position: absolute;
  top: 0.5rem;
  right: 0.5rem;
  width: 30px;
  height: 30px;
  background: rgba(28, 26, 23, 0.45);
  border: none;
  display: grid;
  place-items: center;
  color: rgba(245, 242, 236, 0.85);
  cursor: pointer;
  opacity: 0;
  transition: opacity var(--ease), background var(--ease);
  z-index: 2;
}
.apt-card:hover .fp-zoom-btn { opacity: 1; }
.fp-zoom-btn:hover { background: rgba(28, 26, 23, 0.75); color: #fff; }

@media (max-width: 860px) {
  .includes li:nth-child(n) { grid-column: span 6; }
  .apt-grid { grid-template-columns: 1fr; }
}
@media (max-width: 540px) {
  .includes li:nth-child(n) { grid-column: span 12; }
}
</style>
