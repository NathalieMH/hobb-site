---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";
import fs from "node:fs/promises";
import path from "node:path";
const base = import.meta.env.BASE_URL;

async function loadRoomImages(slug: string) {
  const dir = path.resolve(process.cwd(), "public", "rooms", slug);
  try {
    const files = await fs.readdir(dir);
    return files
      .filter((f) => /\.(jpe?g|png|webp|gif)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
      .map((f) => `${base}rooms/${slug}/${f}`);
  } catch {
    return [];
  }
}

export async function getStaticPaths() {
  const apartments = await getCollection("apartments");
  return apartments.map(({ slug }) => ({ params: { apartment: slug } }));
}

const { apartment } = Astro.params;
const apartments = await getCollection("apartments");
const apt = apartments.find((a) => a.slug === apartment);
const rooms = await getCollection("rooms", (r) => r.data.apartment === apartment);
const renderedRooms = await Promise.all(
  rooms.map(async (r) => {
    const { Content } = await r.render();
    const imgs = await loadRoomImages(r.slug);
    return { entry: r, Content, imgs };
  })
);
const roomImages = Object.fromEntries(renderedRooms.map(({ entry, imgs }) => [entry.slug, imgs]));
---

<Layout title={`Villa Theo — ${apt?.data.title_de ?? "Wohngemeinschaft"}`}>

  <!-- Apartment header -->
  <section class="section page-header">
    <div class="container page-header-inner">
      <a class="back-link" href={`${base}wohngemeinschaften/`}>
        <span data-de>← Alle Wohnungen</span>
        <span data-en>← All Apartments</span>
      </a>
      <span class="eyebrow" data-de>Wohngemeinschaft</span>
      <span class="eyebrow" data-en>Shared Apartment</span>
      <h1 data-de>{apt?.data.title_de}</h1>
      <h1 data-en>{apt?.data.title_en}</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Apartment details -->
  <section class="section apt-detail">
    <div class="container apt-detail-inner">

      {apt?.data.floorplan && (
        <div class="floorplan-wrap">
          <img src={`${base}${apt.data.floorplan}`} alt="" />
        </div>
      )}

      <div class="apt-info">
        {apt?.data.description_de && (
          <p data-de>{apt.data.description_de}</p>
        )}
        {apt?.data.description_en && (
          <p data-en>{apt.data.description_en}</p>
        )}

        {(apt?.data.shared_spaces_de?.length ?? 0) > 0 && (
          <div class="shared-spaces">
            <h3 data-de>Gemeinschaftsräume</h3>
            <h3 data-en>Shared spaces</h3>
            <ul data-de>
              {apt?.data.shared_spaces_de.map(s => <li>{s}</li>)}
            </ul>
            <ul data-en>
              {apt?.data.shared_spaces_en.map(s => <li>{s}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Rooms grid -->
  <section class="section rooms-section">
    <div class="container">
      <DecoRule />
      <div class="rooms-header">
        <h2 data-de>Zimmer</h2>
        <h2 data-en>Rooms</h2>
      </div>
      <div class="rooms-grid">
        {rooms.map(({ data, slug }) => {
          const imgs = roomImages[slug] ?? [];
          const cover = imgs[0];
          return (
            <button
              class={`room-card open-room${!data.available ? ' room-taken' : ''}`}
              data-room={slug}
              aria-label={data.title_de}
            >
              <div class="room-img-wrap">
                {cover
                  ? <img src={cover} alt={data.title_de} loading="lazy" />
                  : <div class="room-placeholder" />
                }
                {!data.available && (
                  <span class="taken-overlay" data-de>vergeben</span>
                )}
                {!data.available && (
                  <span class="taken-overlay" data-en>taken</span>
                )}
              </div>
              <div class="room-meta">
                <span class="room-title" data-de>
                  {data.title_de}
                  {!data.available && <span class="badge-taken" data-de>vergeben</span>}
                </span>
                <span class="room-title" data-en>
                  {data.title_en}
                  {!data.available && <span class="badge-taken" data-en>taken</span>}
                </span>
                {data.size_m2 && <span class="room-size">{data.size_m2} m²</span>}
              </div>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Room detail templates -->
  {renderedRooms.map(({ entry, Content, imgs }) => {
    const d = entry.data;
    const cover = imgs[0] ?? null;
    const hasGallery = imgs.length > 1;
    return (
      <template id={`tpl-${entry.slug}`}>
        <article class="modal-content" data-images={JSON.stringify(imgs)}>
          <div class="modal-left">
            {hasGallery && <button class="nav prev" aria-label="Vorheriges Bild">‹</button>}
            {cover
              ? <img class="modal-cover" src={cover} alt={d.title_de} data-index="0" />
              : <div class="room-placeholder modal-cover" data-index="-1" />
            }
            {hasGallery && <button class="nav next" aria-label="Nächstes Bild">›</button>}
            {hasGallery && (
              <div class="thumbs">
                {imgs.map((url, i) => (
                  <button class={`thumb${i === 0 ? ' active' : ''}`} data-full={url} data-index={i} aria-label={`Bild ${i+1}`}>
                    <img src={url} alt="" />
                  </button>
                ))}
              </div>
            )}
          </div>
          <div class="modal-right">
            <div class="modal-title-row">
              <h3 data-de>
                {d.title_de}
                {!d.available && <span class="badge-taken" data-de>vergeben</span>}
              </h3>
              <h3 data-en>
                {d.title_en}
                {!d.available && <span class="badge-taken" data-en>taken</span>}
              </h3>
            </div>
            <ul class="room-facts">
              {d.size_m2 && <li><span class="fact-label" data-de>Größe</span><span class="fact-label" data-en>Size</span><span class="fact-val">{d.size_m2} m²</span></li>}
              {d.cold_rent_eur && <li><span class="fact-label" data-de>Kaltmiete</span><span class="fact-label" data-en>Cold rent</span><span class="fact-val">{d.cold_rent_eur} €</span></li>}
              {d.available_from && <li><span class="fact-label" data-de>Verfügbar ab</span><span class="fact-label" data-en>Available from</span><span class="fact-val">{d.available_from}</span></li>}
            </ul>
            {d.teaser_de && <p class="modal-teaser" data-de>{d.teaser_de}</p>}
            {d.teaser_en && <p class="modal-teaser" data-en>{d.teaser_en}</p>}
            <div class="modal-body-text"><Content /></div>
          </div>
        </article>
      </template>
    );
  })}

  <!-- Modal overlay -->
  <div id="overlay" class="overlay hidden" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true">
      <button class="modal-close" aria-label="Schließen">×</button>
      <div id="modal-body"></div>
    </div>
  </div>

</Layout>

<style>
/* Page header */
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
}
.back-link {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 0.5rem;
}
.back-link:hover { color: var(--ink); }

/* Apartment detail */
.apt-detail-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: start;
}
.floorplan-wrap img {
  width: 100%;
  border: 1px solid var(--border);
}
.apt-info p { color: var(--muted); }
.shared-spaces { margin-top: var(--sp-md); }
.shared-spaces h3 { margin-bottom: 0.75rem; font-size: 1rem; font-family: var(--font-sans); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.75rem; color: var(--muted); }
.shared-spaces ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
.shared-spaces li {
  font-size: 0.8rem;
  padding: 0.25rem 0.75rem;
  border: 1px solid var(--border);
  letter-spacing: 0.05em;
}

/* Rooms */
.rooms-header { margin: var(--sp-md) 0 var(--sp-sm); text-align: center; }
.rooms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2rem;
}
.room-card {
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  color: var(--ink);
  cursor: pointer;
}
.room-img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--border);
}
.room-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.room-card:hover .room-img-wrap img { transform: scale(1.04); }
.room-placeholder {
  width: 100%;
  height: 100%;
  background: var(--border);
}
.room-taken .room-img-wrap img { opacity: 0.45; filter: grayscale(0.5); }
.taken-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}
.room-meta { padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.2rem; }
.room-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 300; }
.room-size { font-size: 0.8rem; color: var(--muted); }

/* Modal */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(28, 26, 23, 0.55);
  display: grid;
  place-items: center;
  padding: 2rem;
  z-index: 200;
}
.overlay.hidden { display: none; }
.modal-card {
  background: var(--bg);
  width: min(100%, 980px);
  max-height: 90vh;
  overflow: auto;
  position: relative;
  padding: 2rem;
  border: 1px solid var(--border);
  box-shadow: 0 24px 64px rgba(28, 26, 23, 0.2);
}
.modal-close {
  position: absolute;
  top: 1rem;
  right: 1.25rem;
  background: none;
  border: none;
  font-size: 1.75rem;
  line-height: 1;
  color: var(--muted);
  cursor: pointer;
}
.modal-close:hover { color: var(--ink); }
.modal-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}
.modal-left { position: relative; }
.modal-cover { width: 100%; border: 1px solid var(--border); }
.thumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
.thumb {
  width: 80px; height: 60px;
  border: none; padding: 0; background: none; cursor: pointer;
  position: relative; overflow: hidden;
}
.thumb img { width: 100%; height: 100%; object-fit: cover; }
.thumb::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.5);
  transition: opacity 0.2s;
}
.thumb.active::after { opacity: 0; }
.thumb:hover::after { opacity: 0.2; }
.nav {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  background: rgba(28,26,23,0.5);
  color: var(--ink-light);
  border: none;
  width: 36px; height: 48px;
  font-size: 1.5rem;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background var(--ease);
}
.nav:hover { background: rgba(28,26,23,0.75); }
.nav.prev { left: 0; }
.nav.next { right: 0; }
.modal-right { padding-top: 0.5rem; }
.modal-title-row h3 { font-size: 1.6rem; font-weight: 300; margin-bottom: 1rem; }
.room-facts { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }
.room-facts li { display: flex; gap: 1rem; font-size: 0.9rem; }
.fact-label { color: var(--muted); min-width: 8rem; font-size: 0.8rem; letter-spacing: 0.05em; }
.fact-val { font-family: var(--font-serif); font-size: 1rem; }
.modal-teaser { color: var(--muted); font-style: italic; margin-bottom: 0.75rem; }

@media (max-width: 800px) {
  .apt-detail-inner { grid-template-columns: 1fr; }
  .modal-content { grid-template-columns: 1fr; }
}
</style>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const btn = target.closest(".open-room") as HTMLElement | null;
    const overlay = document.getElementById("overlay")!;
    const body = document.getElementById("modal-body")!;

    if (btn) {
      e.preventDefault();
      const slug = btn.getAttribute("data-room");
      const tpl = document.getElementById(`tpl-${slug}`) as HTMLTemplateElement | null;
      if (tpl) {
        body.innerHTML = "";
        body.appendChild(tpl.content.cloneNode(true));
        overlay.classList.remove("hidden");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        const firstThumb = body.querySelector<HTMLElement>('.thumb[data-index="0"]');
        if (firstThumb) {
          body.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
          firstThumb.classList.add("active");
        }
      }
      return;
    }

    if (target.matches(".modal-close") || target === overlay) {
      overlay.classList.add("hidden");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      return;
    }

    const thumb = target.closest(".thumb") as HTMLElement | null;
    if (thumb && body.contains(thumb)) {
      const article = thumb.closest(".modal-content") as HTMLElement;
      const cover = article.querySelector(".modal-cover") as HTMLImageElement;
      const newUrl = thumb.getAttribute("data-full")!;
      const idx = thumb.getAttribute("data-index") || "0";
      cover.setAttribute("src", newUrl);
      cover.setAttribute("data-index", idx);
      article.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
      thumb.classList.add("active");
      return;
    }

    const navBtn = target.closest(".nav") as HTMLElement | null;
    if (navBtn && body.contains(navBtn)) {
      const article = navBtn.closest(".modal-content") as HTMLElement;
      const cover = article.querySelector(".modal-cover") as HTMLImageElement;
      const imgs: string[] = JSON.parse(article.getAttribute("data-images") || "[]");
      if (imgs.length < 2) return;
      let idx = parseInt(cover.getAttribute("data-index") || "0", 10);
      if (isNaN(idx) || idx < 0) idx = 0;
      const newIdx = (idx + (navBtn.classList.contains("next") ? 1 : -1) + imgs.length) % imgs.length;
      cover.setAttribute("src", imgs[newIdx]);
      cover.setAttribute("data-index", String(newIdx));
      article.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
      article.querySelector<HTMLElement>(`.thumb[data-index="${newIdx}"]`)?.classList.add("active");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const overlay = document.getElementById("overlay")!;
      if (!overlay.classList.contains("hidden")) {
        overlay.classList.add("hidden");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
    }
  });
</script>
