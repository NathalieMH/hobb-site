---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import RoomModal from "../../components/RoomModal.astro";
import { getCollection } from "astro:content";
import { loadImages } from "../../utils/images";

const base = import.meta.env.BASE_URL;

function entrySlug(id: string) {
  return id.replace(/\.[^.]+$/, "").toLowerCase();
}

// Filename prefix → bilingual shared space names
const PREFIX_MAP: Record<string, { de: string; en: string }> = {
  "kitchen":        { de: "Küche",              en: "Kitchen" },
  "dining-room":    { de: "Wohn-Esszimmer",     en: "Living-Dining Room" },
  "bathroom1":      { de: "Bad 1",              en: "Bathroom 1" },
  "bathroom2":      { de: "Bad 2",              en: "Bathroom 2" },
  "bathroom3":      { de: "Bad 3",              en: "Bathroom 3" },
  "balcony":        { de: "Balkon",             en: "Balcony" },
  "terrace":        { de: "Terrasse",           en: "Terrace" },
  "laundry":        { de: "Waschküche",         en: "Laundry Room" },
  "roof-terrace":   { de: "Dachterrasse",       en: "Roof Terrace" },
  "garden-terrace": { de: "Gartenterrasse",     en: "Garden Terrace" },
  "entrance":       { de: "Eingang",            en: "Entrance" },
  "digital-lock":   { de: "Digitales Schloss",  en: "Digital Lock" },
  "grundriss":      { de: "Grundriss",          en: "Floor Plan" },
};

function getPrefix(filename: string): string {
  const base = filename.replace(/\.[^.]+$/, "");
  for (const prefix of Object.keys(PREFIX_MAP)) {
    if (base === prefix || base.startsWith(prefix + "-")) return prefix;
  }
  return base;
}

export async function getStaticPaths() {
  const apartments = await getCollection("apartments");
  return apartments.map((a) => ({
    params: { apartment: a.id.replace(/\.[^.]+$/, "").toLowerCase() },
  }));
}

const { apartment } = Astro.params;
const apartments = await getCollection("apartments");
const apt = apartments.find((a) => entrySlug(a.id) === apartment);

// Sort rooms by frontmatter order, then available-first within same order value.
const rooms = (await getCollection("rooms", (r) => r.data.apartment.toLowerCase() === apartment.toLowerCase()))
  .sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    if (a.data.available === b.data.available) return 0;
    return a.data.available ? -1 : 1;
  });

const roomImages = Object.fromEntries(
  await Promise.all(
    rooms.map(async (r) => {
      const allImgs = await loadImages(base, `zimmer/${entrySlug(r.id)}`);
      const isRoomCover = (url: string) => {
        const stem = (url.split("/").pop() ?? "").replace(/\.[^.]+$/, "");
        const key = stem.includes("_") ? stem.split("_").slice(1).join("_") : stem;
        return key.toLowerCase() === "cover";
      };
      const coverUrl = allImgs.find(isRoomCover) ?? null;
      const galleryImgs = allImgs.filter((url) => !isRoomCover(url));
      const imgs = coverUrl ? [coverUrl, ...galleryImgs] : galleryImgs;
      return [entrySlug(r.id), imgs];
    })
  )
);

// Apartment images from wohngemeinschaften/[image_folder]/
const aptFolder = apt?.data.image_folder ? `wohngemeinschaften/${apt.data.image_folder}` : "";
const allAptFiles = aptFolder ? await loadImages(base, aptFolder) : [];

// Exclude only cover from space images; grundriss is handled as a named prefix
const rawImages = allAptFiles.filter((url) => !/\/cover\.[^/]+$/i.test(url));

// Space order and labels from apartment frontmatter
const spaceOrder = (apt?.data.shared_spaces ?? []).map((s) => s.prefix);
const spaceLabelMap = Object.fromEntries(
  (apt?.data.shared_spaces ?? []).map((s) => [s.prefix, { de: s.de, en: s.en }])
);

// Group raw images by prefix → one tile per space
const grouped: Record<string, string[]> = {};
for (const url of rawImages) {
  const fname = url.split("/").pop() ?? "";
  const prefix = getPrefix(fname);
  if (!grouped[prefix]) grouped[prefix] = [];
  grouped[prefix].push(url);
}

// All spaces declared in shared_spaces are shown; placeholder renders when no photos exist yet.
const spaceGroups = spaceOrder.map((prefix) => {
  const images = grouped[prefix] ?? [];
  const labels = spaceLabelMap[prefix] ?? PREFIX_MAP[prefix] ?? { de: prefix, en: prefix };

  const cover =
    images.find((url) => {
      const base = (url.split("/").pop() ?? "").replace(/\.[^.]+$/, "");
      return base.endsWith("-cover");
    }) ?? images[0] ?? null;
  const modalImages = cover ? [cover, ...images.filter((url) => url !== cover)] : images;

  return {
    prefix,
    titleDe: labels.de,
    titleEn: labels.en,
    cover,
    images,
    modalImages,
  };
});
---

<Layout title={`Haderslebener 26 — ${apt?.data.title_de ?? "Wohngemeinschaft"}`}>

  <!-- Apartment header -->
  <section class="page-header">
    <div class="container page-header-inner">
      <a class="back-link" href={`${base}wohngemeinschaften/`}>
        <span data-de>← Alle Wohnungen</span>
        <span data-en>← All Apartments</span>
      </a>
      <span class="eyebrow" data-de>Wohngemeinschaft</span>
      <span class="eyebrow" data-en>Shared Apartment</span>
      <h1 data-de>{apt?.data.title_de}</h1>
      <h1 data-en>{apt?.data.title_en}</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Rooms + common spaces grid -->
  <section class="section rooms-section" style="padding-top: 0">
    <div class="container">
      <div class="rooms-grid">
        {rooms.map((room) => {
          const slug = entrySlug(room.id);
          const { data } = room;
          const imgs = roomImages[slug] ?? [];
          const cover = imgs[0];
          return (
            <button
              class={`room-card open-room${!data.available ? " room-taken" : ""}`}
              data-room={slug}
              aria-label={data.title_de}
            >
              <div class="room-img-wrap">
                {cover
                  ? <img src={cover} alt={data.title_de} loading="lazy" decoding="async" />
                  : <div class="room-placeholder" />
                }
                <span class="gallery-cue" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M22 16V4c0-1.1-.9-2-2-2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2Zm-11-4 2.03 2.71L16 11l4 5H8l3-4ZM2 6v14c0 1.1.9 2 2 2h14v-2H4V6H2Z" />
                  </svg>
                </span>
                {!data.available && <span class="taken-overlay" data-de>vergeben</span>}
                {!data.available && <span class="taken-overlay" data-en>taken</span>}
              </div>
              <div class="room-meta">
                <span class="room-title" data-de>
                  {data.title_de}
                  {!data.available && <span class="badge-taken" data-de>vergeben</span>}
                </span>
                <span class="room-title" data-en>
                  {data.title_en}
                  {!data.available && <span class="badge-taken" data-en>taken</span>}
                </span>
                <div class="room-stats">
                  {data.size_m2 && <span class="room-size">{data.size_m2} m²</span>}
                </div>
                {(data.kaltmiete_eur || data.nebenkosten_eur || data.gesamtmiete_eur) && (
                  <div class="room-prices">
                    {data.kaltmiete_eur && (
                      <span class="price-item">
                        <span class="price-lbl" data-de>Kalt</span><span class="price-lbl" data-en>Rent</span>
                        <span class="price-num">{data.kaltmiete_eur} €</span>
                      </span>
                    )}
                    {data.nebenkosten_eur && (
                      <>
                        <span class="price-sep" aria-hidden="true">+</span>
                        <span class="price-item">
                          <span class="price-lbl">NK</span>
                          <span class="price-num">{data.nebenkosten_eur} €</span>
                        </span>
                      </>
                    )}
                    {data.gesamtmiete_eur && (
                      <>
                        <span class="price-sep" aria-hidden="true">=</span>
                        <span class="price-item price-item-total">
                          <span class="price-lbl" data-de>Gesamt</span><span class="price-lbl" data-en>Total</span>
                          <span class="price-num">{data.gesamtmiete_eur} €</span>
                        </span>
                      </>
                    )}
                  </div>
                )}
              </div>
            </button>
          );
        })}

        {spaceGroups.map(({ prefix, titleDe, titleEn, cover, images }) => {
          if (prefix === "grundriss") {
            return (
              <button
                class="room-card floorplan-card"
                data-iz-open={cover ? true : undefined}
                data-iz-src={cover ?? undefined}
                aria-label={titleDe}
              >
                <div class="room-img-wrap">
                  {cover
                    ? <img src={cover} alt={titleDe} loading="lazy" decoding="async" />
                    : <div class="room-placeholder" />
                  }
                </div>
                <div class="room-meta">
                  <span class="room-title" data-de>{titleDe}</span>
                  <span class="room-title" data-en>{titleEn}</span>
                </div>
              </button>
            );
          }

          return (
            <button
              class="room-card space-card"
              data-space-prefix={prefix}
              aria-label={titleDe}
            >
              <div class="room-img-wrap">
                {cover
                  ? <img src={cover} alt={titleDe} loading="lazy" decoding="async" />
                  : <div class="room-placeholder" />
                }
                <span class="gallery-cue" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M22 16V4c0-1.1-.9-2-2-2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2Zm-11-4 2.03 2.71L16 11l4 5H8l3-4ZM2 6v14c0 1.1.9 2 2 2h14v-2H4V6H2Z" />
                  </svg>
                </span>
              </div>
              <div class="room-meta">
                <span class="room-title" data-de>{titleDe}</span>
                <span class="room-title" data-en>{titleEn}</span>
                {images.length > 1 && (
                  <div class="room-stats">
                    <span class="room-size" data-de>{images.length} Fotos</span>
                    <span class="room-size" data-en>{images.length} photos</span>
                  </div>
                )}
              </div>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <RoomModal
    rooms={rooms.map(r => ({
      entry: r,
      imgs: roomImages[entrySlug(r.id)] ?? [],
      sharedM2: apt?.data.shared_m2,
    }))}
    spaces={spaceGroups
      .filter(({ prefix }) => prefix !== "grundriss")
      .map(({ prefix, titleDe, titleEn, modalImages }) => ({
        prefix,
        titleDe,
        titleEn,
        imgs: modalImages,
      }))}
  />

</Layout>

<style>
/* Page header */
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
}
.back-link {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 0.5rem;
}
.back-link:hover { color: var(--ink); }

/* Rooms */
.rooms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2rem;
  align-items: start;
}
.room-card {
  min-width: 0;
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  color: var(--ink);
  cursor: pointer;
}
.room-img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--border);
}
.gallery-cue {
  position: absolute;
  top: 0.55rem;
  right: 0.55rem;
  z-index: 2;
  width: 1.68rem;
  height: 1.68rem;
  display: grid;
  place-items: center;
  border: 1px solid rgba(184, 149, 42, 0.5);
  background: rgba(245, 242, 236, 0.75);
  filter: drop-shadow(0 1px 2px rgba(28, 26, 23, 0.22));
  opacity: 0.92;
  pointer-events: none;
  transition: opacity var(--ease), transform var(--ease), filter var(--ease);
}
.gallery-cue svg {
  width: 1.34rem;
  height: 1.34rem;
  fill: var(--gold);
}
.room-card.open-room:hover .gallery-cue,
.room-card.space-card:hover .gallery-cue,
.room-card.open-room:focus-visible .gallery-cue,
.room-card.space-card:focus-visible .gallery-cue {
  opacity: 1;
  background: rgba(250, 248, 243, 0.75);
  border-color: rgba(184, 149, 42, 0.76);
  filter: drop-shadow(0 1px 3px rgba(28, 26, 23, 0.28));
  transform: translate(1px, -1px);
}
.room-img-wrap img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease, opacity 0.7s ease;
}
.room-card:hover .room-img-wrap img { transform: scale(1.04); }
.room-placeholder { width: 100%; height: 100%; background: var(--border); }
.room-taken .room-img-wrap img { opacity: 0.45; filter: grayscale(0.5); }
.taken-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}
.room-meta { padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
.room-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 300; }
.room-stats { display: flex; gap: 1rem; align-items: baseline; font-family: var(--font-sans); }
.room-size { font-family: var(--font-sans); font-size: 0.8rem; color: var(--muted); }
.room-prices {
  display: flex;
  align-items: flex-end;
  gap: 0.3rem;
  margin-top: 0.1rem;
  font-family: var(--font-sans);
}
.price-item {
  display: flex;
  flex-direction: column;
  gap: 0.05rem;
}
.price-lbl {
  font-family: var(--font-sans);
  font-size: 0.58rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1;
}
.price-num {
  font-family: var(--font-sans);
  font-size: 0.58rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  line-height: 1;
}
.price-sep {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  color: var(--muted);
  padding-bottom: 0.1rem;
}
.price-item-total .price-num { font-size: 0.58rem; }
</style>
