---
import Layout from "../../layouts/Layout.astro";
import DecoRule from "../../components/DecoRule.astro";
import { getCollection } from "astro:content";
import fs from "node:fs/promises";
import path from "node:path";
const base = import.meta.env.BASE_URL;

async function loadImages(folder: string) {
  const dir = path.resolve(process.cwd(), "public", folder);
  try {
    const files = await fs.readdir(dir);
    return files
      .filter((f) => /\.(jpe?g|png|webp|gif)$/i.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
      .map((f) => `${base}${folder}/${f}`);
  } catch {
    return [];
  }
}

// Filename prefix → bilingual shared space names
const PREFIX_MAP: Record<string, { de: string; en: string }> = {
  'kitchen':        { de: 'Küche',           en: 'Kitchen' },
  'dining-room':    { de: 'Wohn-Esszimmer',  en: 'Living-Dining Room' },
  'bathroom-1':     { de: 'Bad 1',           en: 'Bathroom 1' },
  'bathroom-2':     { de: 'Bad 2',           en: 'Bathroom 2' },
  'bathroom-3':     { de: 'Bad 3',           en: 'Bathroom 3' },
  'balcony':        { de: 'Balkon',          en: 'Balcony' },
  'terrace':        { de: 'Terrasse',        en: 'Terrace' },
  'laundry':        { de: 'Waschküche',      en: 'Laundry Room' },
  'roof-terrace':   { de: 'Dachterrasse',    en: 'Roof Terrace' },
  'garden-terrace': { de: 'Gartenterrasse',  en: 'Garden Terrace' },
};

function getPrefix(filename: string): string {
  const base = filename.replace(/\.[^.]+$/, '');
  for (const prefix of Object.keys(PREFIX_MAP)) {
    if (base === prefix || base.startsWith(prefix + '-')) return prefix;
  }
  return base;
}

export async function getStaticPaths() {
  const apartments = await getCollection("apartments");
  return apartments.map(({ slug }) => ({ params: { apartment: slug } }));
}

const { apartment } = Astro.params;
const apartments = await getCollection("apartments");
const apt = apartments.find((a) => a.slug === apartment);

// Available rooms first, taken rooms last
const rooms = (await getCollection("rooms", (r) => r.data.apartment.toLowerCase() === apartment.toLowerCase()))
  .sort((a, b) => {
    if (a.data.available === b.data.available) return 0;
    return a.data.available ? -1 : 1;
  });

const renderedRooms = await Promise.all(
  rooms.map(async (r) => {
    const { Content } = await r.render();
    const allImgs = await loadImages(`zimmer/${r.slug}`);
    const coverUrl = allImgs.find(url => /\/cover\.[^/]+$/i.test(url)) ?? null;
    const galleryImgs = allImgs.filter(url => !/\/cover\.[^/]+$/i.test(url));
    const imgs = coverUrl ? [coverUrl, ...galleryImgs] : galleryImgs;
    return { entry: r, Content, imgs };
  })
);
const roomImages = Object.fromEntries(renderedRooms.map(({ entry, imgs }) => [entry.slug, imgs]));

// Apartment images from wohngemeinschaften/[image_folder]/
const aptFolder = apt?.data.image_folder ? `wohngemeinschaften/${apt.data.image_folder}` : '';
const allAptFiles = aptFolder ? await loadImages(aptFolder) : [];

// Separate grundriss and cover from carousel candidates
const grundrissUrl = allAptFiles.find(url => /\/grundriss\.[^/]+$/i.test(url)) ?? '';
const aptCoverUrl = allAptFiles.find(url => /\/cover\.[^/]+$/i.test(url)) ?? null;
const rawImages = allAptFiles.filter(url =>
  !/\/grundriss\.[^/]+$/i.test(url) && !/\/cover\.[^/]+$/i.test(url)
);

// Sort by shared_spaces_de order, then naturally within each group
const spaceOrder = (apt?.data.shared_spaces_de ?? [])
  .map(nameDE => Object.entries(PREFIX_MAP).find(([, v]) => v.de === nameDE)?.[0])
  .filter((p): p is string => !!p);

const orderedImages = [
  ...spaceOrder.flatMap(prefix =>
    rawImages.filter(url => getPrefix(url.split('/').pop() ?? '') === prefix)
  ),
  ...rawImages.filter(url => !spaceOrder.includes(getPrefix(url.split('/').pop() ?? ''))),
];

// cover.* goes first if present; otherwise dining-room-1 is first via spaceOrder
// grundriss always goes last
const carouselImages = [
  ...(aptCoverUrl ? [aptCoverUrl, ...orderedImages] : orderedImages),
  ...(grundrissUrl ? [grundrissUrl] : []),
];

// Build DE space name → carousel start index
const spaceStartIndices: Record<string, number> = {};
for (const nameDE of (apt?.data.shared_spaces_de ?? [])) {
  const prefix = Object.entries(PREFIX_MAP).find(([, v]) => v.de === nameDE)?.[0];
  if (prefix) {
    const firstIdx = carouselImages.findIndex(url => {
      const fname = url.split('/').pop() ?? '';
      return getPrefix(fname) === prefix;
    });
    if (firstIdx !== -1) spaceStartIndices[nameDE] = firstIdx;
  }
}

const hasAptImages = carouselImages.length > 0;
---

<Layout title={`Villa Theo — ${apt?.data.title_de ?? "Wohngemeinschaft"}`}>

  <!-- Apartment header -->
  <section class="page-header">
    <div class="container page-header-inner">
      <a class="back-link" href={`${base}wohngemeinschaften/`}>
        <span data-de>← Alle Wohnungen</span>
        <span data-en>← All Apartments</span>
      </a>
      <span class="eyebrow" data-de>Wohngemeinschaft</span>
      <span class="eyebrow" data-en>Shared Apartment</span>
      <h1 data-de>{apt?.data.title_de}</h1>
      <h1 data-en>{apt?.data.title_en}</h1>
      <DecoRule />
    </div>
  </section>

  <!-- Apartment details: info left, carousel right -->
  <section class="section apt-detail" style="padding-top:1.5rem; padding-bottom: 1rem">
    <div class="container apt-detail-inner">

      <!-- Left: description + shared spaces -->
      <div class="apt-info">
        {apt?.data.description_de && <p data-de>{apt.data.description_de}</p>}
        {apt?.data.description_en && <p data-en>{apt.data.description_en}</p>}

        {(apt?.data.shared_spaces_de?.length ?? 0) > 0 && (
          <div class="shared-spaces">
            <h3 data-de>Gemeinschaftsräume</h3>
            <h3 data-en>Shared Spaces</h3>
            <ul class="space-tags">
              {apt?.data.shared_spaces_de.map((nameDE, i) => {
                const nameEN = apt.data.shared_spaces_en[i] ?? nameDE;
                return (
                  <li>
                    <button class="space-tag" data-space-de={nameDE} data-de>{nameDE}</button>
                    <button class="space-tag" data-space-de={nameDE} data-en>{nameEN}</button>
                  </li>
                );
              })}
            </ul>
          </div>
        )}
      </div>

      <!-- Right: carousel
           Images go in: public/apartments/[slug]/
           Name files like: 01-kueche.jpg, 02-bad1.jpg etc. for sort order.
           To map a shared space to an image, add to the apartment's frontmatter:
             shared_space_images:
               "Bad 1": 02-bad1.jpg
      -->
      <div class="apt-carousel" id="apt-carousel" data-images={JSON.stringify(carouselImages)} data-space-indices={JSON.stringify(spaceStartIndices)}>
        <div class="car-stage" id="car-stage">
          {hasAptImages
            ? <img class="car-img" id="car-img" src={carouselImages[0]} alt="" data-index="0" loading="lazy" />
            : <div class="car-placeholder">
                <svg viewBox="0 0 160 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <rect x="10" y="10" width="140" height="100" stroke="#B8952A" stroke-opacity="0.35" stroke-width="1.5"/>
                  <rect x="10" y="10" width="80" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                  <rect x="90" y="10" width="60" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                  <rect x="90" y="50" width="60" height="60" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                  <rect x="10" y="70" width="50" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                  <rect x="60" y="70" width="30" height="40" stroke="#B8952A" stroke-opacity="0.25" stroke-width="1"/>
                </svg>
                <span class="car-placeholder-label" data-de>Bilder folgen</span>
                <span class="car-placeholder-label" data-en>Images coming soon</span>
              </div>
          }
        </div>
        {hasAptImages && (
          <div class="car-controls">
            <button class="car-nav car-prev" id="car-prev" aria-label="Vorheriges Bild">‹</button>
            <span class="car-counter" id="car-counter">1 / {carouselImages.length}</span>
            <button class="car-nav car-next" id="car-next" aria-label="Nächstes Bild">›</button>
            {grundrissUrl && (
              <button class="car-floorplan-btn" id="car-floorplan-btn" aria-label="Grundriss anzeigen">
                <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="1.5" y="1.5" width="15" height="15" stroke="currentColor" stroke-width="1.2"/>
                  <rect x="1.5" y="1.5" width="9" height="8" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                  <rect x="10.5" y="1.5" width="6" height="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                  <rect x="1.5" y="9.5" width="6" height="7" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                </svg>
              </button>
            )}
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- Rooms grid -->
  <section class="section rooms-section" style="padding-top: 0">
    <div class="container">
      <DecoRule />
      <div class="rooms-header">
        <h2 data-de>Zimmer</h2>
        <h2 data-en>Rooms</h2>
      </div>
      <div class="rooms-grid">
        {rooms.map(({ data, slug }) => {
          const imgs = roomImages[slug] ?? [];
          const cover = imgs[0];
          return (
            <button
              class={`room-card open-room${!data.available ? ' room-taken' : ''}`}
              data-room={slug}
              aria-label={data.title_de}
            >
              <div class="room-img-wrap">
                {cover
                  ? <img src={cover} alt={data.title_de} loading="lazy" />
                  : <div class="room-placeholder" />
                }
                {!data.available && <span class="taken-overlay" data-de>vergeben</span>}
                {!data.available && <span class="taken-overlay" data-en>taken</span>}
              </div>
              <div class="room-meta">
                <span class="room-title" data-de>
                  {data.title_de}
                  {!data.available && <span class="badge-taken" data-de>vergeben</span>}
                </span>
                <span class="room-title" data-en>
                  {data.title_en}
                  {!data.available && <span class="badge-taken" data-en>taken</span>}
                </span>
                <div class="room-stats">
                  {data.size_m2 && <span class="room-size">{data.size_m2} m²</span>}
                  {data.cold_rent_eur && <span class="room-rent">{data.cold_rent_eur} €<span class="rent-unit">/Mo.</span></span>}
                </div>
              </div>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Room detail templates -->
  {renderedRooms.map(({ entry, Content, imgs }) => {
    const d = entry.data;
    const cover = imgs[0] ?? null;
    const hasGallery = imgs.length > 1;
    return (
      <template id={`tpl-${entry.slug}`}>
        <article class="modal-content" data-images={JSON.stringify(imgs)}>
          <div class="modal-left">
            {hasGallery && <button class="nav prev" aria-label="Vorheriges Bild">‹</button>}
            {cover
              ? <img class="modal-cover" src={cover} alt={d.title_de} data-index="0" />
              : <div class="room-placeholder modal-cover" data-index="-1" />
            }
            {hasGallery && <button class="nav next" aria-label="Nächstes Bild">›</button>}
            {hasGallery && (
              <div class="thumbs">
                {imgs.map((url, i) => (
                  <button class={`thumb${i === 0 ? ' active' : ''}`} data-full={url} data-index={i} aria-label={`Bild ${i+1}`}>
                    <img src={url} alt="" />
                  </button>
                ))}
              </div>
            )}
          </div>
          <div class="modal-right">
            <div class="modal-title-row">
              <h3 data-de>
                {d.title_de}
                {!d.available && <span class="badge-taken" data-de>vergeben</span>}
              </h3>
              <h3 data-en>
                {d.title_en}
                {!d.available && <span class="badge-taken" data-en>taken</span>}
              </h3>
            </div>
            <ul class="room-facts">
              {d.size_m2 && <li><span class="fact-label" data-de>Größe</span><span class="fact-label" data-en>Size</span><span class="fact-val">{d.size_m2} m²</span></li>}
              {d.cold_rent_eur && <li><span class="fact-label" data-de>Kaltmiete</span><span class="fact-label" data-en>Cold rent</span><span class="fact-val">{d.cold_rent_eur} €/Mo.</span></li>}
              {d.available_from && <li><span class="fact-label" data-de>Verfügbar ab</span><span class="fact-label" data-en>Available from</span><span class="fact-val">{d.available_from}</span></li>}
            </ul>
            {d.teaser_de && <p class="modal-teaser" data-de>{d.teaser_de}</p>}
            {d.teaser_en && <p class="modal-teaser" data-en>{d.teaser_en}</p>}
            <div class="modal-body-text"><Content /></div>
          </div>
        </article>
      </template>
    );
  })}

  <!-- Modal overlay -->
  <div id="overlay" class="overlay hidden" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true">
      <button class="modal-close" aria-label="Schließen">×</button>
      <div id="modal-body"></div>
    </div>
  </div>

</Layout>

<style>
/* Page header */
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 0.75rem;
}
.back-link {
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  margin-bottom: 0.5rem;
}
.back-link:hover { color: var(--ink); }

/* Apartment detail: info left, carousel right */
.apt-detail-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  align-items: start;
}
.apt-info { display: flex; flex-direction: column; gap: 1.5rem; }
.apt-info p { color: var(--muted); }

/* Shared spaces */
.shared-spaces { display: flex; flex-direction: column; gap: 0.75rem; }
.shared-spaces h3 {
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  font-family: var(--font-sans);
  font-weight: 500;
}
.space-tags {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.space-tags li { display: contents; }
.space-tag {
  font-size: 0.8rem;
  padding: 0.3rem 0.8rem;
  border: 1px solid var(--border);
  background: none;
  color: var(--ink);
  cursor: pointer;
  letter-spacing: 0.04em;
  transition: background var(--ease), border-color var(--ease), color var(--ease);
}
.space-tag:hover,
.space-tag.active {
  background: var(--ink);
  color: var(--ink-light);
  border-color: var(--ink);
}

/* Carousel */
.apt-carousel { display: flex; flex-direction: column; gap: 0.75rem; }
.car-stage {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: var(--bg);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.car-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: opacity 0.25s ease;
}
.car-placeholder {
  width: 100%;
  aspect-ratio: 4 / 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 2rem;
  background: var(--bg);
}
.car-placeholder svg { width: 60%; max-width: 180px; opacity: 0.6; }
.car-placeholder-label {
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}
.car-controls {
  position: relative;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  justify-content: center;
}
.car-floorplan-btn {
  position: absolute;
  right: 0;
  background: none;
  border: 1px solid var(--border);
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: var(--muted);
  cursor: pointer;
  transition: color var(--ease), border-color var(--ease);
  flex-shrink: 0;
}
.car-floorplan-btn svg { width: 16px; height: 16px; }
.car-floorplan-btn:hover { color: var(--ink); border-color: var(--ink); }
.car-nav {
  background: none;
  border: 1px solid var(--border);
  width: 34px;
  height: 34px;
  font-size: 1.2rem;
  color: var(--muted);
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: color var(--ease), border-color var(--ease);
}
.car-nav:hover { color: var(--ink); border-color: var(--ink); }
.car-counter {
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: var(--muted);
  min-width: 3rem;
  text-align: center;
}

/* Rooms */
.rooms-header { margin: 0.75rem 0 var(--sp-sm); text-align: center; }
.rooms-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 2rem;
}
.room-card {
  min-width: 0;
  background: none;
  border: none;
  padding: 0;
  text-align: left;
  color: var(--ink);
  cursor: pointer;
}
.room-img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 4/3;
  background: var(--border);
}
.room-img-wrap img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}
.room-card:hover .room-img-wrap img { transform: scale(1.04); }
.room-placeholder { width: 100%; height: 100%; background: var(--border); }
.room-taken .room-img-wrap img { opacity: 0.45; filter: grayscale(0.5); }
.taken-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--muted);
}
.room-meta { padding-top: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; }
.room-title { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 300; }
.room-stats { display: flex; gap: 1rem; align-items: baseline; }
.room-size { font-size: 0.8rem; color: var(--muted); }
.room-rent { font-size: 0.85rem; color: var(--ink); font-family: var(--font-serif); }
.rent-unit { font-family: var(--font-sans); font-size: 0.7rem; color: var(--muted); }

/* Modal */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(28, 26, 23, 0.55);
  display: grid;
  place-items: center;
  padding: 2rem;
  z-index: 200;
}
.overlay.hidden { display: none; }
.modal-card {
  background: var(--bg);
  width: min(100%, 980px);
  max-height: 90vh;
  overflow: auto;
  position: relative;
  padding: 2rem;
  border: 1px solid var(--border);
  box-shadow: 0 24px 64px rgba(28, 26, 23, 0.2);
}
.modal-close {
  position: absolute;
  top: 1rem;
  right: 1.25rem;
  background: none;
  border: none;
  font-size: 1.75rem;
  line-height: 1;
  color: var(--muted);
  cursor: pointer;
}
.modal-close:hover { color: var(--ink); }
.modal-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
}
.modal-left { position: relative; }
.modal-cover { width: 100%; border: 1px solid var(--border); }
.thumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.75rem; }
.thumb {
  width: 80px; height: 60px;
  border: none; padding: 0; background: none; cursor: pointer;
  position: relative; overflow: hidden;
}
.thumb img { width: 100%; height: 100%; object-fit: cover; }
.thumb::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.5);
  transition: opacity 0.2s;
}
.thumb.active::after { opacity: 0; }
.thumb:hover::after { opacity: 0.2; }
.nav {
  position: absolute;
  top: 45%;
  transform: translateY(-50%);
  background: rgba(28,26,23,0.5);
  color: var(--ink-light);
  border: none;
  width: 36px; height: 48px;
  font-size: 1.5rem;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background var(--ease);
}
.nav:hover { background: rgba(28,26,23,0.75); }
.nav.prev { left: 0; }
.nav.next { right: 0; }
.modal-right { padding-top: 0.5rem; }
.modal-title-row h3 { font-size: 1.6rem; font-weight: 300; margin-bottom: 1rem; }
.room-facts { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; }
.room-facts li { display: flex; gap: 1rem; font-size: 0.9rem; }
.fact-label { color: var(--muted); min-width: 8rem; font-size: 0.8rem; letter-spacing: 0.05em; }
.fact-val { font-family: var(--font-serif); font-size: 1rem; }
.modal-teaser { color: var(--muted); font-style: italic; margin-bottom: 0.75rem; }

@media (max-width: 800px) {
  .apt-detail-inner { grid-template-columns: 1fr; }
  .modal-content { grid-template-columns: 1fr; }
}
</style>

<script>
  // ── Apartment carousel ──────────────────────────────────────────
  const carousel = document.getElementById('apt-carousel');
  if (carousel) {
    const imgs: string[] = JSON.parse(carousel.getAttribute('data-images') || '[]');
    const stage    = document.getElementById('car-stage')!;
    const counterEl = document.getElementById('car-counter');
    let currentIdx = 0;

    function goTo(idx: number) {
      if (!imgs.length) return;
      currentIdx = (idx + imgs.length) % imgs.length;
      let img = stage.querySelector('.car-img') as HTMLImageElement | null;
      if (!img) {
        img = document.createElement('img');
        img.className = 'car-img';
        img.setAttribute('alt', '');
        stage.innerHTML = '';
        stage.appendChild(img);
      }
      img.src = imgs[currentIdx];
      img.setAttribute('data-index', String(currentIdx));
      if (counterEl) counterEl.textContent = `${currentIdx + 1} / ${imgs.length}`;
    }

    document.getElementById('car-prev')?.addEventListener('click', () => goTo(currentIdx - 1));
    document.getElementById('car-next')?.addEventListener('click', () => goTo(currentIdx + 1));
    document.getElementById('car-floorplan-btn')?.addEventListener('click', () => goTo(imgs.length - 1));

    // Space tag → carousel
    const spaceIndices: Record<string, number> = JSON.parse(
      carousel.getAttribute('data-space-indices') || '{}'
    );
    document.querySelectorAll<HTMLButtonElement>('.space-tag').forEach(btn => {
      btn.addEventListener('click', () => {
        const nameDE = btn.getAttribute('data-space-de');
        const li = btn.closest('li');
        document.querySelectorAll('.space-tag').forEach(t => t.classList.remove('active'));
        li?.querySelectorAll('.space-tag').forEach(t => t.classList.add('active'));
        if (nameDE !== null && spaceIndices[nameDE] !== undefined) {
          goTo(spaceIndices[nameDE]);
        }
      });
    });
  }

  // ── Room modal ─────────────────────────────────────────────────
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    const btn = target.closest(".open-room") as HTMLElement | null;
    const overlay = document.getElementById("overlay")!;
    const body = document.getElementById("modal-body")!;

    if (btn) {
      e.preventDefault();
      const slug = btn.getAttribute("data-room");
      const tpl = document.getElementById(`tpl-${slug}`) as HTMLTemplateElement | null;
      if (tpl) {
        body.innerHTML = "";
        body.appendChild(tpl.content.cloneNode(true));
        overlay.classList.remove("hidden");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }
      return;
    }

    if (target.matches(".modal-close") || target === overlay) {
      overlay.classList.add("hidden");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      return;
    }

    const thumb = target.closest(".thumb") as HTMLElement | null;
    if (thumb && body.contains(thumb)) {
      const article = thumb.closest(".modal-content") as HTMLElement;
      const cover = article.querySelector(".modal-cover") as HTMLImageElement;
      cover.setAttribute("src", thumb.getAttribute("data-full")!);
      cover.setAttribute("data-index", thumb.getAttribute("data-index") || "0");
      article.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
      thumb.classList.add("active");
      return;
    }

    const navBtn = target.closest(".nav") as HTMLElement | null;
    if (navBtn && body.contains(navBtn)) {
      const article = navBtn.closest(".modal-content") as HTMLElement;
      const cover = article.querySelector(".modal-cover") as HTMLImageElement;
      const allImgs: string[] = JSON.parse(article.getAttribute("data-images") || "[]");
      if (allImgs.length < 2) return;
      let idx = parseInt(cover.getAttribute("data-index") || "0", 10);
      if (isNaN(idx) || idx < 0) idx = 0;
      const newIdx = (idx + (navBtn.classList.contains("next") ? 1 : -1) + allImgs.length) % allImgs.length;
      cover.setAttribute("src", allImgs[newIdx]);
      cover.setAttribute("data-index", String(newIdx));
      article.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
      article.querySelector<HTMLElement>(`.thumb[data-index="${newIdx}"]`)?.classList.add("active");
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      const overlay = document.getElementById("overlay")!;
      if (!overlay.classList.contains("hidden")) {
        overlay.classList.add("hidden");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }
    }
  });
</script>
