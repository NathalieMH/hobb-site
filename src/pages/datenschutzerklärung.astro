---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Datenschutzerklärung — Haderslebener 26">
  <main class="legal-page">
    <h1>Datenschutzerklärung</h1>

    <p>
      Hier steht die Datenschutzerklärung für Haderslebener 26.
    </p>
  </main>
</Layout>

<style>
  .legal-page {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7rem) 1.5rem;
  }

  .legal-page h1 {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2rem, 5vw, 3.2rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .legal-page p {
    font-family: var(--font-sans);
    color: var(--muted);
    line-height: 1.8;
  }
</style>
