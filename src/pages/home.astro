---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
const base = import.meta.env.BASE_URL;
---
<Layout title="Villa Theo — Berlin">

  <!-- Hero -->
  <section class="hero">
    <img
      class="hero-img"
      src={`${base}first-image.png`}
      alt="Villa Theo, Berlin Steglitz-Dahlem"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay">
      <span class="eyebrow" data-de>Berlin · Steglitz · Dahlem</span>
      <span class="eyebrow" data-en>Berlin · Steglitz · Dahlem</span>
      <h1 class="hero-title">Villa Theo</h1>
      <DecoRule />
      <p class="hero-tagline" data-de>Studenten-Wohngemeinschaften in einer Stadtvilla der 1920er Jahre</p>
      <p class="hero-tagline" data-en>Student Shared Apartments in a 1920s Berlin Villa</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="section intro-section">
    <div class="container intro-wrap">
      <div class="intro-text">
        <span class="eyebrow">Haderslebener Str. 26, 12163 Berlin</span>
        <h2 data-de>Eine Villa mit Geschichte</h2>
        <h2 data-en>A Villa with History</h2>
        <p data-de>
          Die Villa Theo ist ein wunderschöner Altbau aus den 1920er Jahren mit Anbau in Berlin Steglitz, an der Grenze zu Dahlem. Sie liegt in der Nähe der Freien Universität und der MSB und bietet vier Wohngemeinschaften für Studierende — mit insgesamt 22 Zimmern, gemeinsamen Küchen, Bädern, Wohn-Esszimmern und einem Garten. Die Miete ist all-inclusive.
        </p>
        <p data-en>
          Villa Theo is a beautiful 1920s building with annex in Berlin Steglitz, bordering Dahlem. Close to the Freie Universität and MSB, it offers four shared apartments for students — 22 rooms in total, with shared kitchens, bathrooms, living-dining rooms, and a garden. Rent is all-inclusive.
        </p>
      </div>
    </div>
  </section>

  <!-- Three nav cards -->
  <section class="section cards-section">
    <div class="container">
      <DecoRule />
      <div class="cards">
        <a class="card" href={`${base}wohngemeinschaften/`}>
          <div class="card-img-wrap">
            <img src={`${base}das-haus/dashaus-wohngemeinschaften.png`} alt="" loading="lazy" style="object-position: center bottom;" />
          </div>
          <div class="card-caption">
            <span class="eyebrow" data-de>Entdecken</span>
            <span class="eyebrow" data-en>Explore</span>
            <span class="card-title" data-de>Die Wohngemeinschaften</span>
            <span class="card-title" data-en>Shared Apartments</span>
          </div>
        </a>

        <a class="card" href={`${base}lage/`}>
          <div class="card-img-wrap">
            <img src={`${base}das-haus/dashaus-lage.jpg`} alt="" loading="lazy" />
          </div>
          <div class="card-caption">
            <span class="eyebrow" data-de>Entdecken</span>
            <span class="eyebrow" data-en>Explore</span>
            <span class="card-title" data-de>Die Lage</span>
            <span class="card-title" data-en>Location</span>
          </div>
        </a>

        <a class="card" href={`${base}haus/`}>
          <div class="card-img-wrap">
            <img src={`${base}first-image.png`} alt="" loading="lazy" />
          </div>
          <div class="card-caption">
            <span class="eyebrow" data-de>Entdecken</span>
            <span class="eyebrow" data-en>Explore</span>
            <span class="card-title" data-de>Das Haus</span>
            <span class="card-title" data-en>The Villa</span>
          </div>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ───────────────────────────────────────────────────── */
.hero {
  position: relative;
  height: clamp(480px, 85vh, 900px);
  overflow: hidden;
}
.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  filter: brightness(0.62);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.9rem;
  color: var(--ink-light);
  text-align: center;
  padding-inline: 1.5rem;
}
.hero-overlay .eyebrow { color: rgba(245, 242, 236, 0.7); }
.hero-title {
  font-family: var(--font-serif);
  font-weight: 300;
  font-size: clamp(3.5rem, 9vw, 7.5rem);
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-light);
  line-height: 1;
}
.hero-tagline {
  font-family: var(--font-sans);
  font-size: clamp(0.8rem, 1.5vw, 1rem);
  letter-spacing: 0.1em;
  color: rgba(245, 242, 236, 0.85);
  max-width: none;
}

/* ── Intro ──────────────────────────────────────────────────── */
.intro-section { text-align: center; padding-top: 2.5rem; padding-bottom: 0; }
.intro-wrap {
  max-width: 680px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.intro-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.intro-text h2 { margin-top: 0.5rem; }
.intro-text p {
  max-width: 58ch;
  color: var(--muted);
  text-align: center;
}

/* ── Cards ──────────────────────────────────────────────────── */
.cards-section { padding-top: 0; }
.cards-section .container { display: flex; flex-direction: column; align-items: center; }
.cards-section .container :global(.deco-rule) { margin-block: 2rem; }
.cards {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2.5rem;
}
.card {
  min-width: 0;
  text-decoration: none;
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.card-img-wrap {
  width: 100%;
  overflow: hidden;
  aspect-ratio: 3 / 4;
}
.card-img-wrap img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}
.card:hover .card-img-wrap img { transform: scale(1.03); }
.card-caption {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}
.card-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 300;
  letter-spacing: 0.06em;
}

@media (max-width: 800px) {
  .cards { grid-template-columns: 1fr; gap: 3rem; }
  .card-img-wrap { aspect-ratio: 4 / 3; width: 100%; }
}
</style>
