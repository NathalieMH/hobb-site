---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
import RotationModal from "../components/RotationModal.astro";
import RoomModal from "../components/RoomModal.astro";
import { getCollection } from "astro:content";
import { promises as fs } from "fs";
import path from "path";
import { loadImages } from "../utils/images";

const base = import.meta.env.BASE_URL;

function entrySlug(id: string) {
  return id.replace(/\.[^.]+$/, '').toLowerCase();
}

const allRooms = await getCollection("rooms");
const allApts  = await getCollection("apartments");

const aptMap = Object.fromEntries(
  allApts.map(a => [
    a.id.replace(/\.[^.]+$/, '').toLowerCase(),
    a.data
  ])
);

async function findGrundriss(imageFolder: string | undefined): Promise<string> {
  if (!imageFolder) return '';

  const dir = path.resolve(
    process.cwd(),
    "public",
    "wohngemeinschaften",
    imageFolder
  );

  try {
    const files = await fs.readdir(dir);
    const found = files.find(f => /^grundriss\./i.test(f));
    return found ? `${base}wohngemeinschaften/${imageFolder}/${found}` : '';
  } catch {
    return '';
  }
}

const grundrissMap = Object.fromEntries(
  await Promise.all(
    allApts.map(async (a) => [
      a.id.replace(/\.[^.]+$/, '').toLowerCase(),
      await findGrundriss(a.data.image_folder)
    ])
  )
);

const roomImages = Object.fromEntries(
  await Promise.all(
    allRooms.map(async (r) => {
      const slug = entrySlug(r.id);
      const allImgs = await loadImages(base, `zimmer/${slug}`);

      const isRoomCover = (url: string) => {
        const stem = (url.split('/').pop() ?? '').replace(/\.[^.]+$/, '');
        const key = stem.includes('_')
          ? stem.split('_').slice(1).join('_')
          : stem;

        return key.toLowerCase() === 'cover';
      };

      const coverUrl = allImgs.find(isRoomCover) ?? null;
      const galleryImgs = allImgs.filter(url => !isRoomCover(url));
      const imgs = coverUrl ? [coverUrl, ...galleryImgs] : galleryImgs;

      return [slug, imgs];
    })
  )
);

const available = allRooms
  .filter(r => r.data.available)
  .sort(
    (a, b) =>
      (aptMap[a.data.apartment.toLowerCase()]?.order ?? 0) -
      (aptMap[b.data.apartment.toLowerCase()]?.order ?? 0)
  );

const taken = allRooms
  .filter(r => !r.data.available)
  .sort(
    (a, b) =>
      (aptMap[a.data.apartment.toLowerCase()]?.order ?? 0) -
      (aptMap[b.data.apartment.toLowerCase()]?.order ?? 0)
  );
---

<Layout title="Haderslebener 26 — Vermietung">

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Zimmer & Preise</span>
      <span class="eyebrow" data-en>Rooms & Prices</span>
      <h1 data-de>Vermietung</h1>
      <h1 data-en>Rental</h1>
      <DecoRule />
    </div>
  </section>

  <section class="section" style="padding-top:1.5rem">
    <div class="container avail-wrap">

      <p class="pricing-note" data-de>
        Nebenkosten (Strom, Wasser, Heizung, Internet) sind im Mietpreis inbegriffen — die Miete ist also alles inclusive.<br>
        <br>
        <span style="font-weight:500;">Unterlagen für die Bewerbung:</span><br>
        Immatrikulationsbescheinigung<br>
        Einkommensnachweis (Praktikums-/Werkstudentenvertrag oder Bürgschaft der Eltern mit Einkommensnachweisen der letzten 3 Monate)<br>
        Schuldbeitrittserklärung des Bürgen<br>
        Mietschuldenfreiheitsbescheinigung<br>
        <br>
        bei Abschluss des Mietvertrags: Personalausweis des Mieters und des Bürgen<br>
        <br>
        <span style="font-weight:500;">Außerdem wichtig:</span><br>
        Kaution: 3 Monatsmieten kalt (mit unkomplizierter Abrechnung bei Auszug)<br>
        <a href="#">Nebenkostenpauschale-Klausel</a><br>
        <button class="text-modal-link" type="button" data-open-rotation>
          Belegungs-Rotationsprinzip
        </button>
      </p>

      <p class="pricing-note" data-en>
        Utilities (electricity, water, heating, internet) are included in the rent — all-inclusive.<br>
        <br>
        <span style="font-weight:500;">Application documents:</span><br>
        University enrollment certificate<br>
        Proof of income (internship/working student contract or parental guarantor with employment contract)<br>
        <br>
        <span style="font-weight:500;">Additional information:</span><br>
        Security deposit (with a straightforward refund process)<br>
        <a href="#">Utility flat-rate clause</a><br>
        <button class="text-modal-link" type="button" data-open-rotation>
          Occupancy rotation principle
        </button>
      </p>

      {available.length > 0 && (
        <div class="avail-group">
          <h2 class="group-heading" data-de>Verfügbare Zimmer</h2>
          <h2 class="group-heading" data-en>Available Rooms</h2>

          <div class="room-list">
            <div class="room-row row-header">
              <div class="room-row-main">
                <span class="col-room"></span>
                <span class="col-num"><span data-de>Größe</span><span data-en>Size</span></span>
                <span class="col-num"><span data-de>Kalt</span><span data-en>Rent</span></span>
                <span class="col-num">NK</span>
                <span class="col-num"><span data-de>Gesamt/M</span><span data-en>Total/M</span></span>
                <span class="col-fp"><span data-de>Grundriss</span><span data-en>Floorplan</span></span>
                <span class="col-from"><span data-de>Verfügbar ab</span><span data-en>Available from</span></span>
              </div>
            </div>

            {available.map(r => {
              const slug = entrySlug(r.id);
              const aptKey = r.data.apartment.toLowerCase();
              const apt = aptMap[aptKey];
              const grundriss = grundrissMap[aptKey] ?? '';
              const hasFloorplan = !!grundriss;

              const fotos = roomImages[slug] ?? [];
              const photoCover = fotos[0] ?? '';
              const hasPhotos = fotos.length > 0;

              return (
                <div class="room-row">
                  <div class="room-row-main">
                    <div class="room-meta">
                      <a class="room-name" href={`${base}wohngemeinschaften/${aptKey}/`}>
                        <span data-de>{r.data.title_de}</span>
                        <span data-en>{r.data.title_en}</span>
                      </a>

                      <div class="room-teaser-wrap">
                        {r.data.teaser_de && <p class="room-teaser" data-de>{r.data.teaser_de}</p>}
                        {r.data.teaser_en && <p class="room-teaser" data-en>{r.data.teaser_en}</p>}
                        {!r.data.teaser_de && !r.data.teaser_en && (
                          <span class="room-teaser room-teaser-empty" aria-hidden="true"></span>
                        )}
                      </div>
                    </div>

                    <span class="col-num room-num">
                      <span>{r.data.size_m2 != null ? `${r.data.size_m2} m²` : '—'}</span>
                    </span>
                    <span class="col-num room-num">
                      <span>{r.data.kaltmiete_eur != null ? `${r.data.kaltmiete_eur} €` : '—'}</span>
                    </span>
                    <span class="col-num room-num">
                      <span>{r.data.nebenkosten_eur != null ? `${r.data.nebenkosten_eur} €` : '—'}</span>
                    </span>
                    <span class="col-num room-num room-total">
                      <span>{r.data.gesamtmiete_eur != null ? `${r.data.gesamtmiete_eur} €` : '—'}</span>
                    </span>

                    <div class="room-action-line">
                      <div class="room-actions">
                        <button
                          type="button"
                          class={`floorplan-btn${hasFloorplan ? '' : ' fp-placeholder'}`}
                          data-iz-open
                          data-iz-src={grundriss}
                          data-iz-title-de={apt?.title_de ?? ''}
                          data-iz-title-en={apt?.title_en ?? ''}
                          aria-label="Grundriss ansehen"
                        >
                          <span class="fp-icon" aria-hidden="true">
                            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <rect x="1.5" y="1.5" width="15" height="15" stroke="currentColor" stroke-width="1.2"/>
                              <rect x="1.5" y="1.5" width="9" height="8" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                              <rect x="10.5" y="1.5" width="6" height="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                              <rect x="1.5" y="9.5" width="6" height="7" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            </svg>
                          </span>
                          <span class="fp-label" data-de>Grundriss</span>
                          <span class="fp-label" data-en>Floorplan</span>
                        </button>

                        <button
                          type="button"
                          class={`floorplan-btn photos-btn${hasPhotos ? '' : ' fp-placeholder'}`}
                          data-room-modal-open={slug}
                          aria-label="Fotos ansehen"
                        >
                          <span class="fp-icon" aria-hidden="true">
                            <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M6.2 4.2L7.3 2.8H10.7L11.8 4.2H14.5C15.1 4.2 15.6 4.7 15.6 5.3V14.1C15.6 14.7 15.1 15.2 14.5 15.2H3.5C2.9 15.2 2.4 14.7 2.4 14.1V5.3C2.4 4.7 2.9 4.2 3.5 4.2H6.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                              <circle cx="9" cy="9.8" r="3" stroke="currentColor" stroke-width="1.1"/>
                              <circle cx="13.1" cy="6.6" r="0.45" fill="currentColor"/>
                            </svg>
                          </span>
                          <span class="fp-label" data-de>Fotos</span>
                          <span class="fp-label" data-en>Photos</span>
                        </button>
                      </div>

                      <span class="col-from room-from room-from-available">
                        <span class="room-from-desktop">{r.data.available_from ?? '—'}</span>
                        <span class="room-from-mobile" data-de>Verfügbar ab {r.data.available_from?.replace(/\.\d{4}$/, '') ?? '—'}</span>
                        <span class="room-from-mobile" data-en>Available from {r.data.available_from?.replace(/\.\d{4}$/, '') ?? '—'}</span>
                      </span>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {taken.length > 0 && (
        <div class="avail-group taken-group">
          <DecoRule />
          <h2 class="group-heading taken-heading" data-de>Vergeben</h2>
          <h2 class="group-heading taken-heading" data-en>Currently Taken</h2>

          <div class="room-list taken-list">
            {taken.map(r => {
              const slug = entrySlug(r.id);
              const aptKey = r.data.apartment.toLowerCase();
              const apt = aptMap[aptKey];
              const grundriss = grundrissMap[aptKey] ?? '';
              const hasFloorplan = !!grundriss;

              const fotos = roomImages[slug] ?? [];
              const photoCover = fotos[0] ?? '';
              const hasPhotos = fotos.length > 0;

              return (
                <div class="room-row room-row-taken">
                  <div class="room-row-main">
                    <div class="room-meta">
                      <a class="room-name taken-name" href={`${base}wohngemeinschaften/${aptKey}/`}>
                        <span data-de>{r.data.title_de}</span>
                        <span data-en>{r.data.title_en}</span>
                      </a>

                      <div class="room-teaser-wrap">
                        <span class="room-teaser room-teaser-empty" aria-hidden="true"></span>
                      </div>
                    </div>

                    <span class="col-num room-num">
                      <span>{r.data.size_m2 != null ? `${r.data.size_m2} m²` : '—'}</span>
                    </span>
                    <span class="col-num room-num">
                      <span>{r.data.kaltmiete_eur != null ? `${r.data.kaltmiete_eur} €` : '—'}</span>
                    </span>
                    <span class="col-num room-num">
                      <span>{r.data.nebenkosten_eur != null ? `${r.data.nebenkosten_eur} €` : '—'}</span>
                    </span>
                    <span class="col-num room-num room-total">
                      <span>{r.data.gesamtmiete_eur != null ? `${r.data.gesamtmiete_eur} €` : '—'}</span>
                    </span>

                    <div class="room-actions">
                      <button
                        type="button"
                        class={`floorplan-btn${hasFloorplan ? '' : ' fp-placeholder'}`}
                        data-iz-open
                        data-iz-src={grundriss}
                        data-iz-title-de={apt?.title_de ?? ''}
                        data-iz-title-en={apt?.title_en ?? ''}
                        aria-label="Grundriss ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="1.5" y="1.5" width="15" height="15" stroke="currentColor" stroke-width="1.2"/>
                            <rect x="1.5" y="1.5" width="9" height="8" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="10.5" y="1.5" width="6" height="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="1.5" y="9.5" width="6" height="7" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Grundriss</span>
                        <span class="fp-label" data-en>Floorplan</span>
                      </button>

                      <button
                        type="button"
                        class={`floorplan-btn photos-btn${hasPhotos ? '' : ' fp-placeholder'}`}
                        data-room-modal-open={slug}
                        aria-label="Fotos ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.2 4.2L7.3 2.8H10.7L11.8 4.2H14.5C15.1 4.2 15.6 4.7 15.6 5.3V14.1C15.6 14.7 15.1 15.2 14.5 15.2H3.5C2.9 15.2 2.4 14.7 2.4 14.1V5.3C2.4 4.7 2.9 4.2 3.5 4.2H6.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                            <circle cx="9" cy="9.8" r="3" stroke="currentColor" stroke-width="1.1"/>
                            <circle cx="13.1" cy="6.6" r="0.45" fill="currentColor"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Fotos</span>
                        <span class="fp-label" data-en>Photos</span>
                      </button>
                    </div>

                    <span class="col-from room-from">—</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </section>

  <RotationModal />
  <RoomModal rooms={allRooms.map(r => ({
    entry: r,
    imgs: roomImages[entrySlug(r.id)] ?? [],
    sharedM2: aptMap[r.data.apartment.toLowerCase()]?.shared_m2,
  }))} />

</Layout>

<style>
.avail-wrap {
  max-width: 1100px;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.pricing-note {
  font-size: 0.85rem;
  color: var(--muted);
  max-width: none;
  padding: 0.9rem 1.25rem;
  border-left: 2px solid var(--gold);
  background: rgba(184, 149, 42, 0.04);
}

.pricing-note a,
.text-modal-link {
  color: var(--gold);
  text-decoration: none;
}

.pricing-note a:hover,
.text-modal-link:hover {
  color: var(--ink);
}

.text-modal-link {
  appearance: none;
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  cursor: pointer;
  text-align: left;
}

.avail-group {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.taken-group {
  gap: 1.25rem;
}

.group-heading {
  font-size: clamp(0.85rem, 1.2vw, 1rem);
  font-family: var(--font-sans);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.taken-heading {
  color: var(--border);
}

.room-list {
  display: flex;
  flex-direction: column;
}

.room-row {
  --action-row-height: 1.75rem;
  --action-row-gap: 0.35rem;

  border-top: 1px solid var(--border);
  padding-block: 0.9rem;
}

.room-list .room-row:last-child {
  border-bottom: 1px solid var(--border);
}

.room-row-main {
  display: grid;
  grid-template-columns: 2fr 3.5rem 5.5rem 4rem 6rem 7.5rem 5.5rem;
  align-items: stretch;
  gap: 1rem;
}

.row-header {
  border-top: none;
  padding-block: 0 0.5rem;
}

.row-header .room-row-main {
  align-items: center;
}

.row-header span {
  font-family: var(--font-sans);
  font-size: 0.6rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--muted);
  white-space: nowrap;
}

.col-num {
  text-align: center;
}

.col-fp {
  text-align: center;
}

.col-from {
  text-align: center;
}

.room-meta {
  display: grid;
  grid-template-rows: var(--action-row-height) var(--action-row-height);
  row-gap: var(--action-row-gap);
  align-content: start;
}

.room-name {
  font-family: var(--font-serif);
  font-size: 1.05rem;
  font-weight: 300;
  letter-spacing: 0.03em;
  color: var(--ink);
  text-decoration: none;
  transition: color var(--ease);
  display: flex;
  align-items: center;
  min-height: var(--action-row-height);
}

.room-name:hover {
  color: var(--gold);
}

.taken-name {
  color: var(--muted);
}

.taken-name:hover {
  color: var(--muted);
}

.room-teaser-wrap {
  display: flex;
  align-items: center;
  min-height: var(--action-row-height);
}

.room-teaser {
  margin: 0;
  font-size: 0.82rem;
  color: var(--muted);
  font-style: italic;
  max-width: 56ch;
  white-space: pre-line;
}

.room-teaser-empty {
  visibility: hidden;
}

.room-num {
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--muted);
  text-align: center;
  letter-spacing: 0.03em;

  min-height: calc(var(--action-row-height) * 2 + var(--action-row-gap));
  display: flex;
  align-items: center;
  justify-content: center;
}

.room-total {
  font-weight: 400;
}

.room-from {
  font-family: var(--font-sans);
  font-size: 0.78rem;
  font-weight: 400;
  color: var(--muted);
  text-align: center;
  letter-spacing: 0.03em;

  min-height: calc(var(--action-row-height) * 2 + var(--action-row-gap));
  display: flex;
  align-items: center;
  justify-content: center;
}

.room-from-mobile {
  display: none;
}

.room-action-line {
  display: contents;
}

.room-actions {
  display: grid;
  grid-template-rows: var(--action-row-height) var(--action-row-height);
  row-gap: var(--action-row-gap);
  justify-self: center;
  align-content: start;
}

.floorplan-btn {
  background: none;
  border: 1px solid var(--border);
  padding: 0.3rem 0.6rem;
  height: var(--action-row-height);
  width: 7.5rem;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;

  color: var(--muted);
  font-family: var(--font-sans);
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: border-color var(--ease), color var(--ease);
  white-space: nowrap;
}

.floorplan-btn:hover:not(.fp-placeholder) {
  border-color: var(--gold);
  color: var(--ink);
}

.fp-placeholder {
  opacity: 0.4;
  cursor: default;
}

.fp-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  display: flex;
}

.fp-icon svg {
  width: 100%;
  height: 100%;
}

.room-row-taken .room-num,
.room-row-taken .room-from {
  color: var(--muted);
  opacity: 0.5;
}

.taken-list .room-row {
  opacity: 0.6;
}


@media (max-width: 780px) {
  .room-row-main {
    grid-template-columns: 2fr 3.5rem 5rem 3.5rem 5.5rem 7.5rem;
  }

  .col-from,
  .room-from {
    display: none;
  }
}

@media (max-width: 620px) {
  .room-row-main {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 0.5rem;
    row-gap: 0.5rem;
  }

  .row-header {
    display: block;
    padding-block: 0 0.15rem;
  }

  .row-header .room-row-main {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 0.5rem;
  }

  .row-header .col-room,
  .row-header .col-fp,
  .row-header .col-from {
    display: none;
  }

  .room-meta {
    grid-column: 1 / -1;
    grid-template-rows: auto auto;
    row-gap: 0.2rem;
  }

  .room-name,
  .room-teaser-wrap {
    min-height: auto;
  }

  .room-num {
    min-height: auto;
    font-size: 0.78rem;
  }

  .room-action-line {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: start;
    min-width: 0;
    margin-top: 0.15rem;
  }

  .room-actions {
    grid-template-rows: none;
    grid-template-columns: auto auto;
    gap: 0.35rem;
    flex: 0 0 auto;
  }

  .room-from-available {
    display: flex;
    min-height: auto;
    justify-content: flex-start;
    align-self: center;
    min-width: 0;
    text-align: left;
  }

  .room-from-desktop {
    display: none;
  }

  .room-from-mobile {
    display: inline;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .floorplan-btn {
    width: 2.75rem;
    min-width: 2.75rem;
    padding-inline: 0.45rem;
  }

  .fp-label {
    display: none;
  }
}
</style>

<script>
  function lockBodyScroll() {
    document.documentElement.style.overflow = 'hidden';
  }

  function unlockBodyScroll() {
    document.documentElement.style.overflow = '';
  }

  function openRotationModal() {
    const overlay = document.getElementById("rotation-overlay");
    if (!overlay) return;

    const lang = document.documentElement.getAttribute("data-lang") ?? "de";
    overlay.querySelector<HTMLElement>("[role=dialog]")?.setAttribute("aria-labelledby", `rotation-title-${lang}`);
    overlay.classList.remove("hidden");
    overlay.setAttribute("aria-hidden", "false");
    lockBodyScroll();
  }

  function closeRotationModal() {
    const overlay = document.getElementById("rotation-overlay");
    if (!overlay) return;

    overlay.classList.add("hidden");
    overlay.setAttribute("aria-hidden", "true");
    unlockBodyScroll();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element;

    if (target.closest("[data-open-rotation]")) {
      event.preventDefault();
      openRotationModal();
      return;
    }

    const overlay = document.getElementById("rotation-overlay");

    if (
      target.closest(".text-modal-close") ||
      target === overlay
    ) {
      event.preventDefault();
      closeRotationModal();
    }
  });

  const rotationOverlay = document.getElementById("rotation-overlay");
  rotationOverlay?.addEventListener("wheel", (event) => {
    if (rotationOverlay.classList.contains("hidden")) return;
    event.stopPropagation();
  }, { passive: true });

  rotationOverlay?.addEventListener("touchmove", (event) => {
    if (rotationOverlay.classList.contains("hidden")) return;
    event.stopPropagation();
  }, { passive: true });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeRotationModal();
    }
  });
</script>
