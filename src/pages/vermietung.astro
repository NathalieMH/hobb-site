---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
import { getCollection } from "astro:content";
import { promises as fs } from "fs";
import path from "path";

const base = import.meta.env.BASE_URL;

function entrySlug(id: string) {
  return id.replace(/\.[^.]+$/, '').toLowerCase();
}

async function loadImages(folder: string) {
  const dir = path.resolve(process.cwd(), "public", folder);

  try {
    const files = await fs.readdir(dir);

    const sortKey = (f: string) => {
      const stem = f.replace(/\.[^.]+$/, '');
      const us = stem.indexOf('_');
      return us >= 0 ? stem.slice(us + 1) : stem;
    };

    return files
      .filter((f) => /\.(jpe?g|png|webp|gif)$/i.test(f))
      .sort((a, b) => {
        const ka = sortKey(a).toLowerCase();
        const kb = sortKey(b).toLowerCase();

        if (ka === 'cover') return -1;
        if (kb === 'cover') return 1;

        return ka.localeCompare(kb, undefined, {
          numeric: true,
          sensitivity: 'base'
        });
      })
      .map((f) => `${base}${folder}/${f}`);
  } catch {
    return [];
  }
}

const allRooms = await getCollection("rooms");
const allApts  = await getCollection("apartments");

const aptMap = Object.fromEntries(
  allApts.map(a => [
    a.id.replace(/\.[^.]+$/, '').toLowerCase(),
    a.data
  ])
);

async function findGrundriss(imageFolder: string | undefined): Promise<string> {
  if (!imageFolder) return '';

  const dir = path.resolve(
    process.cwd(),
    "public",
    "wohngemeinschaften",
    imageFolder
  );

  try {
    const files = await fs.readdir(dir);
    const found = files.find(f => /^grundriss\./i.test(f));
    return found ? `${base}wohngemeinschaften/${imageFolder}/${found}` : '';
  } catch {
    return '';
  }
}

const grundrissMap = Object.fromEntries(
  await Promise.all(
    allApts.map(async (a) => [
      a.id.replace(/\.[^.]+$/, '').toLowerCase(),
      await findGrundriss(a.data.image_folder)
    ])
  )
);

const roomImages = Object.fromEntries(
  await Promise.all(
    allRooms.map(async (r) => {
      const slug = entrySlug(r.id);
      const allImgs = await loadImages(`zimmer/${slug}`);

      const isRoomCover = (url: string) => {
        const stem = (url.split('/').pop() ?? '').replace(/\.[^.]+$/, '');
        const key = stem.includes('_')
          ? stem.split('_').slice(1).join('_')
          : stem;

        return key.toLowerCase() === 'cover';
      };

      const coverUrl = allImgs.find(isRoomCover) ?? null;
      const galleryImgs = allImgs.filter(url => !isRoomCover(url));
      const imgs = coverUrl ? [coverUrl, ...galleryImgs] : galleryImgs;

      return [slug, imgs];
    })
  )
);

const available = allRooms
  .filter(r => r.data.available)
  .sort(
    (a, b) =>
      (aptMap[a.data.apartment.toLowerCase()]?.order ?? 0) -
      (aptMap[b.data.apartment.toLowerCase()]?.order ?? 0)
  );

const taken = allRooms
  .filter(r => !r.data.available)
  .sort(
    (a, b) =>
      (aptMap[a.data.apartment.toLowerCase()]?.order ?? 0) -
      (aptMap[b.data.apartment.toLowerCase()]?.order ?? 0)
  );
---

<Layout title="Haderslebener 26 — Vermietung">

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Zimmer & Preise</span>
      <span class="eyebrow" data-en>Rooms & Prices</span>
      <h1 data-de>Vermietung</h1>
      <h1 data-en>Rental</h1>
      <DecoRule />
    </div>
  </section>

  <section class="section" style="padding-top:1.5rem">
    <div class="container avail-wrap">

      <p class="pricing-note" data-de>
        Nebenkosten (Strom, Wasser, Heizung, Internet) sind im Mietpreis inbegriffen — die Miete ist also all-inclusive.<br>
        <br>
        <span style="font-weight:500;">Unterlagen für die Bewerbung:</span><br>
        Immatrikulationsbescheinigung<br>
        Einkommensnachweis (Praktikums-/Werkstudentenvertrag oder Bürgschaft der Eltern mit Arbeitsvertrag)<br>
        <br>
        <span style="font-weight:500;">Noch wichtig:</span><br>
        Kaution (mit unkomplizierter Rückzahlung)<br>
        <a href="#">Nebenkostenpauschale-Klausel</a><br>
        <button class="text-modal-link" type="button" data-open-rotation>
          Belegungs-Rotationsprinzip
        </button>
      </p>

      <p class="pricing-note" data-en>
        Utilities (electricity, water, heating, internet) are included in the rent — all-inclusive.<br>
        <br>
        <span style="font-weight:500;">Application documents:</span><br>
        University enrollment certificate<br>
        Proof of income (internship/working student contract or parental guarantor with employment contract)<br>
        <br>
        <span style="font-weight:500;">Additional information:</span><br>
        Security deposit (with a straightforward refund process)<br>
        <a href="#">Utility flat-rate clause</a><br>
        <button class="text-modal-link" type="button" data-open-rotation>
          Occupancy rotation principle
        </button>
      </p>

      {available.length > 0 && (
        <div class="avail-group">
          <h2 class="group-heading" data-de>Verfügbare Zimmer</h2>
          <h2 class="group-heading" data-en>Available Rooms</h2>

          <div class="room-list">
            <div class="room-row row-header">
              <div class="room-row-main">
                <span class="col-room"></span>
                <span class="col-num">Größe</span>
                <span class="col-num">Kalt</span>
                <span class="col-num">NK</span>
                <span class="col-num">Gesamt/Mo.</span>
                <span class="col-fp">Grundriss</span>
                <span class="col-from">Verfügbar ab</span>
              </div>
            </div>

            {available.map(r => {
              const slug = entrySlug(r.id);
              const aptKey = r.data.apartment.toLowerCase();
              const apt = aptMap[aptKey];
              const grundriss = grundrissMap[aptKey] ?? '';
              const hasFloorplan = !!grundriss;

              const fotos = roomImages[slug] ?? [];
              const photoCover = fotos[0] ?? '';
              const hasPhotos = fotos.length > 0;

              return (
                <div class="room-row">
                  <div class="room-row-main">
                    <div class="room-meta">
                      <a class="room-name" href={`${base}wohngemeinschaften/${aptKey}/`}>
                        <span data-de>{r.data.title_de}</span>
                        <span data-en>{r.data.title_en}</span>
                      </a>

                      <div class="room-teaser-wrap">
                        {r.data.teaser_de && <p class="room-teaser" data-de>{r.data.teaser_de}</p>}
                        {r.data.teaser_en && <p class="room-teaser" data-en>{r.data.teaser_en}</p>}
                        {!r.data.teaser_de && !r.data.teaser_en && (
                          <span class="room-teaser room-teaser-empty" aria-hidden="true"></span>
                        )}
                      </div>
                    </div>

                    <span class="col-num room-num">{r.data.size_m2 != null ? `${r.data.size_m2} m²` : '—'}</span>
                    <span class="col-num room-num">{r.data.kaltmiete_eur != null ? `${r.data.kaltmiete_eur} €` : '—'}</span>
                    <span class="col-num room-num">{r.data.nebenkosten_eur != null ? `${r.data.nebenkosten_eur} €` : '—'}</span>
                    <span class="col-num room-num room-total">{r.data.gesamtmiete_eur != null ? `${r.data.gesamtmiete_eur} €` : '—'}</span>

                    <div class="room-actions">
                      <button
                        class={`floorplan-btn${hasFloorplan ? '' : ' fp-placeholder'}`}
                        data-iz-open
                        data-iz-src={grundriss}
                        data-iz-title-de={apt?.title_de ?? ''}
                        data-iz-title-en={apt?.title_en ?? ''}
                        aria-label="Grundriss ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="1.5" y="1.5" width="15" height="15" stroke="currentColor" stroke-width="1.2"/>
                            <rect x="1.5" y="1.5" width="9" height="8" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="10.5" y="1.5" width="6" height="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="1.5" y="9.5" width="6" height="7" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Grundriss</span>
                        <span class="fp-label" data-en>Floorplan</span>
                      </button>

                      <button
                        class={`floorplan-btn photos-btn${hasPhotos ? '' : ' fp-placeholder'}`}
                        data-photos-open
                        data-photo-src={photoCover}
                        data-photo-images={JSON.stringify(fotos)}
                        data-photo-title-de={r.data.title_de ?? apt?.title_de ?? ''}
                        data-photo-title-en={r.data.title_en ?? apt?.title_en ?? ''}
                        aria-label="Fotos ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.2 4.2L7.3 2.8H10.7L11.8 4.2H14.5C15.1 4.2 15.6 4.7 15.6 5.3V14.1C15.6 14.7 15.1 15.2 14.5 15.2H3.5C2.9 15.2 2.4 14.7 2.4 14.1V5.3C2.4 4.7 2.9 4.2 3.5 4.2H6.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                            <circle cx="9" cy="9.8" r="3" stroke="currentColor" stroke-width="1.1"/>
                            <circle cx="13.1" cy="6.6" r="0.45" fill="currentColor"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Fotos</span>
                        <span class="fp-label" data-en>Photos</span>
                      </button>
                    </div>

                    <span class="col-from room-from">{r.data.available_from ?? '—'}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {taken.length > 0 && (
        <div class="avail-group taken-group">
          <DecoRule />
          <h2 class="group-heading taken-heading" data-de>Vergeben</h2>
          <h2 class="group-heading taken-heading" data-en>Currently Taken</h2>

          <div class="room-list taken-list">
            {taken.map(r => {
              const slug = entrySlug(r.id);
              const aptKey = r.data.apartment.toLowerCase();
              const apt = aptMap[aptKey];
              const grundriss = grundrissMap[aptKey] ?? '';
              const hasFloorplan = !!grundriss;

              const fotos = roomImages[slug] ?? [];
              const photoCover = fotos[0] ?? '';
              const hasPhotos = fotos.length > 0;

              return (
                <div class="room-row room-row-taken">
                  <div class="room-row-main">
                    <div class="room-meta">
                      <a class="room-name taken-name" href={`${base}wohngemeinschaften/${aptKey}/`}>
                        <span data-de>{r.data.title_de}</span>
                        <span data-en>{r.data.title_en}</span>
                      </a>

                      <div class="room-teaser-wrap">
                        <span class="room-teaser room-teaser-empty" aria-hidden="true"></span>
                      </div>
                    </div>

                    <span class="col-num room-num">{r.data.size_m2 != null ? `${r.data.size_m2} m²` : '—'}</span>
                    <span class="col-num room-num">{r.data.kaltmiete_eur != null ? `${r.data.kaltmiete_eur} €` : '—'}</span>
                    <span class="col-num room-num">{r.data.nebenkosten_eur != null ? `${r.data.nebenkosten_eur} €` : '—'}</span>
                    <span class="col-num room-num room-total">{r.data.gesamtmiete_eur != null ? `${r.data.gesamtmiete_eur} €` : '—'}</span>

                    <div class="room-actions">
                      <button
                        class={`floorplan-btn${hasFloorplan ? '' : ' fp-placeholder'}`}
                        data-iz-open
                        data-iz-src={grundriss}
                        data-iz-title-de={apt?.title_de ?? ''}
                        data-iz-title-en={apt?.title_en ?? ''}
                        aria-label="Grundriss ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="1.5" y="1.5" width="15" height="15" stroke="currentColor" stroke-width="1.2"/>
                            <rect x="1.5" y="1.5" width="9" height="8" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="10.5" y="1.5" width="6" height="5" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                            <rect x="1.5" y="9.5" width="6" height="7" stroke="currentColor" stroke-width="0.8" stroke-opacity="0.6"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Grundriss</span>
                        <span class="fp-label" data-en>Floorplan</span>
                      </button>

                      <button
                        class={`floorplan-btn photos-btn${hasPhotos ? '' : ' fp-placeholder'}`}
                        data-photos-open
                        data-photo-src={photoCover}
                        data-photo-images={JSON.stringify(fotos)}
                        data-photo-title-de={r.data.title_de ?? apt?.title_de ?? ''}
                        data-photo-title-en={r.data.title_en ?? apt?.title_en ?? ''}
                        aria-label="Fotos ansehen"
                      >
                        <span class="fp-icon" aria-hidden="true">
                          <svg viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.2 4.2L7.3 2.8H10.7L11.8 4.2H14.5C15.1 4.2 15.6 4.7 15.6 5.3V14.1C15.6 14.7 15.1 15.2 14.5 15.2H3.5C2.9 15.2 2.4 14.7 2.4 14.1V5.3C2.4 4.7 2.9 4.2 3.5 4.2H6.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                            <circle cx="9" cy="9.8" r="3" stroke="currentColor" stroke-width="1.1"/>
                            <circle cx="13.1" cy="6.6" r="0.45" fill="currentColor"/>
                          </svg>
                        </span>
                        <span class="fp-label" data-de>Fotos</span>
                        <span class="fp-label" data-en>Photos</span>
                      </button>
                    </div>

                    <span class="col-from room-from">—</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </section>

  <div id="rotation-overlay" class="text-overlay hidden" aria-hidden="true">
    <div class="text-modal-card" role="dialog" aria-modal="true" aria-labelledby="rotation-title">
      <button class="text-modal-close" type="button" aria-label="Schließen">×</button>

      <article class="rotation-document">
        <header class="rotation-header">
          <span class="rotation-eyebrow">Belegungs-Rotationsprinzip</span>
          <h2 id="rotation-title">Rotations- und Belegungskonzept</h2>
          <p>Haderslebener Straße 26 · 12163 Berlin-Steglitz-Zehlendorf</p>
        </header>

        <section>
          <h3>§ 1 Grundlagen und Zielsetzung</h3>
          <p>(1) Die GSMB GmbH (im Folgenden „Trägerin") hat das Anwesen Haderslebener Straße 26 / 26a, 12163 Berlin, als Generalmieterin angemietet. Das vorliegende Konzept gilt für die Wohneinheiten 01, 03, 04 und 05/06 in dem Objekt. In den einzelnen Wohneinheiten, die jeweils in sich abgeschlossen sind, betreibt die Trägerin jeweils ein eigenständiges Studentenwohnheim.</p>
          <p>(2) Leitgedanke dieses Konzepts ist es, möglichst vielen Studierenden während ihrer Ausbildungszeit den Zugang zu bezahlbarem Wohnraum zu ermöglichen. Die Trägerin versteht sich dabei als Teil eines funktionierenden Hochschulumfelds und möchte einen Beitrag zur sozialen und kulturellen Förderung der Studierendenschaft leisten.</p>
          <p>(3) Um einen geregelten Wechsel der Bewohnerschaft sicherzustellen, hat sich die Trägerin das vorliegende Rotations- und Belegungskonzept gegeben. Die hierin festgelegten Grundsätze werden einheitlich und nachvollziehbar angewandt.</p>
          <p>(4) Insbesondere wird durch die nachfolgenden Regelungen gewährleistet, dass die Dauer einzelner Mietverhältnisse weder vom Zufall noch vom Ermessen der Trägerin abhängt, sondern nach transparenten, für alle Bewerberinnen und Bewerber gleichermaßen geltenden Maßstäben bestimmt wird.</p>
        </section>

        <section>
          <h3>§ 2 Berechtigter Personenkreis</h3>
          <p>(1) Einen Wohnplatz können ausschließlich Personen erhalten, die einer der folgenden Gruppen angehören:</p>
          <ul>
            <li>eingeschriebene Studierende an einer staatlich anerkannten Hochschule,</li>
            <li>Teilnehmerinnen und Teilnehmer an studienbegleitenden Praktika.</li>
          </ul>
          <p>(2) Die Zugehörigkeit zum berechtigten Personenkreis ist vor Abschluss eines Mietvertrages durch Vorlage geeigneter Originaldokumente zu belegen:</p>
          <ul>
            <li>Studierende legen eine gültige Immatrikulationsbescheinigung vor,</li>
            <li>Praktikantinnen und Praktikanten weisen ihr Praktikum durch eine Bescheinigung der Hochschule und des Unternehmens nach.</li>
          </ul>
          <p>(3) Studierende sind darüber hinaus verpflichtet, zu Beginn jedes Semesters unaufgefordert eine aktuelle Immatrikulationsbescheinigung einzureichen. Diese Pflicht wird Bestandteil des Mietvertrages.</p>
          <p>(4) Entfällt die Zugehörigkeit zum berechtigten Personenkreis – etwa durch Exmatrikulation, Studienabbruch oder Beendigung des Praktikums –, endet das Mietverhältnis spätestens zum Ablauf des laufenden Semesters. Die Bewohnerin oder der Bewohner ist verpflichtet, den Wegfall der Berechtigung unverzüglich schriftlich mitzuteilen.</p>
        </section>

        <section>
          <h3>§ 3 Vergabeverfahren</h3>
          <p>(1) Freie Wohnplätze werden nach dem Grundsatz der Gleichbehandlung vergeben. Gehen für einen Platz mehrere Bewerbungen ein, so ist der Zeitpunkt des Bewerbungseingangs maßgeblich (Prinzip der Warteliste).</p>
          <p>(2) Von der chronologischen Reihenfolge der Warteliste darf nur abgewichen werden, wenn dies zur Wahrung einer ausgewogenen Belegung der jeweiligen Wohngemeinschaft erforderlich ist. Sachliche Gründe für eine Abweichung sind insbesondere:</p>
          <ul>
            <li>die Berücksichtigung besonderer Härtegründe gemäß Absatz 3,</li>
            <li>die Bevorzugung internationaler Studierender gemäß § 4.</li>
          </ul>
          <p>Die Abweichung ist in der Warteliste unter Angabe des Grundes zu dokumentieren.</p>
          <p>(3) Eine vorrangige Berücksichtigung außerhalb der regulären Warteliste ist bei Vorliegen besonderer Härtegründe möglich. Als solche gelten insbesondere:</p>
          <ul>
            <li>eine große räumliche Distanz zwischen Herkunftsort und Studienort,</li>
            <li>nachweislich erschwerte persönliche, soziale oder finanzielle Lebensumstände.</li>
          </ul>
        </section>

        <section>
          <h3>§ 4 Internationale Studierende</h3>
          <p>(1) Bewerberinnen und Bewerber aus dem Ausland, die aufgrund eines zeitlich begrenzten Studienaufenthalts (bis zu 12 Monate) oder sprachlicher Hürden bzw. fehlender Erfahrung mit dem deutschen Wohnungsmarkt in besonderem Maße auf Unterstützung bei der Wohnungssuche angewiesen sind, können bei fristgerechter Bewerbung bevorzugt berücksichtigt werden.</p>
          <p>(2) Sämtliche Bewerberinnen und Bewerber werden vor dem Einzug gebeten, ihre Angaben zum Studien- oder Praktikantenverhältnis durch aktuelle Unterlagen vollständig zu belegen.</p>
        </section>

        <section>
          <h3>§ 5 Wohndauer</h3>
          <p>(1) Die Wohndauer ist grundsätzlich auf acht Semester (vier Jahre) begrenzt. Nach Ablauf dieser Frist endet das Mietverhältnis, sofern keine Verlängerung gemäß § 6 gewährt wird.</p>
          <p>(2) Diese Begrenzung trägt dem Rotationsgedanken Rechnung: Durch den regelmäßigen Wechsel der Bewohnerschaft wird gewährleistet, dass nachfolgende Studierendengenerationen ebenfalls Zugang zu den Wohnplätzen erhalten.</p>
          <p>(3) Die Mietverträge werden als Zeitmietverträge geschlossen. Die Befristung ergibt sich aus dem Zweck des Wohnheimplatzes gemäß § 549 Abs. 3 BGB in Verbindung mit dem vorliegenden Konzept.</p>
        </section>

        <section>
          <h3>§ 6 Ausnahmsweise Verlängerung</h3>
          <p>(1) In begründeten Ausnahmefällen kann die Wohndauer um höchstens zwei weitere Semester verlängert werden. Dies kommt in Betracht, wenn:</p>
          <ul>
            <li>sich die Bewohnerin oder der Bewohner in der Abschlussphase des Studiums befindet und die Examensvorbereitung oder -anmeldung nachweisen kann, oder</li>
            <li>ein erster Prüfungsversuch nicht bestanden wurde und der Wiederholungstermin binnen sechs Monaten ansteht.</li>
          </ul>
          <p>(2) Unabhängig von den vorstehenden Regelungen gilt eine absolute Obergrenze von zwölf Semestern (sechs Jahren). Mit Erreichen dieser Grenze endet das Mietverhältnis in jedem Fall; eine darüber hinausgehende Verlängerung ist ausgeschlossen.</p>
        </section>

        <section>
          <h3>§ 7 Inkrafttreten und Änderungen</h3>
          <p>(1) Das vorliegende Konzept gilt ab dem Zeitpunkt der erstmaligen Vermietung eines Wohnplatzes in der betreffenden Wohneinheit.</p>
          <p>(2) Änderungen oder Ergänzungen dieses Konzepts sind nur in schriftlicher Form wirksam.</p>
          <p>(3) Die Unwirksamkeit einer einzelnen Bestimmung lässt die Gültigkeit der übrigen Regelungen unberührt.</p>
        </section>
      </article>
    </div>
  </div>

</Layout>

<style>
.avail-wrap {
  max-width: 1100px;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.pricing-note {
  font-size: 0.85rem;
  color: var(--muted);
  max-width: none;
  padding: 0.9rem 1.25rem;
  border-left: 2px solid var(--gold);
  background: rgba(184, 149, 42, 0.04);
}

.pricing-note a,
.text-modal-link {
  color: var(--gold);
  text-decoration: none;
}

.pricing-note a:hover,
.text-modal-link:hover {
  color: var(--ink);
}

.text-modal-link {
  appearance: none;
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  cursor: pointer;
  text-align: left;
}

.avail-group {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.taken-group {
  gap: 1.25rem;
}

.group-heading {
  font-size: clamp(0.85rem, 1.2vw, 1rem);
  font-family: var(--font-sans);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
