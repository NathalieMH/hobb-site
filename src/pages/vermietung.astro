<script>
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const button = target.closest("[data-photos-open]") as HTMLElement | null;

    if (!button) return;

    event.preventDefault();
    event.stopImmediatePropagation();

    if (button.classList.contains("fp-placeholder")) return;

    const src = button.getAttribute("data-photo-src") ?? "";
    const imagesRaw = button.getAttribute("data-photo-images") ?? "[]";

    const titleDe = button.getAttribute("data-photo-title-de") ?? "";
    const titleEn = button.getAttribute("data-photo-title-en") ?? "";

    let images: string[] = [];

    try {
      images = JSON.parse(imagesRaw);
    } catch {
      images = src ? [src] : [];
    }

    if (!src && images.length === 0) return;

    document.dispatchEvent(
      new CustomEvent("iz:open", {
        detail: {
          src: src || images[0],
          images,
          idx: 0,

          titleDe,
          titleEn,
          title_de: titleDe,
          title_en: titleEn,
          title: titleDe
        }
      })
    );
  }, true);

  function openRotationModal() {
    const overlay = document.getElementById("rotation-overlay");
    if (!overlay) return;

    overlay.classList.remove("hidden");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function closeRotationModal() {
    const overlay = document.getElementById("rotation-overlay");
    if (!overlay) return;

    overlay.classList.add("hidden");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element;

    if (target.closest("[data-open-rotation]")) {
      event.preventDefault();
      openRotationModal();
      return;
    }

    const overlay = document.getElementById("rotation-overlay");

    if (
      target.closest(".text-modal-close") ||
      target === overlay
    ) {
      event.preventDefault();
      closeRotationModal();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeRotationModal();
    }
  });
</script>
