---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
const base = import.meta.env.BASE_URL;
const mapSrc = "https://maps.google.com/maps?q=Haderslebener+Stra%C3%9Fe+26,+12163+Berlin&output=embed&z=14";
---
<Layout title="Haderslebener 26 — Die Lage">

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Berlin · Steglitz · Dahlem</span>
      <span class="eyebrow" data-en>Berlin · Steglitz · Dahlem</span>
      <h1 data-de>Die Lage</h1>
      <h1 data-en>Location</h1>
      <DecoRule />
    </div>
  </section>

  <section class="section lage-content" style="padding-top:1.5rem">
    <div class="container lage-inner">
      <div class="lage-text">
        <p class="reveal" data-de>
          Unser Haus in der Haderslebener Straße 26 liegt im Bezirk Steglitz-Zehlendorf, direkt an der Grenze zu Dahlem. 
          Mehrere Universitäten sind von hier aus schnell und bequem zu Fuß oder mit dem Fahrrad erreichbar. 
          Ebenso besteht eine ausgezeichnete Anbindung an die BVG mit der U3 (Krumme Lanke-Warschauer Straße), S-Bahnen und Buslinien.
          <br>
          Ein kleiner Park mit Teich zum Entspannen sowie der Erlenbusch-Park, der bis zur Domäne Dahlem führt, liegen in unmittelbarer Nähe.  
        </p>
        <p class="reveal" data-en>
          Our house at Haderslebener Straße 26 is in the Steglitz-Zehlendorf district, right on the border with Dahlem and within easy walking or cycling distance of several universities. 
        It also has excellent public transport connections via the BVG, including the U3 line (Krumme Lanke–Warschauer Straße), as well as S-Bahn and bus services.
        <br>
        A small park with a pond for relaxing and the Erlenbusch Park, which extends all the way to Domäne Dahlem, are located in the immediate vicinity.
        </p>

        <div class="transit-section">
          <h3 class="reveal" data-de>Adresse</h3>
          <h3 class="reveal" data-en>Address</h3>
          <p class="address-block reveal">
            Haderslebener Straße 26<br />
            12163 Berlin
          </p>
        </div>

        <div class="transit-section">
          <h3 class="reveal" data-de>In der Nähe</h3>
          <h3 class="reveal" data-en>In the Area</h3>
          <ul class="transit-list reveal-stagger">
            <li class="reveal-child">
              <span class="transit-icon">◆</span>
              <span data-de>Freie Universität Berlin — ca. 10–15 Min. zu Fuß</span>
              <span data-en>Freie Universität Berlin — approx. 10–15 min walk</span>
            </li>
            <li class="reveal-child">
              <span class="transit-icon">◆</span>
              <span data-de>MSB Medical School Berlin — ca. 10 Min. zu Fuß</span>
              <span data-en>MSB Medical School Berlin — approx. 10 min walk</span>
            </li>
            <li class="reveal-child">
              <span class="transit-icon">◆</span>
              <span data-de>Botanischer Garten Berlin / Botanisches Institut FU — ca. 10 Min. zu Fuß</span>
              <span data-en>Botanic Garden / Botanical Institute FU Berlin — approx. 10 min walk</span>
            </li>
            <li class="reveal-child">
              <span class="transit-icon">◆</span>
              <span data-de>TU Berlin – Institut für Lebensmitteltechnologie und Lebensmittelchemie — ca. 15 Min. zu Fuß</span>
              <span data-en>TU Berlin – Institute of Food Technology and Food Chemistry — approx. 15 min walk</span>
            </li>
          </ul>
        </div>

        <div class="transit-section">
          <h3 class="reveal" data-de>ÖPNV-Anbindung</h3>
          <h3 class="reveal" data-en>Public Transport</h3>
          <ul class="transit-list reveal-stagger">
            <li class="reveal-child">
              <span class="transit-badge ubahn">U3</span>
              <span data-de>Breitenbachplatz — ca. 7 Min. zu Fuß</span>
              <span data-en>Breitenbachplatz — approx. 7 min walk</span>
            </li>
            <li class="reveal-child">
              <span class="transit-badge bus">Bus 101</span>
              <span data-de>Rohlfsstr. — ca. 3 Min. zu Fuß</span>
              <span data-en>Rohlfsstr. — approx. 3 min walk</span>
            </li>
            <li class="reveal-child">
              <span class="transit-badges">
                <span class="transit-badge ubahn">U9</span>
                <span class="transit-badge sbahn">S1</span>
              </span>
              <span data-de>Rathaus Steglitz — ca. 15–20 Min. zu Fuß</span>
              <span data-en>Rathaus Steglitz — approx. 15–20 min walk</span>
            </li>
          </ul>
        </div>
      </div>

      <div
        class="map-wrap map-consent reveal"
        data-map-src={mapSrc}
        data-map-title="Karte: Haderslebener 26, Berlin Steglitz-Dahlem"
      >
        <img
          class="map-placeholder"
          src={`${base}lage/google-maps-static-placeholder.webp`}
          alt="Statischer Kartenausschnitt der Umgebung von Haderslebener Straße 26 in Berlin"
          loading="lazy"
          decoding="async"
        />
        <div class="map-consent-panel">
          <p data-de>
            Um die interaktive Karte anzuzeigen, wird Google Maps geladen. Dabei können Daten an Google übertragen werden.
          </p>
          <p data-en>
            To display the interactive map, Google Maps will be loaded. Data may be transferred to Google.
          </p>
          <div class="map-actions">
            <button type="button" class="map-load-btn">
              <span data-de>Ja, Google Maps laden</span>
              <span data-en>Yes, load Google Maps</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>


<script>
  function loadGoogleMap(mapWrap: HTMLElement) {
    if (mapWrap.querySelector('iframe')) return;

    var src = mapWrap.dataset.mapSrc;
    if (!src) return;

    var iframe = document.createElement('iframe');
    iframe.className = 'map-iframe';
    iframe.src = src;
    iframe.width = '100%';
    iframe.height = '100%';
    iframe.style.border = '0';
    iframe.allowFullscreen = true;
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.title = mapWrap.dataset.mapTitle || 'Google Maps';
    mapWrap.appendChild(iframe);
    mapWrap.classList.add('map-loaded');

    iframe.addEventListener('load', function() {
      iframe.classList.add('loaded');
    }, { once: true });
    setTimeout(function() {
      iframe.classList.add('loaded');
    }, 2000);
  }

  function initMapConsent() {
    document.querySelectorAll<HTMLElement>('.map-consent').forEach(function(mapWrap) {
      mapWrap.querySelector('.map-load-btn')?.addEventListener('click', function() {
        loadGoogleMap(mapWrap);
      }, { once: true });
    });

    document.querySelectorAll('.map-wrap iframe').forEach(function(iframe) {
      iframe.addEventListener('load', function() {
        iframe.classList.add('loaded');
      }, { once: true });
      setTimeout(function() {
        iframe.classList.add('loaded');
      }, 2000);
    });
  }
  initMapConsent();
  document.addEventListener('astro:page-load', initMapConsent);
</script>

</Layout>

<style>
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1rem;
}
.lage-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.lage-text { display: flex; flex-direction: column; gap: 2rem; }
.lage-text > p { color: var(--muted); }
.transit-section h3 {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.75rem;
}
.address-block {
    color: var(--muted);
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
}

/* .transit-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
.transit-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem; } */

.transit-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.transit-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;

  color: var(--muted);
  font-size: 0.95rem;
  line-height: 1.7;
  font-family: inherit;
  font-weight: inherit;
}

.transit-icon { color: var(--gold); font-size: 0.4rem; flex-shrink: 0; margin-top: 0.44rem; }
.transit-badges { display: flex; gap: 0.25rem; flex-shrink: 0; }
.transit-badge {
  flex-shrink: 0;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.2em 0.5em;
  border-radius: 3px;
  min-width: 2rem;
  text-align: center;
  white-space: nowrap;
}
.ubahn { background: #005CA9; color: #fff; }
.sbahn { background: #008D4F; color: #fff; }
.bus   { background: #F0A800; color: #1C1A17; }
.map-wrap {
  aspect-ratio: 3 / 2;
  position: relative;
  overflow: hidden;
}
.map-placeholder,
.map-wrap iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.map-placeholder {
  object-fit: cover;
  filter: saturate(0.86) contrast(0.94);
}
.map-consent-panel {
  position: absolute;
  inset: auto 1rem 1rem 1rem;
  padding: 1rem;
  background: rgba(250, 248, 243, 0.94);
  border: 1px solid var(--border);
  color: var(--ink);
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}
.map-consent-panel p {
  max-width: none;
  font-size: 0.86rem;
  line-height: 1.55;
  color: var(--muted);
}
.map-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  align-items: center;
}
.map-actions button,
.map-actions a {
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  border: 1px solid var(--gold);
  padding: 0.62rem 0.8rem;
  background: transparent;
  color: var(--ink);
  line-height: 1;
  transition: color var(--ease), border-color var(--ease), background var(--ease);
}
.map-actions button:hover,
.map-actions a:hover {
  color: var(--gold);
  border-color: var(--ink);
}
.map-loaded .map-placeholder,
.map-loaded .map-consent-panel {
  display: none;
}
@media (max-width: 900px) {
  .lage-inner { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
  .map-consent-panel {
    inset: auto 0.75rem 0.75rem 0.75rem;
    padding: 0.85rem;
  }
  .map-actions {
    align-items: stretch;
    flex-direction: column;
  }
  .map-actions button,
  .map-actions a {
    text-align: center;
  }
}
</style>
