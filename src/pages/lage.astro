---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
---
<Layout title="Villa Theo — Die Lage">

  <section class="page-header">
    <div class="container page-header-inner">
      <span class="eyebrow" data-de>Standort</span>
      <span class="eyebrow" data-en>Location</span>
      <h1 data-de>Die Lage</h1>
      <h1 data-en>Location</h1>
      <DecoRule />
    </div>
  </section>

  <section class="section lage-content" style="padding-top:1.5rem">
    <div class="container lage-inner">
      <div class="lage-text">
        <p data-de>
          Die Villa Theo befindet sich in der Haderslebener Straße 26, 12163 Berlin im Bezirk Steglitz-Zehlendorf, direkt an der Grenze zu Dahlem, einem der grünsten und ruhigsten Viertel Berlins. Mehrere Universitäten sind von hier aus schnell und bequem mit dem Fahrrad oder zu Fuß erreichbar.
        </p>
        <p data-en>
          Villa Theo is at Haderslebener Straße 26, 12163 Berlin — in the Steglitz-Zehlendorf district, on the border with Dahlem. One of the city's greenest and quietest areas, with multiple univerisities in walking and biking distance.
        </p>

        <div class="transit-section">
          <h3 data-de>Adresse</h3>
          <h3 data-en>Address</h3>
          <p class="address-block">
            Haderslebener Straße 26<br />
            12163 Berlin<br />
            <span data-de>Steglitz-Zehlendorf</span>
            <span data-en>Steglitz-Zehlendorf</span>
          </p>
        </div>

        <div class="transit-section">
          <h3 data-de>In der Nähe</h3>
          <h3 data-en>In the Area</h3>
          <ul class="transit-list">
            <li>
              <span class="transit-icon">◆</span>
              <span data-de>Freie Universität Berlin — ca. 10–15 Min. zu Fuß</span>
              <span data-en>Freie Universität Berlin — approx. 10–15 min walk</span>
            </li>
            <li>
              <span class="transit-icon">◆</span>
              <span data-de>MSB Medical School Berlin — ca. 10 Min. zu Fuß</span>
              <span data-en>MSB Medical School Berlin — approx. 10 min walk</span>
            </li>
            <li>
              <span class="transit-icon">◆</span>
              <span data-de>Botanischer Garten Berlin — ca. 10 Min. zu Fuß</span>
              <span data-en>Botanischer Garten Berlin — approx. 10 min walk</span>
            </li>
            <li>
              <span class="transit-icon">◆</span>
              <span data-de>TU Berlin – Institut für Lebensmitteltechnologie und Lebensmittelchemie — ca. 15 Min. zu Fuß</span>
              <span data-en>TU Berlin – Institute of Food Technology and Food Chemistry — approx. 15 min walk</span>
            </li>
          </ul>
        </div>

        <div class="transit-section">
          <h3 data-de>ÖPNV-Anbindung</h3>
          <h3 data-en>Public Transport</h3>
          <ul class="transit-list">
            <li>
              <span class="transit-badge ubahn">U3</span>
              <span data-de>Breitenbachplatz — ca. 7 Min. zu Fuß</span>
              <span data-en>Breitenbachplatz — approx. 7 min walk</span>
            </li>
            <li>
              <span class="transit-badge bus">Bus 101</span>
              <span data-de>Rohlfsstr. — ca. 3 Min. zu Fuß</span>
              <span data-en>Rohlfsstr. — approx. 3 min walk</span>
            </li>
            <li>
              <span class="transit-badges">
                <span class="transit-badge ubahn">U9</span>
                <span class="transit-badge sbahn">S1</span>
              </span>
              <span data-de>Rathaus Steglitz — ca. 15–20 Min. zu Fuß</span>
              <span data-en>Rathaus Steglitz — approx. 15–20 min walk</span>
            </li>
            <li>
              <span class="transit-badge ubahn">U3</span>
              <span data-de>Dahlem Dorf — ca. 15–20 Min. zu Fuß</span>
              <span data-en>Dahlem Dorf — approx. 15–20 min walk</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Map
           For a map with multiple custom pins (villa + transit stops + FU etc.):
           1. Go to mymaps.google.com and create a new map
           2. Add pins for each location
           3. Click Share → Embed on my site → copy the src="..." value
           4. Replace the src below with your custom map URL

           The current embed shows only the villa location.
      -->
      <div class="map-wrap">
        <iframe
          class="map-iframe"
          src="https://maps.google.com/maps?q=Haderslebener+Stra%C3%9Fe+26,+12163+Berlin&output=embed&z=15"
          width="100%"
          height="480"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Karte: Villa Theo, Berlin Steglitz-Dahlem"
        ></iframe>
      </div>
    </div>
  </section>

</Layout>

<style>
.page-header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1rem;
}
.lage-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.lage-text { display: flex; flex-direction: column; gap: 2rem; }
.lage-text > p { color: var(--muted); }
.transit-section h3 {
  font-family: var(--font-sans);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 0.75rem;
}
.address-block {
  font-family: var(--font-serif);
  font-size: 1rem;
  font-weight: 300;
  line-height: 1.7;
  color: var(--ink);
  letter-spacing: 0.03em;
}
.transit-list { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
.transit-list li { display: flex; align-items: center; gap: 0.75rem; font-size: 0.9rem; }
.transit-icon { color: var(--gold); font-size: 0.4rem; flex-shrink: 0; }
.transit-badges { display: flex; gap: 0.25rem; flex-shrink: 0; }
.transit-badge {
  flex-shrink: 0;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  padding: 0.2em 0.5em;
  border-radius: 3px;
  min-width: 2rem;
  text-align: center;
  white-space: nowrap;
}
.ubahn { background: #005CA9; color: #fff; }
.sbahn { background: #008D4F; color: #fff; }
.bus   { background: #F0A800; color: #1C1A17; }
.map-wrap {
  border: 1px solid var(--border);
  overflow: hidden;
}
.map-iframe { display: block; }
@media (max-width: 900px) {
  .lage-inner { grid-template-columns: 1fr; }
}
</style>
