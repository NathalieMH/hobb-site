---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 20%;"
      />
    </div>
  </section>

  <!-- Block 1 -->
  <section class="section haus-history haus-history--intro">
    <div class="container history-grid history-grid--intro">

      <div class="history-text history-text--intro" data-blend>
        <h2 class="middle-title reveal">
          EINE STADTVILLA<br> MIT GESCHICHTE
        </h2>

        <p class="middle-body reveal">
          Unser Haus in der Haderslebener Straße 26 wurde ab 1924 von dem Architekten Leo Nachtlicht erbaut, der im Berliner Raum zu den bedeutendsten Architekten der Jahrhundertwende gehörte. 
          Der damalige Garten wurde von dem ebenfalls bekannten Gartenarchitekten Ethik Pepinsky angelegt.
          In den 1980er Jahren erfolgte ein moderner Anbau an die Stadtvilla.
        </p>
      </div>

      <div class="image-composition image-composition--intro" data-blend data-bd="110ms">
        <figure class="composition-image composition-image--intro-main reveal">
          <img src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="composition-image composition-image--intro-detail reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
      </div>

    </div>
  </section>

  <!-- Block 2 -->
  <section class="section haus-history haus-history--garden">
    <div class="container history-grid history-grid--garden">

      <div class="garden-composition" data-blend data-bd="110ms">
        <figure class="garden-image garden-image--main reveal">
          <img src={`${base}das-haus/garten.webp`} alt="Garten der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <!-- Fallback, falls du noch kein garten.webp hast:
        <figure class="garden-image garden-image--main reveal">
          <img src={`${base}das-haus/Aussenansicht.webp`} alt="Garten und Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
        -->
      </div>

      <div class="history-text history-text--garden" data-blend>
        <h2 class="middle-title reveal">
          DER GARTEN
        </h2>

        <p class="middle-body reveal">
          Heute verbindet die Stadtvilla historische Architektur mit modernem studentischem Wohnen. Die erhaltenen Details des Hauses, der großzügige Garten und die ruhige Lage in Berlin Steglitz-Dahlem prägen den besonderen Charakter der Haderslebener Straße 26.
        </p>

        <p class="middle-body reveal">
          Die Wohnungen und Zimmer werden Schritt für Schritt modernisiert und so gestaltet, dass sie zeitgemäßes Wohnen ermöglichen, ohne den ursprünglichen Charme des Hauses zu verlieren.
        </p>
      </div>

    </div>
  </section>

  <!-- Block 3 -->
  <section class="section haus-history haus-history--architect">
    <div class="container history-grid history-grid--architect">

      <div class="history-text history-text--architect" data-blend>
        <h2 class="middle-title reveal">
          DER ARCHITEKT
        </h2>

        <p class="middle-body reveal">
          Leo Nachtlicht wurde 1872 in Bielitz, Schlesien, geboren. Nach seinem Architektur-Studium arbeitete er bei Bruno Möhring und betrieb ab 1904 ein eigenes Atelier in Berlin. 
          Leo Nachtlicht entwarf und baute Landhäuser, Villen und deren 
          Inneneinrichtungen, wie z.B. auch in der H26 ein schönes Holzzimmer und das geschwungene holzverkleidete Treppenhaus, die original erhalten sind.
        </p>

        <p class="middle-body reveal">
          Zu Nachtlichts bedeutendsten Gebäuden zählt neben dem Ausstellungsgebäude der Berliner Secession vor allem auch der Gourmenia-Palast, dem Vorläufer des heutigen BIKINI BERLIN am Zoo. 
          Als besondere Attraktion wurde im rückwärtigen Teil des Gebäudes, 
          direkt am Berliner Zoo, das dreigeschossige Weinrestaurant „Traube“ mit einem subtropischen Garten mit Bäumen und großblättrigen Pflanzen, Blumen und bunten Vögeln errichtet. 
        </p>

        <p class="middle-body reveal">
          Der Gourmenia-Palast gehörte zu den größten Gaststätten, die Ende der zwanziger Jahre eröffnet wurden. Nach nur wenigen Betriebsjahren wurde das Gebäude im Zweiten Weltkrieg allerdings völlig zerstört.
          <br><br>
          Ab 1933 wurde Leo Nachtlicht als Jude die Arbeitserlaubnis entzogen. Am 22.09.1942 starb er, wahrscheinlich an den Folgen eines Selbstmordversuchs,
          und wurde auf dem jüdischen Friedhof Berlin-Weißensee bestattet.
          <br><br>
          Textquellen:
          <br>
          Text auszugsweise aus openpr.de „BIKINI BERLIN - Hommage an Leo Nachtlicht“ und stolpersteine-berlin/Leo Nachtlicht
        </p>
      </div>

      <div class="architect-gallery" data-blend data-bd="110ms">
        <figure class="architect-gallery__image architect-gallery__image--main reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Historische Details im Inneren der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="architect-gallery__image architect-gallery__image--small reveal">
          <img src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="architect-gallery__image architect-gallery__image--small reveal">
          <img src={`${base}das-haus/staircase.webp`} alt="Holzverkleidetes Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
      </div>

    </div>
  </section>

</Layout>

<style>

/* Sections */

.haus-history {
  padding-block: 0;
}

.haus-history--intro {
  padding-top: clamp(3rem, 5vw, 5rem);
}

.haus-history--garden {
  padding-top: clamp(3.25rem, 5.5vw, 5.5rem);
}

.haus-history--architect {
  padding-top: clamp(3.5rem, 6vw, 6rem);
  padding-bottom: clamp(4rem, 7vw, 7rem);
}

/* Layout */

.history-grid {
  display: grid;
  align-items: center;
  gap: clamp(2.25rem, 4vw, 4.5rem);
}

.history-grid--intro {
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
}

.history-grid--garden {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
}

.history-grid--architect {
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: start;
}

/* Text */

.history-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-text--intro {
  align-self: start;
  padding-top: clamp(0.5rem, 2vw, 1.5rem);
}

.history-text--garden {
  max-width: 48ch;
}

.history-text--architect {
  max-width: 56ch;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.9rem, 3.1vw, 2.65rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.02;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* Images shared */

.image-composition,
.composition-image,
.garden-composition,
.garden-image,
.architect-gallery,
.architect-gallery__image {
  margin: 0;
}

.composition-image,
.garden-image,
.architect-gallery__image {
  overflow: hidden;
  background: var(--bg);
}

.composition-image img,
.garden-image img,
.architect-gallery__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 900ms cubic-bezier(.2, .8, .2, 1);
}

@media (hover: hover) {
  .composition-image:hover img,
  .garden-image:hover img,
  .architect-gallery__image:hover img {
    transform: scale(1.035);
  }
}

/* Block 1 editorial image composition */

.image-composition--intro {
  position: relative;
  min-height: clamp(430px, 44vw, 650px);
}

.composition-image--intro-main {
  position: absolute;
  top: 0;
  right: 0;
  width: 70%;
  height: 88%;
  z-index: 1;
  box-shadow: 0 1.4rem 3.5rem rgba(35, 29, 24, 0.12);
}

.composition-image--intro-detail {
  position: absolute;
  left: 4%;
  bottom: 0;
  width: 43%;
  height: 36%;
  z-index: 2;
  border: 0.75rem solid var(--bg);
  box-shadow: 0 1.2rem 2.8rem rgba(35, 29, 24, 0.14);
}

.composition-image--intro-main img {
  object-position: center;
}

.composition-image--intro-detail img {
  object-position: center;
}

/* Block 2 garden */

.garden-composition {
  position: relative;
}

.garden-image--main {
  width: 100%;
  height: clamp(360px, 36vw, 520px);
  box-shadow: 0 1.4rem 3.8rem rgba(35, 29, 24, 0.11);
}

.garden-image--main img {
  object-position: center;
}

/* Block 3 architect gallery */

.architect-gallery {
  position: sticky;
  top: 7rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(0.65rem, 1vw, 0.95rem);
}

.architect-gallery__image {
  box-shadow: 0 1.2rem 3rem rgba(35, 29, 24, 0.1);
}

.architect-gallery__image--main {
  grid-column: 1 / -1;
  height: clamp(300px, 30vw, 430px);
}

.architect-gallery__image--small {
  height: clamp(180px, 18vw, 260px);
}

.architect-gallery__image--main img {
  object-position: center;
}

.architect-gallery__image--small:first-of-type img {
  object-position: center 25%;
}

.architect-gallery__image--small:last-of-type img {
  object-position: center;
}

/* Optional refinement lines */

.haus-history--garden,
.haus-history--architect {
  position: relative;
}

.haus-history--garden::before,
.haus-history--architect::before {
  content: "";
  position: absolute;
  top: clamp(1.5rem, 3vw, 2.5rem);
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(35, 29, 24, 0.08);
  pointer-events: none;
}

/* Responsive */

@media (max-width: 900px) {
  .history-grid--intro,
  .history-grid--garden,
  .history-grid--architect {
    grid-template-columns: 1fr;
  }

  .history-grid--garden .garden-composition {
    order: 2;
  }

  .history-grid--garden .history-text {
    order: 1;
  }

  .history-text--garden,
  .history-text--architect {
    max-width: none;
  }

  .image-composition--intro {
    min-height: clamp(420px, 72vw, 620px);
  }

  .architect-gallery {
    position: relative;
    top: auto;
  }
}

@media (max-width: 600px) {
  .haus-history--intro {
    padding-top: clamp(2.25rem, 9vw, 3.25rem);
  }

  .haus-history--garden,
  .haus-history--architect {
    padding-top: clamp(2.75rem, 10vw, 4rem);
  }

  .history-grid {
    gap: clamp(1.75rem, 7vw, 2.5rem);
  }

  .image-composition--intro {
    min-height: 112vw;
  }

  .composition-image--intro-main {
    width: 82%;
    height: 68%;
  }

  .composition-image--intro-detail {
    left: 0;
    width: 58%;
    height: 34%;
    border-width: 0.5rem;
  }

  .garden-image--main {
    height: 72vw;
  }

  .architect-gallery {
    gap: 0.5rem;
  }

  .architect-gallery__image--main {
    height: 64vw;
  }

  .architect-gallery__image--small {
    height: 38vw;
  }
}

</style>
