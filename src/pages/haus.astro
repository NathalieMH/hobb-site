---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 20%;"
      />
    </div>
  </section>

  <!-- History block 1 -->
  <section class="section haus-history">
    <div class="container history-grid history-grid--first">

      <div class="history-text" data-blend>
        <h2 class="middle-title reveal">
          EINE STADTVILLA<br> MIT GESCHICHTE
        </h2>

        <p class="middle-body reveal">
          Unser Haus in der Haderslebener Straße 26 wurde ab 1924 von dem Architekten Leo Nachtlicht erbaut, der im Berliner Raum zu den bedeutendsten Architekten der Jahrhundertwende gehörte. 
          Der damalige Garten wurde von dem ebenfalls bekannten Gartenarchitekten Ethik Pepinsky angelegt.
          In den 1980er Jahren erfolgte ein moderner Anbau an die Stadtvilla.
        </p>
      </div>

      <div class="history-image-stack history-image-stack--right" data-blend data-bd="110ms">
        <figure class="history-image history-image--large reveal">
          <img src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="history-image history-image--small reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
      </div>

    </div>
  </section>

  <!-- History block 2 -->
  <section class="section haus-history haus-history--second">
    <div class="container history-grid history-grid--reverse history-grid--centered">

      <div class="history-single-image" data-blend data-bd="110ms">
        <img class="reveal" src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" />

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
      </div>

      <div class="history-text" data-blend>
        <h2 class="middle-title reveal">
          DER GARTEN
        </h2>

        <p class="middle-body reveal">
          Heute verbindet die Stadtvilla historische Architektur mit modernem studentischem Wohnen. Die erhaltenen Details des Hauses, der großzügige Garten und die ruhige Lage in Berlin Steglitz-Dahlem prägen den besonderen Charakter der Haderslebener Straße 26.
        </p>

        <p class="middle-body reveal">
          Die Wohnungen und Zimmer werden Schritt für Schritt modernisiert und so gestaltet, dass sie zeitgemäßes Wohnen ermöglichen, ohne den ursprünglichen Charme des Hauses zu verlieren.
        </p>
      </div>

    </div>
  </section>

  <!-- History block 3 -->
  <section class="section haus-history haus-history--third">
    <div class="container history-grid history-grid--third">

      <div class="history-text" data-blend>
        <h2 class="middle-title reveal">
          DER ARCHITEKT
        </h2>

        <p class="middle-body reveal">
          Leo Nachtlicht wurde 1872 in Bielitz, Schlesien, geboren. Nach seinem Architektur-Studium arbeitete er bei Bruno Möhring und betrieb ab 1904 ein eigenes Atelier in Berlin. 
          Leo Nachtlicht entwarf und baute Landhäuser, Villen und deren 
          Inneneinrichtungen, wie z.B. auch in der H26 ein schönes Holzzimmer und das geschwungene holzverkleidete Treppenhaus, die original erhalten sind.
        </p>

        <p class="middle-body reveal">
          Zu Nachtlichts bedeutendsten Gebäuden zählt neben dem Ausstellungsgebäude der Berliner Secession vor allem auch der Gourmenia-Palast, dem Vorläufer des heutigen BIKINI BERLIN am Zoo. 
          Als besondere Attraktion wurde im rückwärtigen Teil des Gebäudes, 
          direkt am Berliner Zoo, das dreigeschossige Weinrestaurant „Traube“ mit einem subtropischen Garten mit Bäumen und großblättrigen Pflanzen, Blumen und bunten Vögeln errichtet. 
        </p>

        <p class="middle-body reveal">
          Der Gourmenia-Palast gehörte zu den größten Gaststätten, die Ende der zwanziger Jahre eröffnet wurden. Nach nur wenigen Betriebsjahren wurde das Gebäude im Zweiten Weltkrieg allerdings völlig zerstört.
          <br><br>
          Ab 1933 wurde Leo Nachtlicht als Jude die Arbeitserlaubnis entzogen. Am 22.09.1942 starb er, wahrscheinlich an den Folgen eines Selbstmordversuchs,
          und wurde auf dem jüdischen Friedhof Berlin-Weißensee bestattet.
          <br><br>
          Textquellen:
          <br>
          Text auszugsweise aus openpr.de „BIKINI BERLIN - Hommage an Leo Nachtlicht“ und stolpersteine-berlin/Leo Nachtlicht
        </p>
      </div>

      <div class="history-image-column" data-blend data-bd="110ms">
        <figure class="history-column-image history-column-image--tall reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="history-column-image history-column-image--wide reveal">
          <img src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" /> -->
      </div>

    </div>
  </section>

</Layout>

<style>

/* ── History sections ── */

.haus-history {
  padding-top: clamp(2.5rem, 5vw, 5rem);
  padding-bottom: 0;
}

.haus-history--second {
  padding-top: clamp(3rem, 6vw, 6rem);
}

.haus-history--third {
  padding-top: clamp(3rem, 6vw, 6rem);
  padding-bottom: clamp(3rem, 6vw, 6rem);
}

/* ── Grid layout ── */

.history-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: clamp(2.5rem, 5vw, 5rem);
  align-items: start;
}

.history-grid--reverse {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
}

.history-grid--centered {
  align-items: center;
}

.history-grid--third {
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
}

/* ── Text ── */

.history-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.05;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* ── Shared image styling ── */

.history-image,
.history-column-image,
.history-single-image {
  margin: 0;
  overflow: hidden;
  background: var(--bg);
}

.history-image img,
.history-column-image img,
.history-single-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ── Block 1: elegant overlapping image stack ── */

.history-image-stack {
  position: relative;
  min-height: clamp(360px, 42vw, 560px);
}

.history-image-stack--right {
  padding-left: clamp(1.5rem, 4vw, 4rem);
  padding-bottom: clamp(2rem, 5vw, 4.5rem);
}

.history-image--large {
  width: 82%;
  height: clamp(320px, 38vw, 520px);
  margin-left: auto;
}

.history-image--large img {
  object-position: center;
}

.history-image--small {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 48%;
  height: clamp(160px, 18vw, 260px);
  border: 0.75rem solid var(--bg);
}

.history-image--small img {
  object-position: center;
}

/* ── Block 2: one calm large image ── */

.history-single-image {
  width: 100%;
  height: clamp(360px, 42vw, 620px);
}

.history-single-image img {
  object-position: center;
}

/* ── Block 3: vertical editorial image column ── */

.history-image-column {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(1rem, 2vw, 1.5rem);
  align-self: stretch;
}

.history-column-image--tall {
  height: clamp(360px, 40vw, 580px);
}

.history-column-image--wide {
  width: 72%;
  height: clamp(180px, 18vw, 280px);
  margin-left: auto;
}

.history-column-image--tall img,
.history-column-image--wide img {
  object-position: center;
}

/* ── Responsive ── */

@media (max-width: 900px) {
  .history-grid,
  .history-grid--reverse,
  .history-grid--third {
    grid-template-columns: 1fr;
  }

  .history-grid--reverse .history-single-image {
    order: 2;
  }

  .history-grid--reverse .history-text {
    order: 1;
  }

  .history-image-stack {
    min-height: auto;
  }

  .history-image-stack--right {
    padding-left: 0;
    padding-bottom: 0;
    display: grid;
    grid-template-columns: 1fr 0.72fr;
    gap: 1rem;
    align-items: end;
  }

  .history-image--large {
    width: 100%;
    height: clamp(280px, 58vw, 520px);
    margin-left: 0;
  }

  .history-image--small {
    position: static;
    width: 100%;
    height: clamp(180px, 36vw, 320px);
    border: 0;
  }

  .history-column-image--wide {
    width: 100%;
  }
}

@media (max-width: 600px) {
  .haus-history {
    padding-top: clamp(2rem, 8vw, 3rem);
  }

  .haus-history--second,
  .haus-history--third {
    padding-top: clamp(2.5rem, 9vw, 4rem);
  }

  .history-grid {
    gap: clamp(1.75rem, 7vw, 2.5rem);
  }

  .history-image-stack--right {
    grid-template-columns: 1fr;
  }

  .history-image--large,
  .history-image--small,
  .history-single-image,
  .history-column-image--tall,
  .history-column-image--wide {
    height: 64vw;
  }
}

</style>
