---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 25%;"
      />
    </div>
  </section>

  <!-- Middle: text + pull-quote left | staircase right -->
  <section class="haus-middle">
    <div class="middle-grid">

      <!-- LEFT: title text + pull-quote pushed to bottom -->
      <div class="middle-left" data-blend>
        <div class="text-anchor">
          <h2 class="middle-title reveal">
            EINE HISTORISCHE<br> STADTVILLA
          </h2>
          <p class="middle-body reveal">
            Unser Haus in der Haderslebener Straße 26 wurde ab 1924 von dem Architekten Leo Nachtlicht erbaut, der im Berliner Raum zu den bedeutendsten Architekten der Jahrundertwende gehörte. 
            Der damalige Garten wurde von dem ebenfalls bekannten Gartenarchitekten E. Pepinsky angelegt.
            In den 1980er Jahren erfolgte ein moderner Anbau an die Stadtvilla.
          </p>
        </div>

        <div class="pull-quote">
          <span class="eyebrow reveal" data-de>Berlin · 1920er Jahre · Architekt Leo Nachtlicht</span>
          <span class="eyebrow reveal" data-en>Berlin · 1920s · Architect Leo Nachtlicht</span>
          <blockquote class="reveal" data-de>
            Leo Nachtlicht wurde 1872 in Bielitz, Schlesien, geboen. Nach seinem Architekturstudium arbeitete er bei Bruno Möhring und betrieb a 1904 ein eigenes Atelier in Berlin. 
            In dem Jahr gestaltete er auch das Empfangsszimmer des deutschen Pavillonsauf der Weltausstellung in St.Louis. 
            Leo Nachtlicht entwarf und baute Landhäuser, Villen und deren Inneneinrichtungen, wie z.B. auch in unserem Haus ein schönes Holzzimmer und das geschwungene holzverkleidete Treppenhaus.
          </blockquote>
          <blockquote class="reveal" data-en>
            Zu Leo Nachtlichts bedeutendsten Gebäuden zählt neben dem Ausstellungsgebäude der Berliner Secession vor allem auch der Gourmenia-Palast, dem Vorläufer des heutigen BIKINI BERLIN am Zoo. 
            Der Gourmenia-Palast war ganz im Stil der der Neuen Sachlichkeit gebaut und bot verschiedenste gastronomische Einrichtungen. Als besondere Attraktion wurde im rückwärtigen Teil des Gebäudes, direkt am Berliner Zoo, das dreigeschossige Weinrestaurant "Traube" mit einem subtropischen Garten mit Bäumen und großblättrigen Pflanzen, Blumen und bunten Vögeln errichtet. 
            Der Gourmenia-Palast gehörte zu den größten Gaststätten, die Ende der zwanziger Jahre eröffnet wurden. Nach nur wenigen Betriebsjahren wurde das Gebäude im Zweiten Weltkrieg allerdings völlig zerstört.
          </blockquote>
        </div>
      </div>

      <!-- RIGHT: staircase image -->
      <div class="middle-img" data-blend data-bd="110ms">
        <img
          class="reveal"
          src={`${base}das-haus/staircase.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
        />
      </div>

    </div>
  </section>

  <!-- Bottom: aerial left | aesthetic image + facts right -->
  <section class="haus-bottom">
    <div class="img-pair">
      <div class="aerial-wrap" data-blend>
        <img class="reveal" src={`${base}das-haus/vonoben.png`} alt="" loading="lazy" decoding="async" />
      </div>
      <div class="bottom-right-col" data-blend data-bd="120ms">
        <img class="reveal" src={`${base}das-haus/houseaesthetic.jpg`} alt="" loading="lazy" decoding="async" />
        <div class="haus-facts" data-blend data-bd="260ms">
          <h3 class="facts-heading reveal" data-de>Ein Haus mit Geschichte</h3>
          <h3 class="facts-heading reveal" data-en>A House with History</h3>
          <dl class="reveal">
            <dt><span data-de>Baujahr</span><span data-en>Built</span></dt>
            <dd>1920er Jahre</dd>
            <dt><span data-de>Architekt</span><span data-en>Architect</span></dt>
            <dd>
              <a class="wiki-link" href="https://de.wikipedia.org/wiki/Leo_Nachtlicht" target="_blank" rel="noopener">
                Leo Nachtlicht
              </a>
            </dd>
            <dt><span data-de>Wohnungen</span><span data-en>Apartments</span></dt>
            <dd>{aptCount}</dd>
            <dt><span data-de>Zimmer gesamt</span><span data-en>Total rooms</span></dt>
            <dd>{roomCount}</dd>
            <dt><span data-de>Lage</span><span data-en>Location</span></dt>
            <dd>Berlin Steglitz · Dahlem</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>

/* ── Shared horizontal padding ── */
.haus-middle,
.haus-bottom {
  padding-inline: clamp(2rem, 8vw, 5rem);
}

/* ── Middle section ── */
.haus-middle {
  padding-top: clamp(2rem, 4vw, 3.5rem);
}

.middle-grid {
  display: grid;
  grid-template-columns: 2fr 3fr;
  align-items: stretch;
  min-height: clamp(480px, 60vw, 780px);
}

/* Left column: title at top, pull-quote at bottom */
.middle-left {
  display: flex;
  flex-direction: column;
  padding-right: clamp(1.5rem, 3vw, 2.5rem);
}

.text-anchor {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.05;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* Pull-quote — pushed to bottom of left column, right-aligned */
.pull-quote {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-top: auto;
  text-align: right;
}
.pull-quote blockquote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.2rem, 2.2vw, 1.65rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.4;
  color: var(--ink);
  padding-right: 1.5rem;
  border-right: 2px solid var(--gold);
  margin: 0;
}

/* Staircase image — fills right column height */
.middle-img {
  overflow: hidden;
}
.middle-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

/* ── Bottom section ── */
.haus-bottom {
  margin-top: clamp(2rem, 4vw, 3.5rem);
}
.img-pair {
  display: grid;
  grid-template-columns: 2fr 3fr;
  gap: 0;
  align-items: start;
}

/* Aerial image wrapper (grid item) */
.aerial-wrap {
  overflow: hidden;
}
.aerial-wrap img,
.bottom-right-col img {
  display: block;
  width: 100%;
  height: clamp(330px, 42vw, 630px);
  object-fit: cover;
}

.bottom-right-col {
  display: flex;
  flex-direction: column;
}

.haus-facts {
  margin-top: 1.5rem;
}
.facts-heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  color: var(--ink);
  margin: 0 0 0.75rem;
}
.haus-facts dl {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.5rem 1.5rem;
  align-items: baseline;
}
.haus-facts dt {
  font-size: 0.7rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
  padding-top: 0.1rem;
}
.haus-facts dd {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 1.05rem;
  margin: 0;
}
.wiki-link {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: var(--gold);
  text-underline-offset: 3px;
}
.wiki-link:hover { color: var(--gold); }

/* ── Responsive ── */
@media (max-width: 900px) {
  .middle-grid {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .middle-img { min-height: 50vw; order: -1; }
  .middle-img img { height: 100%; min-height: 50vw; }
  .img-pair { grid-template-columns: 1fr; }
  .aerial-wrap img,
  .bottom-right-col img { height: 84vw; }
}
@media (max-width: 600px) {
  .haus-bottom { padding-inline: 0; }
}

</style>
