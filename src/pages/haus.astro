---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Villa Theo — Das Haus">

  <!-- Hero -->
  <section class="haus-hero">
    <img
      src={`${base}first-image.png`}
      alt="Villa Theo, Berlin Steglitz-Dahlem"
      loading="eager"
      data-always-fade
    />
  </section>

  <!-- Middle -->
  <section class="haus-middle">
    <div class="middle-grid">

      <!-- LEFT TEXT -->
      <div class="middle-text">
        <div class="text-anchor">
          <h2 class="middle-title">
            EINE HISTORISCHE<br> STADTVILLA
          </h2>

          <p class="middle-body">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </p>
        </div>
      </div>

      <!-- RIGHT IMAGE -->
      <div class="middle-img">
        <img
          src={`${base}das-haus/staircase.jpg`}
          alt=""
          loading="lazy"
          data-always-fade
        />
      </div>

    </div>
  </section>

  <!-- Bottom -->
  <section class="haus-bottom">
    <div class="bottom-grid">

      <div class="bottom-left">
        <img src={`${base}das-haus/vonoben.png`} alt="" loading="lazy" data-always-fade />
      </div>

      <div class="bottom-right">
        <div class="bottom-img">
          <img src={`${base}das-haus/houseaesthetic.jpg`} alt="" loading="lazy" data-always-fade />
        </div>

        <div class="facts-box">
          <div class="facts-watermark" aria-hidden="true">GESCHICHTE</div>

          <h2>Ein Haus mit Geschichte</h2>

          <dl class="facts-dl">
            <dt>Baujahr</dt>
            <dd>1920er Jahre</dd>

            <dt>Architekt</dt>
            <dd>
              <a class="wiki-link" href="https://de.wikipedia.org/wiki/Leo_Nachtlicht" target="_blank" rel="noopener">
                Leo Nachtlicht
              </a>
            </dd>

            <dt>Wohnungen</dt>
            <dd>{aptCount}</dd>

            <dt>Zimmer gesamt</dt>
            <dd>{roomCount}</dd>

            <dt>Lage</dt>
            <dd>Berlin Steglitz · Dahlem</dd>
          </dl>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>

/* ── Design tokens ── */
:root {
  --stair-width: 60%;
  --stair-anchor: 66.666%;
}

/* ── Shared frame alignment ── */
.haus-hero,
.haus-middle {
  padding-inline: clamp(2rem, 8vw, 5rem);
}

/* ── Hero ── */
.haus-hero {
  margin: 0;
  font-size: 0;
  line-height: 0;
  overflow: hidden;
  background: #fff;
}

.haus-hero img {
  display: block;
  width: 100%;
  height: clamp(320px, 52vw, 720px);
  object-fit: cover;
  object-position: center 35%;
}

/* ── Middle layout ── */
.middle-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: start;
}

/* LEFT TEXT */
.middle-text {
  grid-column: 1 / 3;
  display: flex;
  flex-direction: column;
  padding: 0;
}

/* shared vertical alignment anchor */
.text-anchor {
  padding-top: clamp(2rem, 4vw, 3.5rem);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

/* typography */
.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.05;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  max-width: 38rem;
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* ── STAIRCASE IMAGE (CRITICAL ALIGNMENT) ── */
.middle-img {
  grid-column: 1 / -1;
  align-self: start;
  padding-top: clamp(2rem, 4vw, 3.5rem);
}

.middle-img img {
  width: var(--stair-width);
  margin-left: var(--stair-anchor);
  transform: translateX(-50%);
  display: block;
  height: auto;
  object-fit: cover;
}

/* ── Bottom section ── */
.haus-bottom { margin-top: 0; }

.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: clamp(500px, 65vw, 860px);
}

.bottom-left img,
.bottom-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Facts */
.facts-box {
  position: relative;
  padding: clamp(1.5rem, 3vw, 2.5rem);
  background: var(--bg);
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .middle-grid {
    grid-template-columns: 1fr;
  }

  .middle-text {
    grid-column: auto;
  }

  .middle-img img {
    width: 100%;
    margin-left: 0;
    transform: none;
  }

  .bottom-grid {
    grid-template-columns: 1fr;
  }
}

</style>