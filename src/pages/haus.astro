---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 20%;"
      />
    </div>
  </section>

  <!-- Block 1 -->
  <section class="section haus-history haus-history--intro">
    <div class="container history-grid history-grid--intro">

      <div class="history-text history-text--intro" data-blend>
        <div class="intro-copy">
          <h2 class="middle-title reveal" data-de>
            EINE STADTVILLA<br> MIT GESCHICHTE
          </h2>

          <h2 class="middle-title reveal" data-en>
            A TOWN VILLA<br> WITH HISTORY
          </h2>

          <p class="middle-body reveal" data-de>
            Unser Haus in der Haderslebener Straße 26 wurde ab 1924 von dem Architekten Leo Nachtlicht erbaut, der im Berliner Raum zu den bedeutendsten Architekten der Jahrhundertwende gehörte. 
            <br>
            Der damalige Garten wurde von dem ebenfalls bekannten Gartenarchitekten E. Pepinsky angelegt.<br>
            In den 1980er Jahren erfolgte ein moderner Anbau an die Stadtvilla. 
          </p>

          <p class="middle-body reveal" data-en>
            Our house at Haderslebener Straße 26 was built from 1924 onwards by the architect Leo Nachtlicht, who was one of the most important architects in the Berlin area around the turn of the century.
          <br>
          The original garden was designed by the well-known garden architect E. Pepinsky.
            In the 1980s, a modern extension was added to the town villa.
          </p>
        </div>

        <figure class="intro-detail-card reveal" data-blend data-bd="140ms">
          <img src={`${base}das-haus/Block1unten.png`} alt="Historisches Detail im Inneren der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
      </div>

      <div class="intro-image-stage" data-blend data-bd="110ms">
        <figure class="intro-main-image reveal">
          <img src={`${base}das-haus/Block1rechts.jpg`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
      </div>

    </div>
  </section>

  <!-- Block 2 -->
  <section class="section haus-history haus-history--garden">
    <div class="container history-grid history-grid--garden">

      <div class="garden-image-stage" data-blend data-bd="110ms">
        <figure class="garden-image garden-image--main reveal">
          <img src={`${base}das-haus/IMG_6392.webp`} alt="Garten und Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>
      </div>

      <div class="history-text history-text--garden" data-blend>
        <h2 class="middle-title reveal" data-de>
          DER GARTEN
        </h2>

        <h2 class="middle-title reveal" data-en>
          THE GARDEN
        </h2>

        <p class="middle-body reveal" data-de>
          Der parkähnliche Garten mit zum Teil altem Baumbestand wird in bestimmten Bereichen den Studierenden zur Verfügung stehen. Geplant sind dort auch eine Boule-Bahn oder eine Tischtennisplatte. 
        </p>

        <p class="middle-body reveal" data-en>
          The park-like garden, which features some mature trees, will be open to students in certain areas. Plans also include a bocce court or a ping-pong table. 
        </p>

        <p class="middle-body reveal" data-de>
          (Diesen Sommer ist die Nutzung des Gartens aufgrund von Erdarbeiten leider nur eingeschränkt möglich.) 
        </p>

        <p class="middle-body reveal" data-en>
          (Due to landscaping work, this summer the garden is only available for limited use.)
        </p>
      </div>

    </div>
  </section>

  <!-- Block 3 -->
  <section class="section haus-history haus-history--architect">
    <div class="container history-grid history-grid--architect">

      <div class="history-text history-text--architect" data-blend>
        <h2 class="middle-title reveal" data-de>
          DER ARCHITEKT
        </h2>

        <h2 class="middle-title reveal" data-en>
          THE ARCHITECT
        </h2>

        <p class="middle-body reveal" data-de>
          Leo Nachtlicht (1872-1942) betrieb nach seinem Architektur-Studium ab 1904 ein eigenes Atelier in Berlin. 
          Unter anderem entwarf und baute er Landhäuser, Villen und deren Inneneinrichtungen, wie z.B. auch in der Haderslebener 26 ein schönes Holzzimmer und das geschwungene holzverkleidete Treppenhaus.
        </p>

        <p class="middle-body reveal" data-en>
          Leo Nachtlicht (1872–1942), after completing his architecture studies, ran his own studio in Berlin starting in 1904. He designed and built country houses, villas, and their interiors; for example, at Haderslebener 26, he created a beautiful wood-paneled room and the curved, wood-clad staircase.
        </p>

        <p class="middle-body reveal" data-de>
          Zu Nachtlichts bedeutendsten Gebäuden zählt neben dem Ausstellungsgebäude der Berliner Secession vor allem auch der Gourmenia-Palast, dem Vorläufer des heutigen BIKINI BERLIN am Zoo, der allerdings nach nur wenigen Betriebsjahren im Zweiten Weltkrieg völlig zerstört wurde. 
           
        </p>

        <p class="middle-body reveal" data-en>
          Among Nachtlicht’s most important buildings, alongside the exhibition building of the Berlin Secession, was the Gourmenia Palace, the predecessor of today’s BIKINI BERLIN near the Zoo, which was completely destroyed during World War II after only a few years of operation. 
          
        </p>

        <p class="middle-body reveal" data-de>
          Ab 1933 wurde Leo Nachtlicht als Jude die Arbeitserlaubnis entzogen und er verlor alle seine Ämter. Am 22.September 1942 starb er, wahrscheinlich an den Folgen eines Selbstmordversuchs, und wurde auf dem jüdischen Friedhof Berlin-Weißensee bestattet.<br>
          Seine Frau Anna Nachtlicht geb. Levy (1880 - 1942) wurde im Oktober 1942 nach Riga deportiert und dort ermordet.
          <br><br>
          
          <br><br>
          Textquellen:
          <br>
          Text auszugsweise aus openpr.de „BIKINI BERLIN - Hommage an Leo Nachtlicht“ und stolpersteine-berlin/Leo Nachtlicht
        </p>

        <p class="middle-body reveal" data-en>
          The Gourmenia Palace was one of the largest restaurants opened in the late 1920s. However, after only a few years of operation, the building was completely destroyed during the Second World War.
          <br><br>
          From 1933 onwards, Leo Nachtlicht, being Jewish, was banned from practising his profession and lost all his positions. He died on 22 September 1942, probably as a result of a suicide attempt.<br>
          and was buried at the Jewish Cemetery in Berlin-Weißensee. His wife, Anna Nachtlicht (1880–1942), was deported to Riga in October 1942 and murdered there.
          <br><br>
          Text sources:
          <br>
          Text partly based on openpr.de “BIKINI BERLIN - Hommage an Leo Nachtlicht” and stolpersteine-berlin/Leo Nachtlicht
        </p>
      </div>

      <div class="architect-gallery" data-blend data-bd="110ms">
        <figure class="architect-gallery__image architect-gallery__image--main reveal">
          <img src={`${base}das-haus/Block3oben.jpg`} alt="Historische Details im Inneren der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <div class="architect-gallery__row">
          <figure class="architect-gallery__image architect-gallery__image--small reveal">
            <img src={`${base}das-haus/Block3links.JPG`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
          </figure>

          <figure class="architect-gallery__image architect-gallery__image--small reveal">
            <img src={`${base}das-haus/Block3rechts.JPG`} alt="Holzverkleidetes Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>

/* Einheitliche Abstände */

:root {
  --haus-block-space: clamp(2.75rem, 4.5vw, 4.75rem);
  --haus-line-offset: calc(var(--haus-block-space) / 2);
}

/* Hero Abstand korrigieren */

.subpage-hero {
  margin-bottom: 0;
  padding-bottom: 0;
}

.hero-image-wrap {
  margin-bottom: 0;
}

/* Sections */

.haus-history {
  padding-block: 0;
}

.haus-history--intro {
  padding-top: var(--haus-block-space);
}

.haus-history--garden {
  padding-top: var(--haus-block-space);
}

.haus-history--architect {
  padding-top: var(--haus-block-space);
  padding-bottom: clamp(4rem, 7vw, 7rem);
}

/* Layout */

.history-grid {
  display: grid;
  gap: clamp(2.25rem, 4vw, 4.5rem);
}

.history-grid--intro {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  align-items: end;
}

.history-grid--garden {
  grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  align-items: center;
}

.history-grid--architect {
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: start;
}

/* Text */

.history-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-text--intro {
  align-self: end;
  gap: clamp(2.6rem, 5vw, 4.75rem);
  padding-top: 0;
}

.intro-copy {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 46ch;
}

.history-text--garden {
  max-width: 48ch;
}

.history-text--architect {
  max-width: 56ch;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.9rem, 3.1vw, 2.65rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.02;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* Shared image styling */

figure {
  margin: 0;
}

.intro-detail-card,
.intro-main-image,
.garden-image,
.architect-gallery__image {
  position: relative;
  overflow: hidden;
  background: var(--bg);
  isolation: isolate;
}

.intro-detail-card::after,
.intro-main-image::after,
.garden-image::after,
.architect-gallery__image::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  box-shadow: inset 0 0 0 1px rgba(35, 29, 24, 0.12);
}

.intro-detail-card img,
.intro-main-image img,
.garden-image img,
.architect-gallery__image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 900ms cubic-bezier(.2, .8, .2, 1);
}

@media (hover: hover) {
  .intro-detail-card:hover img,
  .intro-main-image:hover img,
  .garden-image:hover img,
  .architect-gallery__image:hover img {
    transform: scale(1.035);
  }

  .architect-gallery__image--main:hover img {
    transform: scale(1.16);
  }
}

/* Block 1 */

.intro-image-stage {
  position: relative;
  align-self: end;
  height: clamp(470px, 48vw, 690px);
}

.intro-image-stage::before {
  content: "";
  position: absolute;
  right: clamp(1rem, 2vw, 1.75rem);
  bottom: clamp(1rem, 2vw, 1.75rem);
  width: 82%;
  height: 86%;
  border: 1px solid rgba(35, 29, 24, 0.16);
  transform: translate(1rem, 1rem);
  z-index: 0;
  pointer-events: none;
}

.intro-main-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 92%;
  z-index: 1;
  box-shadow: 0 1.5rem 4rem rgba(35, 29, 24, 0.13);
}

.intro-main-image img {
  object-position: center;
}

.intro-detail-card {
  width: 100%;
  max-width: none;
  aspect-ratio: 1.45 / 1;
  margin-left: 0;
  box-shadow: 0 1.1rem 2.8rem rgba(35, 29, 24, 0.12);
}

.intro-detail-card::before {
  content: "";
  position: absolute;
  inset: auto auto -0.65rem -0.65rem;
  width: 42%;
  height: 42%;
  border-left: 1px solid rgba(35, 29, 24, 0.2);
  border-bottom: 1px solid rgba(35, 29, 24, 0.2);
  z-index: 3;
  pointer-events: none;
}

.intro-detail-card img {
  object-position: center;
}

/* Block 2 garden */

.garden-image-stage {
  position: relative;
}

.garden-image-stage::before {
  content: "";
  position: absolute;
  inset: clamp(1rem, 2vw, 1.5rem) auto auto clamp(1rem, 2vw, 1.5rem);
  width: 42%;
  height: 42%;
  border-top: 1px solid rgba(35, 29, 24, 0.17);
  border-left: 1px solid rgba(35, 29, 24, 0.17);
  z-index: 3;
  pointer-events: none;
}

.garden-image--main {
  width: 100%;
  height: clamp(360px, 36vw, 520px);
  box-shadow: 0 1.4rem 3.8rem rgba(35, 29, 24, 0.11);
}

.garden-image--main img {
  object-position: center 28%;
}

/* Block 3 architect gallery */

.architect-gallery {
  align-self: start;
  display: grid;

  /* Untere Bilder um ca. 1cm höher gemacht */
  grid-template-rows: clamp(380px, 33vw, 515px) calc(clamp(125px, 9vw, 160px) + 1cm);

  gap: clamp(0.65rem, 1vw, 0.95rem);
  height: auto;
  max-height: none;
  overflow: hidden;
}

.architect-gallery__row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(0.65rem, 1vw, 0.95rem);
  min-height: 0;
}

.architect-gallery__image {
  box-shadow: 0 1.2rem 3rem rgba(35, 29, 24, 0.1);
  min-height: 0;
}

.architect-gallery__image--main,
.architect-gallery__image--small {
  height: 100%;
}

/* Oberes Bild stärker reingezoomt, damit der Frame komplett gefüllt wirkt */
.architect-gallery__image--main img {
  object-position: center;
  transform: scale(1.12);
}

.architect-gallery__image--small:first-child img {
  object-position: center 25%;
}

.architect-gallery__image--small:last-child img {
  object-position: center;
}

/* Section separators */

.haus-history--garden,
.haus-history--architect {
  position: relative;
}

.haus-history--garden::before,
.haus-history--architect::before {
  content: "";
  position: absolute;
  top: var(--haus-line-offset);
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(35, 29, 24, 0.08);
  pointer-events: none;
}

/* Responsive */

@media (max-width: 900px) {
  :root {
    --haus-block-space: clamp(2.5rem, 7vw, 4rem);
  }

  .history-grid--intro,
  .history-grid--garden,
  .history-grid--architect {
    grid-template-columns: 1fr;
  }

  .history-grid--intro {
    align-items: start;
  }

  .history-grid--garden .garden-image-stage {
    order: 2;
  }

  .history-grid--garden .history-text {
    order: 1;
  }

  .history-text--intro {
    padding-top: 0;
    gap: clamp(1.75rem, 5vw, 2.75rem);
  }

  .history-text--garden,
  .history-text--architect,
  .intro-copy {
    max-width: none;
  }

  .intro-detail-card {
    width: min(58%, 300px);
    margin-left: 0;
    aspect-ratio: 1.12 / 1;
  }

  .intro-image-stage {
    height: clamp(420px, 72vw, 620px);
  }

  .intro-main-image {
    width: 100%;
    height: 92%;
  }

  .architect-gallery {
    height: auto;
    max-height: none;
    overflow: visible;
    grid-template-rows: auto auto;
  }

  .architect-gallery__image--main {
    height: clamp(300px, 55vw, 460px);
  }

  .architect-gallery__image--small {
    height: calc(clamp(180px, 28vw, 260px) + 1cm);
  }
}

@media (max-width: 600px) {
  :root {
    --haus-block-space: clamp(2.25rem, 8vw, 3.5rem);
  }

  .history-grid {
    gap: clamp(1.75rem, 7vw, 2.5rem);
  }

  .intro-detail-card {
    width: 66%;
  }

  .intro-image-stage {
    height: 112vw;
  }

  .intro-image-stage::before {
    width: 82%;
    height: 82%;
    transform: translate(0.6rem, 0.6rem);
  }

  .intro-main-image {
    width: 100%;
    height: 88%;
  }

  .garden-image--main {
    height: 72vw;
  }

  .architect-gallery,
  .architect-gallery__row {
    gap: 0.5rem;
  }

  .architect-gallery__image--main {
    height: 64vw;
  }

  .architect-gallery__image--small {
    height: calc(38vw + 1cm);
  }
}

</style>
