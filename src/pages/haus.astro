---
import Layout from "../layouts/Layout.astro";
import DecoRule from "../components/DecoRule.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---
<Layout title="Villa Theo — Das Haus">

  <!-- Hero -->
  <section class="haus-hero">
    <img
      src={`${base}first-image.png`}
      alt="Villa Theo, Berlin Steglitz-Dahlem"
      loading="eager"
      data-always-fade
    />
  </section>

  <!-- Middle: big display text + body | staircase -->
  <section class="haus-middle">
    <div class="middle-grid">

      <div class="middle-text">
        <!-- Display block -->
        <div class="display-block">
          <p class="display-text" data-de>EINE HISTORISCHE STADTVILLA</p>
          <p class="display-text" data-en>A HISTORIC CITY VILLA</p>
          <div class="display-aside">
            <span class="eyebrow" data-de>Geschichte & Architektur</span>
            <span class="eyebrow" data-en>History & Architecture</span>
            <p class="aside-title" data-de>Eine historische Stadtvilla in Berlin Steglitz-Dahlem</p>
            <p class="aside-title" data-en>A historic villa in Berlin Steglitz-Dahlem</p>
          </div>
        </div>

        <!-- Body text -->
        <div class="body-cols">
          <p data-de>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <p data-en>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          </p>
          <p data-de>
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim.
          </p>
          <p data-en>
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim.
          </p>
        </div>

        <!-- Pull quote -->
        <div class="pull-quote">
          <span class="eyebrow" data-de>Berlin · 1920er Jahre · Architekt Leo Nachtlicht</span>
          <span class="eyebrow" data-en>Berlin · 1920s · Architect Leo Nachtlicht</span>
          <blockquote data-de>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </blockquote>
          <blockquote data-en>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
          </blockquote>
        </div>
      </div>

      <!-- Staircase image -->
      <div class="middle-img">
        <img src={`${base}das-haus/staircase.jpg`} alt="" loading="lazy" data-always-fade />
      </div>

    </div>
  </section>

  <!-- Bottom: large image | image + facts -->
  <section class="haus-bottom">
    <div class="bottom-grid">

      <div class="bottom-left">
        <img src={`${base}das-haus/vonoben.png`} alt="" loading="lazy" data-always-fade />
      </div>

      <div class="bottom-right">
        <div class="bottom-img">
          <img src={`${base}das-haus/houseaesthetic.jpg`} alt="" loading="lazy" data-always-fade />
        </div>
        <div class="facts-box">
          <div class="facts-watermark" aria-hidden="true" data-de>GESCHICHTE</div>
          <div class="facts-watermark" aria-hidden="true" data-en>HISTORY</div>
          <h2 data-de>Ein Haus mit Geschichte</h2>
          <h2 data-en>A House with History</h2>
          <dl class="facts-dl">
            <dt><span data-de>Baujahr</span><span data-en>Built</span></dt>
            <dd>1920er Jahre</dd>
            <dt><span data-de>Architekt</span><span data-en>Architect</span></dt>
            <dd><a class="wiki-link" href="https://de.wikipedia.org/wiki/Leo_Nachtlicht" target="_blank" rel="noopener">Leo Nachtlicht</a></dd>
            <dt><span data-de>Wohnungen</span><span data-en>Apartments</span></dt>
            <dd>{aptCount}</dd>
            <dt><span data-de>Zimmer gesamt</span><span data-en>Total rooms</span></dt>
            <dd>{roomCount}</dd>
            <dt><span data-de>Lage</span><span data-en>Location</span></dt>
            <dd>Berlin Steglitz · Dahlem</dd>
          </dl>
        </div>
      </div>

    </div>
  </section>

</Layout>

<style>
/* ── Hero ── */
.haus-hero {
  padding-inline: clamp(2rem, 8vw, 5rem);
  margin-top: 0;
  font-size: 0;
  line-height: 0;
  overflow: hidden;
  background: #fff;
}
.haus-hero img {
  display: block;
  width: 100%;
  height: clamp(320px, 52vw, 720px);
  object-fit: cover;
  object-position: center 35%;
}
@media (max-width: 600px) {
  .haus-hero { padding-inline: 0; }
  .haus-hero img { height: 56vw; }
}

/* ── Middle section ── */
.haus-middle { margin-top: 0; }
.middle-grid {
  display: grid;
  grid-template-columns: 2fr 3fr;
  align-items: stretch;
  min-height: clamp(400px, 55vw, 760px);
}

.middle-text {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3.5rem) clamp(2rem, 8vw, 5rem);
}

/* Display block */
.display-block {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  align-items: end;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
}
.display-text {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.8rem, 3.5vw, 3rem);
  font-weight: 300;
  line-height: 1.05;
  color: var(--ink);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.display-aside {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.aside-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 1.1rem;
  font-weight: 300;
  color: var(--ink);
  line-height: 1.35;
}

/* Body cols */
.body-cols {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}
.body-cols p { color: var(--muted); font-size: 0.88rem; line-height: 1.65; }

/* Pull quote */
.pull-quote { display: flex; flex-direction: column; gap: 0.75rem; }
.pull-quote blockquote {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.5;
  color: var(--ink);
  padding-left: 1.25rem;
  border-left: 2px solid var(--gold);
}

/* Staircase image */
.middle-img {
  overflow: hidden;
}
.middle-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}

/* ── Bottom section ── */
.haus-bottom { margin-top: 0; }
.bottom-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: clamp(500px, 65vw, 860px);
}
.bottom-left {
  overflow: hidden;
}
.bottom-left img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.bottom-right {
  display: flex;
  flex-direction: column;
}
.bottom-img {
  flex: 1;
  overflow: hidden;
  min-height: 0;
}
.bottom-img img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Facts box */
.facts-box {
  position: relative;
  overflow: hidden;
  padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
  background: var(--bg);
}
.facts-watermark {
  position: absolute;
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(4rem, 9vw, 8rem);
  font-weight: 300;
  color: var(--ink);
  opacity: 0.05;
  right: -0.5rem;
  bottom: -0.5rem;
  line-height: 1;
  text-transform: uppercase;
  user-select: none;
  pointer-events: none;
  letter-spacing: 0.05em;
}
.facts-box h2 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  margin-bottom: 1.25rem;
  color: var(--ink);
}
.facts-dl {
  display: grid;
  grid-template-columns: max-content 1fr;
  gap: 0.45rem 1.5rem;
  position: relative;
  z-index: 1;
}
.facts-dl dt {
  font-size: 0.68rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--muted);
}
.facts-dl dd {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: 1rem;
  margin: 0;
  color: var(--ink);
}
.wiki-link {
  color: inherit;
  text-decoration: underline;
  text-decoration-color: var(--gold);
  text-underline-offset: 3px;
}
.wiki-link:hover { color: var(--gold); }

/* ── Responsive ── */
@media (max-width: 900px) {
  .middle-grid { grid-template-columns: 1fr; }
  .middle-img { min-height: 50vw; order: -1; }
  .display-block { grid-template-columns: 1fr; }
  .body-cols { grid-template-columns: 1fr; }
  .bottom-grid { grid-template-columns: 1fr; }
  .bottom-img { min-height: 50vw; }
}
</style>
