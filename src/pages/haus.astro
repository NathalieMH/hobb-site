.haus-facts-section {
  padding-top: clamp(1.5rem, 3vw, 2.5rem);
  padding-bottom: clamp(3rem, 6vw, 5rem);
}

.haus-facts {
  max-width: 720px;
}

.facts-heading {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1rem, 1.8vw, 1.3rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  color: var(--ink);
  margin: 0 0 0.75rem;
