---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero bleibt unverändert -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 20%;"
      />
    </div>
  </section>

  <!-- Block 1 -->
  <section class="section haus-history haus-history--intro">
    <div class="container history-grid history-grid--intro">

      <div class="history-text history-text--intro" data-blend>
        <p class="section-kicker reveal">Das Haus</p>

        <h2 class="middle-title reveal">
          HISTORISCHE VILLA,<br> HEUTIGES WOHNEN
        </h2>

        <p class="middle-body reveal">
          Die Stadtvilla in der Haderslebener Straße 26 wurde ab 1924 nach Plänen des Berliner Architekten Leo Nachtlicht errichtet. Bis heute prägen klare Proportionen, originale Details und das geschwungene Treppenhaus den Charakter des Hauses.
        </p>

        <p class="middle-body reveal">
          Schritt für Schritt wird die Villa behutsam modernisiert — mit zeitgemäßen Wohnungen und Zimmern für Studierende, ohne die besondere Atmosphäre des Hauses zu verlieren.
        </p>
      </div>

      <div class="image-composition image-composition--intro" data-blend data-bd="110ms">
        <figure class="composition-image composition-image--hero reveal">
          <img src={`${base}das-haus/staircase.webp`} alt="Originales Treppenhaus mit Holzverkleidung" loading="lazy" decoding="async" />
        </figure>

        <figure class="composition-image composition-image--floating reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Detailaufnahme historischer Ausstattung" loading="lazy" decoding="async" />
        </figure>
      </div>

    </div>
  </section>

  <!-- Block 2 -->
  <section class="section haus-history haus-history--garden">
    <div class="container history-grid history-grid--garden">

      <figure class="garden-image reveal" data-blend data-bd="110ms">
        <img src={`${base}das-haus/vonoben.webp`} alt="Die Stadtvilla und der Garten aus der Vogelperspektive" loading="lazy" decoding="async" />
      </figure>

      <div class="history-text history-text--garden" data-blend>
        <p class="section-kicker reveal">Lage & Garten</p>

        <h2 class="middle-title reveal">
          RUHIG GELEGEN,<br> GROSSZÜGIG GEDACHT
        </h2>

        <p class="middle-body reveal">
          Der Garten ist ein zentraler Teil des Hauses: grün, ruhig und zurückgesetzt von der Straße. Er schafft Abstand zum Alltag und gibt der historischen Architektur Raum.
        </p>

        <p class="middle-body reveal">
          In Berlin Steglitz-Dahlem verbindet die Haderslebener 26 eine entspannte Wohnatmosphäre mit guter Anbindung — ideal für konzentriertes Lernen, kurze Wege und gemeinschaftliches Wohnen.
        </p>
      </div>

    </div>
  </section>

  <!-- Block 3 -->
  <section class="section haus-history haus-history--architect">
    <div class="container history-grid history-grid--architect">

      <div class="history-text history-text--architect" data-blend>
        <p class="section-kicker reveal">Architektur</p>

        <h2 class="middle-title reveal">
          LEO NACHTLICHT<br> UND DIE H26
        </h2>

        <p class="middle-body reveal">
          Leo Nachtlicht zählt zu den prägenden Berliner Architekten der frühen Moderne. Er entwarf Villen, Landhäuser und Innenräume mit besonderem Gespür für Material, Handwerk und räumliche Wirkung.
        </p>

        <p class="middle-body reveal">
          In der Haderslebener 26 sind bis heute Elemente dieser Haltung sichtbar: Holz, Licht, Proportion und Bewegung verbinden sich zu einem Haus, das nicht nur funktional, sondern atmosphärisch gedacht ist.
        </p>

        <p class="middle-body reveal">
          Die Geschichte des Architekten ist zugleich Teil der Berliner Geschichte. Ab 1933 wurde Nachtlicht als Jude die Arbeitserlaubnis entzogen. Er starb 1942 und wurde auf dem Jüdischen Friedhof Berlin-Weißensee bestattet.
        </p>

        <p class="source-note reveal">
          Quellenhinweis: Textgrundlage u. a. openPR „BIKINI BERLIN — Hommage an Leo Nachtlicht“ sowie stolpersteine-berlin.de.
        </p>
      </div>

      <div class="image-composition image-composition--architect" data-blend data-bd="110ms">
        <figure class="composition-image architect-image--main reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Historisches Detail im Innenraum der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="composition-image architect-image--side reveal">
          <img src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla Haderslebener 26" loading="lazy" decoding="async" />
        </figure>
      </div>

    </div>
  </section>

</Layout>

<style>

/* Sections — Abstände bleiben im Prinzip wie bisher */

.haus-history {
  padding-block: 0;
}

.haus-history--intro {
  padding-top: clamp(3rem, 5vw, 5rem);
}

.haus-history--garden {
  padding-top: clamp(3.25rem, 5.5vw, 5.5rem);
}

.haus-history--architect {
  padding-top: clamp(3.5rem, 6vw, 6rem);
  padding-bottom: clamp(4rem, 7vw, 7rem);
}

/* Layout */

.history-grid {
  display: grid;
  align-items: center;
  gap: clamp(2.25rem, 4vw, 4.5rem);
}

.history-grid--intro {
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
}

.history-grid--garden {
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
}

.history-grid--architect {
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: start;
}

/* Text */

.history-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-text--intro {
  align-self: start;
  padding-top: clamp(0.5rem, 2vw, 1.5rem);
}

.history-text--garden {
  max-width: 48ch;
}

.history-text--architect {
  max-width: 56ch;
}

.section-kicker {
  font-size: 0.72rem;
  line-height: 1;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
  margin: 0 0 0.15rem;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.9rem, 3.1vw, 2.65rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.02;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

.source-note {
  max-width: 54ch;
  font-size: 0.78rem;
  line-height: 1.6;
  color: color-mix(in srgb, var(--muted) 78%, transparent);
  margin: 0.35rem 0 0;
}

/* Images shared */

.image-composition,
.composition-image,
.garden-image {
  margin: 0;
}

.composition-image,
.garden-image {
  overflow: hidden;
  background: var(--bg);
}

.composition-image img,
.garden-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.01);
}

/* dezente, moderne Bildsprache */

.composition-image,
.garden-image {
  box-shadow: 0 1.5rem 4rem rgba(30, 25, 20, 0.08);
}

/* Block 1 collage */

.image-composition--intro {
  position: relative;
  height: clamp(360px, 39vw, 560px);
}

.composition-image--hero {
  position: absolute;
  top: 0;
  right: 0;
  width: 68%;
  height: 82%;
  z-index: 1;
}

.composition-image--floating {
  position: absolute;
  left: 13%;
  bottom: 0;
  width: 43%;
  height: 40%;
  z-index: 2;
  border: 0.75rem solid var(--bg);
}

.composition-image--hero img {
  object-position: center 54%;
}

.composition-image--floating img {
  object-position: center 48%;
}

/* Block 2 large image */

.garden-image {
  width: 100%;
  height: clamp(330px, 34vw, 500px);
}

.garden-image img {
  object-position: center;
}

/* Block 3 collage */

.image-composition--architect {
  position: sticky;
  top: 7rem;
  height: clamp(520px, 54vw, 720px);
}

.architect-image--main {
  position: absolute;
  top: 0;
  left: 0;
  width: 82%;
  height: 67%;
  z-index: 1;
}

.architect-image--side {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 54%;
  height: 36%;
  z-index: 2;
  border: 0.75rem solid var(--bg);
}

.architect-image--main img {
  object-position: center 45%;
}

.architect-image--side img {
  object-position: center 24%;
}

/* Responsive */

@media (max-width: 900px) {
  .history-grid--intro,
  .history-grid--garden,
  .history-grid--architect {
    grid-template-columns: 1fr;
  }

  .history-grid--garden .garden-image {
    order: 2;
  }

  .history-grid--garden .history-text {
    order: 1;
  }

  .history-text--garden,
  .history-text--architect {
    max-width: none;
  }

  .image-composition--architect {
    position: relative;
    top: auto;
    height: clamp(360px, 72vw, 580px);
  }
}

@media (max-width: 600px) {
  .haus-history--intro {
    padding-top: clamp(2.25rem, 9vw, 3.25rem);
  }

  .haus-history--garden,
  .haus-history--architect {
    padding-top: clamp(2.75rem, 10vw, 4rem);
  }

  .history-grid {
    gap: clamp(1.75rem, 7vw, 2.5rem);
  }

  .image-composition--intro {
    height: 108vw;
  }

  .composition-image--hero {
    width: 82%;
    height: 67%;
  }

  .composition-image--floating {
    left: 0;
    width: 58%;
    height: 34%;
    border-width: 0.5rem;
  }

  .garden-image {
    height: 68vw;
  }

  .image-composition--architect {
    height: 105vw;
  }

  .architect-image--main {
    width: 84%;
    height: 66%;
  }

  .architect-image--side {
    width: 58%;
    height: 34%;
    border-width: 0.5rem;
  }
}

</style>

