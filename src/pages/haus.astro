---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const allApts  = await getCollection("apartments");
const allRooms = await getCollection("rooms");
const aptCount  = allApts.length;
const roomCount = allRooms.length;
---

<Layout title="Haderslebener 26 — Das Haus" noPadding={true}>

  <!-- Hero -->
  <section class="subpage-hero" data-blend-move>
    <div class="hero-image-wrap">
      <img
        src={`${base}das-haus/Aussenansicht.webp`}
        alt="Haderslebener 26, Berlin Steglitz-Dahlem"
        loading="eager"
        fetchpriority="high"
        style="object-position: center 20%;"
      />
    </div>
  </section>

  <!-- Block 1 -->
  <section class="section haus-history haus-history--intro">
    <div class="container history-grid history-grid--intro">

      <div class="history-text history-text--intro" data-blend>
        <h2 class="middle-title reveal">
          EINE STADTVILLA<br> MIT GESCHICHTE
        </h2>

        <p class="middle-body reveal">
          Unser Haus in der Haderslebener Straße 26 wurde ab 1924 von dem Architekten Leo Nachtlicht erbaut, der im Berliner Raum zu den bedeutendsten Architekten der Jahrhundertwende gehörte. 
          Der damalige Garten wurde von dem ebenfalls bekannten Gartenarchitekten Ethik Pepinsky angelegt.
          In den 1980er Jahren erfolgte ein moderner Anbau an die Stadtvilla.
        </p>
      </div>

      <div class="image-composition image-composition--intro" data-blend data-bd="110ms">
        <figure class="composition-image composition-image--hero reveal">
          <img src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="composition-image composition-image--floating reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
      </div>

    </div>
  </section>

  <!-- Block 2 -->
  <section class="section haus-history haus-history--garden">
    <div class="container history-grid history-grid--garden">

      <figure class="garden-image reveal" data-blend data-bd="110ms">
        <img src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" />

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" /> -->
      </figure>

      <div class="history-text history-text--garden" data-blend>
        <h2 class="middle-title reveal">
          DER GARTEN
        </h2>

        <p class="middle-body reveal">
          Heute verbindet die Stadtvilla historische Architektur mit modernem studentischem Wohnen. Die erhaltenen Details des Hauses, der großzügige Garten und die ruhige Lage in Berlin Steglitz-Dahlem prägen den besonderen Charakter der Haderslebener Straße 26.
        </p>

        <p class="middle-body reveal">
          Die Wohnungen und Zimmer werden Schritt für Schritt modernisiert und so gestaltet, dass sie zeitgemäßes Wohnen ermöglichen, ohne den ursprünglichen Charme des Hauses zu verlieren.
        </p>
      </div>

    </div>
  </section>

  <!-- Block 3 -->
  <section class="section haus-history haus-history--architect">
    <div class="container history-grid history-grid--architect">

      <div class="history-text history-text--architect" data-blend>
        <h2 class="middle-title reveal">
          DER ARCHITEKT
        </h2>

        <p class="middle-body reveal">
          Leo Nachtlicht wurde 1872 in Bielitz, Schlesien, geboren. Nach seinem Architektur-Studium arbeitete er bei Bruno Möhring und betrieb ab 1904 ein eigenes Atelier in Berlin. 
          Leo Nachtlicht entwarf und baute Landhäuser, Villen und deren 
          Inneneinrichtungen, wie z.B. auch in der H26 ein schönes Holzzimmer und das geschwungene holzverkleidete Treppenhaus, die original erhalten sind.
        </p>

        <p class="middle-body reveal">
          Zu Nachtlichts bedeutendsten Gebäuden zählt neben dem Ausstellungsgebäude der Berliner Secession vor allem auch der Gourmenia-Palast, dem Vorläufer des heutigen BIKINI BERLIN am Zoo. 
          Als besondere Attraktion wurde im rückwärtigen Teil des Gebäudes, 
          direkt am Berliner Zoo, das dreigeschossige Weinrestaurant „Traube“ mit einem subtropischen Garten mit Bäumen und großblättrigen Pflanzen, Blumen und bunten Vögeln errichtet. 
        </p>

        <p class="middle-body reveal">
          Der Gourmenia-Palast gehörte zu den größten Gaststätten, die Ende der zwanziger Jahre eröffnet wurden. Nach nur wenigen Betriebsjahren wurde das Gebäude im Zweiten Weltkrieg allerdings völlig zerstört.
          <br><br>
          Ab 1933 wurde Leo Nachtlicht als Jude die Arbeitserlaubnis entzogen. Am 22.09.1942 starb er, wahrscheinlich an den Folgen eines Selbstmordversuchs,
          und wurde auf dem jüdischen Friedhof Berlin-Weißensee bestattet.
          <br><br>
          Textquellen:
          <br>
          Text auszugsweise aus openpr.de „BIKINI BERLIN - Hommage an Leo Nachtlicht“ und stolpersteine-berlin/Leo Nachtlicht
        </p>
      </div>

      <div class="image-composition image-composition--architect" data-blend data-bd="110ms">
        <figure class="composition-image architect-image--main reveal">
          <img src={`${base}das-haus/houseaesthetic.webp`} alt="Innenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <figure class="composition-image architect-image--side reveal">
          <img src={`${base}das-haus/Aussenansicht.webp`} alt="Außenansicht der Stadtvilla" loading="lazy" decoding="async" />
        </figure>

        <!-- ausgeklammert -->
        <!-- <img class="reveal" src={`${base}das-haus/staircase.webp`} alt="Treppenhaus der Stadtvilla" loading="lazy" decoding="async" /> -->
        <!-- <img class="reveal" src={`${base}das-haus/vonoben.webp`} alt="Ansicht der Stadtvilla von oben" loading="lazy" decoding="async" /> -->
      </div>

    </div>
  </section>

</Layout>

<style>

/* Sections */

.haus-history {
  padding-block: 0;
}

.haus-history--intro {
  padding-top: clamp(3rem, 5vw, 5rem);
}

.haus-history--garden {
  padding-top: clamp(3.25rem, 5.5vw, 5.5rem);
}

.haus-history--architect {
  padding-top: clamp(3.5rem, 6vw, 6rem);
  padding-bottom: clamp(4rem, 7vw, 7rem);
}

/* Layout */

.history-grid {
  display: grid;
  align-items: center;
  gap: clamp(2.25rem, 4vw, 4.5rem);
}

.history-grid--intro {
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
}

.history-grid--garden {
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
}

.history-grid--architect {
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: start;
}

/* Text */

.history-text {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.history-text--intro {
  align-self: start;
  padding-top: clamp(0.5rem, 2vw, 1.5rem);
}

.history-text--garden {
  max-width: 48ch;
}

.history-text--architect {
  max-width: 56ch;
}

.middle-title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(1.9rem, 3.1vw, 2.65rem);
  font-weight: 300;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  line-height: 1.02;
  margin: 0;
  color: var(--ink);
}

.middle-body {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--muted);
  margin: 0;
}

/* Images shared */

.image-composition,
.composition-image,
.garden-image {
  margin: 0;
}

.composition-image,
.garden-image {
  overflow: hidden;
  background: var(--bg);
}

.composition-image img,
.garden-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Block 1 collage */

.image-composition--intro {
  position: relative;
  height: clamp(360px, 39vw, 560px);
}

.composition-image--hero {
  position: absolute;
  top: 0;
  right: 0;
  width: 68%;
  height: 82%;
  z-index: 1;
}

.composition-image--floating {
  position: absolute;
  left: 13%;
  bottom: 0;
  width: 43%;
  height: 40%;
  z-index: 2;
  border: 0.75rem solid var(--bg);
}

.composition-image--hero img {
  object-position: center;
}

.composition-image--floating img {
  object-position: center;
}

/* Block 2 large image */

.garden-image {
  width: 100%;
  height: clamp(330px, 34vw, 500px);
}

.garden-image img {
  object-position: center;
}

/* Block 3 collage */

.image-composition--architect {
  position: sticky;
  top: 7rem;
  height: clamp(520px, 54vw, 720px);
}

.architect-image--main {
  position: absolute;
  top: 0;
  left: 0;
  width: 82%;
  height: 67%;
  z-index: 1;
}

.architect-image--side {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 54%;
  height: 36%;
  z-index: 2;
  border: 0.75rem solid var(--bg);
}

.architect-image--main img,
.architect-image--side img {
  object-position: center;
}

/* Responsive */

@media (max-width: 900px) {
  .history-grid--intro,
  .history-grid--garden,
  .history-grid--architect {
    grid-template-columns: 1fr;
  }

  .history-grid--garden .garden-image {
    order: 2;
  }

  .history-grid--garden .history-text {
    order: 1;
  }

  .history-text--garden,
  .history-text--architect {
    max-width: none;
  }

  .image-composition--architect {
    position: relative;
    top: auto;
    height: clamp(360px, 72vw, 580px);
  }
}

@media (max-width: 600px) {
  .haus-history--intro {
    padding-top: clamp(2.25rem, 9vw, 3.25rem);
  }

  .haus-history--garden,
  .haus-history--architect {
    padding-top: clamp(2.75rem, 10vw, 4rem);
  }

  .history-grid {
    gap: clamp(1.75rem, 7vw, 2.5rem);
  }

  .image-composition--intro {
    height: 108vw;
  }

  .composition-image--hero {
    width: 82%;
    height: 67%;
  }

  .composition-image--floating {
    left: 0;
    width: 58%;
    height: 34%;
    border-width: 0.5rem;
  }

  .garden-image {
    height: 68vw;
  }

  .image-composition--architect {
    height: 105vw;
  }

  .architect-image--main {
    width: 84%;
    height: 66%;
  }

  .architect-image--side {
    width: 58%;
    height: 34%;
    border-width: 0.5rem;
  }
}

</style>
