---
const { title = "HoBB" } = Astro.props;
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <style>
      :root {
        --fg: #fff;
        --bg: #000;
      }
      html, body { height: 100%; }
      body { margin: 0; background: var(--bg); color: var(--fg); }
      main { min-height: 100%; }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <main><slot /></main>
  </body>
</html>
