---
import Header from "../components/Header.astro";
import ImageZoom from "../components/ImageZoom.astro";
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
const { title = "Haderslebener 26", description = "WGs für Studierende in einer Berliner Art-Déco-Villa aus den 1920er Jahren.", noPadding = false } = Astro.props;
---
<html lang="de" data-base={import.meta.env.BASE_URL} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ViewTransitions fallback="animate" />
    <link rel="preconnect" href="https://maps.googleapis.com" />
    <link rel="preconnect" href="https://maps.gstatic.com" crossorigin />
    <!-- Cursor hint: ensures pointer cursor on interactive elements before external CSS loads -->
    <style>a,button{cursor:pointer}</style>
    <!-- Inline lang-init: runs before paint to avoid DE→EN flash -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('vt-lang') || 'de';
        if (lang === 'en') document.documentElement.setAttribute('data-lang', 'en');
      })();
    </script>
  </head>
  <body>
    <script is:inline>
      document.documentElement.classList.remove('no-js');

      // Fade-in all images when loaded. Handles cached images
      // (complete check) and fresh loads (event listener).
      function initImageFadeIn() {
        document.querySelectorAll('img').forEach(function(img) {
          if (img.complete && img.naturalHeight > 0) {
            img.classList.add('loaded');
          } else {
            img.addEventListener('load', function() { img.classList.add('loaded'); });
            img.addEventListener('error', function() { img.classList.add('loaded'); });
          }
        });
      }
      initImageFadeIn();
      document.addEventListener('astro:page-load', initImageFadeIn);
    </script>
    <Header />
    <main style={noPadding ? '' : 'padding-top: 5rem;'}><slot /></main>
    <ImageZoom />
    <footer class="site-footer">
      <div class="container reveal">
        <a class="footer-wordmark" href={`${import.meta.env.BASE_URL}datenschutzerklaerung/`}>
          Datenschutzerklärung
        </a>
        <nav class="footer-nav">
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-de>Impressum & Kontakt</a>
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-en>Legal Notice & Contact</a>
        </nav>
        <small class="footer-copy">© Haderslebener 26 Berlin</small>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // All site images — prefetched in background after page load
        var allSiteImages = [
          'first-image.webp',
          'das-haus/staircase.webp',
          'das-haus/houseaesthetic.webp',
          'das-haus/vonoben.webp',
          'das-haus/Eingangsbereich.webp',
          'das-haus/Aussenansicht.webp',
          'das-haus/ehepaar_nachtlicht.webp',
          'wohngemeinschaften/wohnung-2OG/grundriss.webp',
          'wohngemeinschaften/wohnung-2OG/kitchen-1.webp',
          'wohngemeinschaften/wohnung-2OG/dining-room-1.webp',
          'wohngemeinschaften/wohnung-1OG/grundriss.webp',
          'zimmer/2og-zimmer-1/cover.webp',
        ];
        var base = document.documentElement.getAttribute('data-base') || '/';

        // After load: prefetch all site images into HTTP cache.
        // Current-page images are already loading; these fill the cache for
        // every other page the user might navigate to next.
        window.addEventListener('load', function () {
          var alreadyPrefetched = new Set(
            Array.from(document.querySelectorAll('link[rel="prefetch"][as="image"]'))
              .map(function(l) { return l.getAttribute('href'); })
          );
          // Short delay so we don't compete with the current page finishing up
          setTimeout(function () {
            allSiteImages.forEach(function (src) {
              var href = base + src;
              if (alreadyPrefetched.has(href)) return;
              var link = document.createElement('link');
              link.rel = 'prefetch';
              link.as = 'image';
              link.href = href;
              document.head.appendChild(link);
            });
          }, 800);
        }, { once: true });

        // Re-apply language preference after View Transitions navigation.
        // Remove attribute for DE to match Header's contract (html:not([data-lang="en"]) handles DE).
        document.addEventListener('astro:page-load', function () {
          var lang = localStorage.getItem('vt-lang') || 'de';
          if (lang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
          } else {
            document.documentElement.removeAttribute('data-lang');
          }
        });
      })();
    </script>
    <script>
      function preloadLazyImages() {
        // Wait until page is fully interactive, then quietly load
        // all lazy images on this page in the background.
        // Uses new Image() to preload into browser cache — more
        // reliable cross-browser than changing the loading attribute.
        requestIdleCallback(() => {
          document.querySelectorAll('img[loading="lazy"]').forEach(img => {
            if (!img.complete) {
              const preload = new Image();
              preload.src = img.src;
            }
          });
        }, { timeout: 3000 });
      }
      // requestIdleCallback fallback for Safari
      if (!window.requestIdleCallback) {
        window.requestIdleCallback = (cb) => setTimeout(cb, 200);
      }
      preloadLazyImages();
      document.addEventListener('astro:page-load', preloadLazyImages);
    </script>
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let lenis;

      function initLenis() {
        lenis?.destroy();
        lenis = new Lenis({
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => { lenis.raf(time * 1000); });
        gsap.ticker.lagSmoothing(0);
      }

      function initReveals() {
        ScrollTrigger.getAll().forEach(t => t.kill());

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reducedMotion) {
          document.querySelectorAll('.reveal, .reveal-child').forEach(el => {
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          document.querySelectorAll('.deco-rule').forEach(r => r.classList.add('is-visible'));
          return;
        }

        gsap.utils.toArray('.reveal').forEach(el => {
          const tw = gsap.to(el, { y: 0, opacity: 1, duration: 1, ease: 'power3.out', paused: true });
          ScrollTrigger.create({ trigger: el, start: 'top 88%', onEnter: () => tw.play(), onEnterBack: () => tw.play() });
          ScrollTrigger.create({ trigger: el, start: 'top bottom+=200', onLeaveBack: () => tw.pause(0) });
        });

        gsap.utils.toArray('.reveal-stagger').forEach(parent => {
          if (parent.classList.contains('cards')) return;
          const children = parent.querySelectorAll('.reveal-child');
          const tw = gsap.to(children, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out', stagger: 0.15, paused: true });
          ScrollTrigger.create({ trigger: parent, start: 'top 85%', onEnter: () => tw.play(), onEnterBack: () => tw.play() });
          ScrollTrigger.create({ trigger: parent, start: 'top bottom+=200', onLeaveBack: () => tw.pause(0) });
        });

        gsap.utils.toArray('.reveal-image').forEach(el => {
          ScrollTrigger.create({ trigger: el, start: 'top 90%', onEnter: () => { el.classList.remove('is-hidden'); el.classList.add('is-visible'); }, onEnterBack: () => { el.classList.remove('is-hidden'); el.classList.add('is-visible'); } });
          ScrollTrigger.create({ trigger: el, start: 'top bottom+=200', onLeaveBack: () => { el.classList.remove('is-visible'); el.classList.add('is-hidden'); } });
        });

        document.querySelectorAll('.deco-rule').forEach(r => {
          ScrollTrigger.create({ trigger: r, start: 'top 90%', onEnter: () => r.classList.add('is-visible'), onEnterBack: () => r.classList.add('is-visible') });
          ScrollTrigger.create({ trigger: r, start: 'top bottom+=200', onLeaveBack: () => r.classList.remove('is-visible') });
        });

        ScrollTrigger.refresh();
      }

      initLenis();
      initReveals();
      document.addEventListener('astro:page-load', () => { initLenis(); initReveals(); });
      document.addEventListener('astro:after-swap', () => { lenis?.scrollTo(0, { immediate: true }); });
    </script>
  </body>
</html>

<script>
  import { initBlendReveal } from '../scripts/blend-reveal';
  document.addEventListener('astro:page-load', () => initBlendReveal());
</script>

<style>
.site-footer {
  border-top: 1px solid var(--border);
  padding-block: var(--sp-md);
  margin-top: var(--sp-lg);
}
.site-footer .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}
.footer-wordmark {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 300;
  text-decoration: none;
  color: var(--ink);
}
.footer-wordmark:hover {
  color: var(--gold);
}
.footer-nav a {
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--muted);
}
.footer-nav a:hover { color: var(--ink); }
.footer-copy {
  font-size: 0.75rem;
  color: var(--muted);
  letter-spacing: 0.05em;
}
</style>
