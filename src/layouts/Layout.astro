---
import Header from "../components/Header.astro";
import ImageZoom from "../components/ImageZoom.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
const { title = "Villa Theo", description = "Studenten-Wohngemeinschaften in einer Berliner Art-Déco-Villa aus den 1920er Jahren." } = Astro.props;
---
<html lang="de" data-base={import.meta.env.BASE_URL} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
    <!-- Cursor hint: ensures pointer cursor on interactive elements before external CSS loads -->
    <style>a,button{cursor:pointer}</style>
    <!-- Inline lang-init: runs before paint to avoid DE→EN flash -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('vt-lang') || 'de';
        if (lang === 'en') document.documentElement.setAttribute('data-lang', 'en');
      })();
    </script>
  </head>
  <body>
    <script is:inline>
      document.documentElement.classList.remove('no-js');

      // Fade-in all images when loaded. Handles cached images
      // (complete check) and fresh loads (event listener).
      function initImageFadeIn() {
        document.querySelectorAll('img').forEach(function(img) {
          if (img.complete && img.naturalHeight > 0) {
            img.classList.add('loaded');
          } else {
            img.addEventListener('load', function() { img.classList.add('loaded'); });
            img.addEventListener('error', function() { img.classList.add('loaded'); });
          }
        });
      }
      initImageFadeIn();
      document.addEventListener('astro:page-load', initImageFadeIn);
    </script>
    <Header />
    <main><slot /></main>
    <ImageZoom />
    <footer class="site-footer">
      <div class="container">
        <span class="footer-wordmark">Villa Theo</span>
        <nav class="footer-nav">
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-de>Impressum & Kontakt</a>
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-en>Legal Notice & Contact</a>
        </nav>
        <small class="footer-copy">© Villa Theo Berlin</small>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // All site images — prefetched in background after page load
        var allSiteImages = [
          'first-image.png',
          'das-haus/staircase.jpg',
          'das-haus/houseaesthetic.jpg',
          'das-haus/vonoben.png',
          'das-haus/Eingangsbereich.jpeg',
          'das-haus/Aussenansicht.jpeg',
          'das-haus/dashaus-wohngemeinschaften.png',
          'das-haus/dashaus-lage.jpg',
          'das-haus/ehepaar_nachtlicht.jpg',
          'wohngemeinschaften/wohnung-2OG/grundriss.png',
          'wohngemeinschaften/wohnung-2OG/kitchen-1.jpeg',
          'wohngemeinschaften/wohnung-2OG/dining-room-1.jpeg',
          'wohngemeinschaften/wohnung-2OG/bathroom-1.jpg',
          'wohngemeinschaften/wohnung-1OG/grundriss.png',
          'wohngemeinschaften/wohnung-1OG/dining-room-1.jpeg',
          'zimmer/2og-zimmer-1/cover.jpeg',
          'zimmer/2og-zimmer-2/cover.png',
          'zimmer/2og-zimmer-2/2a.png'
        ];
        var base = document.documentElement.getAttribute('data-base') || '/';

        // After load: prefetch all site images into HTTP cache.
        // Current-page images are already loading; these fill the cache for
        // every other page the user might navigate to next.
        window.addEventListener('load', function () {
          var alreadyPrefetched = new Set(
            Array.from(document.querySelectorAll('link[rel="prefetch"][as="image"]'))
              .map(function(l) { return l.getAttribute('href'); })
          );
          // Short delay so we don't compete with the current page finishing up
          setTimeout(function () {
            allSiteImages.forEach(function (src) {
              var href = base + src;
              if (alreadyPrefetched.has(href)) return;
              var link = document.createElement('link');
              link.rel = 'prefetch';
              link.as = 'image';
              link.href = href;
              document.head.appendChild(link);
            });
          }, 800);
        }, { once: true });

        // Re-apply language preference after View Transitions navigation.
        // Remove attribute for DE to match Header's contract (html:not([data-lang="en"]) handles DE).
        document.addEventListener('astro:page-load', function () {
          var lang = localStorage.getItem('vt-lang') || 'de';
          if (lang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
          } else {
            document.documentElement.removeAttribute('data-lang');
          }
        });
      })();
    </script>
    <script>
      function preloadLazyImages() {
        // Wait until page is fully interactive, then quietly load
        // all lazy images on this page in the background.
        // Uses new Image() to preload into browser cache — more
        // reliable cross-browser than changing the loading attribute.
        requestIdleCallback(() => {
          document.querySelectorAll('img[loading="lazy"]').forEach(img => {
            if (!img.complete) {
              const preload = new Image();
              preload.src = img.src;
            }
          });
        }, { timeout: 3000 });
      }
      // requestIdleCallback fallback for Safari
      if (!window.requestIdleCallback) {
        window.requestIdleCallback = (cb) => setTimeout(cb, 200);
      }
      preloadLazyImages();
      document.addEventListener('astro:page-load', preloadLazyImages);
    </script>
  </body>
</html>

<script>
  import { initBlendReveal } from '../scripts/blend-reveal';
  document.addEventListener('astro:page-load', () => initBlendReveal());
</script>

<style>
/* Page transition — fast fade-out, gentle fade-up on enter */
::view-transition-old(root) {
  animation: vt-out 0.18s cubic-bezier(0.4, 0, 1, 1) both;
}
::view-transition-new(root) {
  animation: vt-in 0.32s cubic-bezier(0, 0, 0.2, 1) both;
}
@keyframes vt-out {
  to { opacity: 0; }
}
@keyframes vt-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.site-footer {
  border-top: 1px solid var(--border);
  padding-block: var(--sp-md);
  margin-top: var(--sp-lg);
}
.site-footer .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}
.footer-wordmark {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 300;
}
.footer-nav a {
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--muted);
}
.footer-nav a:hover { color: var(--ink); }
.footer-copy {
  font-size: 0.75rem;
  color: var(--muted);
  letter-spacing: 0.05em;
}
</style>
