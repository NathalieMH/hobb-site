---
import Header from "../components/Header.astro";
import ImageZoom from "../components/ImageZoom.astro";
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
const { title = "Villa Theo", description = "Studenten-Wohngemeinschaften in einer Berliner Art-Déco-Villa aus den 1920er Jahren." } = Astro.props;
---
<html lang="de" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <ViewTransitions fallback="animate" />
    <!-- Cursor hint: ensures pointer cursor on interactive elements before external CSS loads -->
    <style>a,button{cursor:pointer}</style>
    <!-- Inline lang-init: runs before paint to avoid DE→EN flash -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('vt-lang') || 'de';
        if (lang === 'en') document.documentElement.setAttribute('data-lang', 'en');
      })();
    </script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <ImageZoom />
    <footer class="site-footer">
      <div class="container">
        <span class="footer-wordmark">Villa Theo</span>
        <nav class="footer-nav">
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-de>Impressum & Kontakt</a>
          <a href={`${import.meta.env.BASE_URL}impressum-kontakt/`} data-en>Legal Notice & Contact</a>
        </nav>
        <small class="footer-copy">© Villa Theo Berlin</small>
      </div>
    </footer>
    <script is:inline>
      (function () {
        // All site images — prefetched in background after page load
        var allSiteImages = [
          'first-image.png',
          'das-haus/staircase.jpg',
          'das-haus/houseaesthetic.jpg',
          'das-haus/vonoben.png',
          'das-haus/Eingangsbereich.jpeg',
          'das-haus/Aussenansicht.jpeg',
          'das-haus/dashaus-wohngemeinschaften.png',
          'das-haus/dashaus-lage.jpg',
          'das-haus/ehepaar_nachtlicht.jpg',
          'wohngemeinschaften/wohnung-2OG/grundriss.png',
          'wohngemeinschaften/wohnung-2OG/kitchen-1.jpeg',
          'wohngemeinschaften/wohnung-2OG/dining-room-1.jpeg',
          'wohngemeinschaften/wohnung-2OG/bathroom-1.jpg',
          'wohngemeinschaften/wohnung-1OG/grundriss.png',
          'wohngemeinschaften/wohnung-1OG/dining-room-1.jpeg',
          'zimmer/2og-zimmer-1/cover.jpeg',
          'zimmer/2og-zimmer-2/cover.png',
          'zimmer/2og-zimmer-2/2a.png'
        ];
        var base = document.documentElement.getAttribute('data-base') || '/';

        // After load: prefetch all site images into HTTP cache.
        // Current-page images are already loading; these fill the cache for
        // every other page the user might navigate to next.
        window.addEventListener('load', function () {
          var alreadyPrefetched = new Set(
            Array.from(document.querySelectorAll('link[rel="prefetch"][as="image"]'))
              .map(function(l) { return l.getAttribute('href'); })
          );
          // Short delay so we don't compete with the current page finishing up
          setTimeout(function () {
            allSiteImages.forEach(function (src) {
              var href = base + src;
              if (alreadyPrefetched.has(href)) return;
              var link = document.createElement('link');
              link.rel = 'prefetch';
              link.as = 'image';
              link.href = href;
              document.head.appendChild(link);
            });
          }, 800);
        }, { once: true });

        var _vtSwapping = false;

        function revealImg(img) { img.classList.add('img-loaded'); }
        function watchImg(img) {
          var alwaysFade = img.hasAttribute('data-always-fade');
          function reveal() {
            // During astro:after-swap (inside the VT callback): reveal synchronously
            // so the img is visible in the VT new-state snapshot.
            // On initial page load: use double-rAF for data-always-fade so the
            // CSS opacity transition fires correctly.
            if (alwaysFade && !_vtSwapping) {
              requestAnimationFrame(function () { requestAnimationFrame(function () { revealImg(img); }); });
            } else {
              revealImg(img);
            }
          }
          if (img.complete && img.naturalWidth > 0) { reveal(); return; }
          img.addEventListener('load', reveal, { once: true });
        }

        // astro:after-swap fires inside the ViewTransition callback, BEFORE the
        // browser takes its new-state snapshot. Revealing cached images here makes
        // them visible in the snapshot, preventing the blank-then-flash effect.
        document.addEventListener('astro:after-swap', function () {
          _vtSwapping = true;
          document.querySelectorAll('img').forEach(watchImg);
          _vtSwapping = false;
        });

        // astro:page-load fires after the VT animation completes (also on initial load).
        // Picks up any images that weren't cached yet when after-swap ran.
        document.addEventListener('astro:page-load', function () {
          document.querySelectorAll('img').forEach(watchImg);
          // Re-apply language preference after navigation.
          // Remove attribute for DE to match Header's contract (html:not([data-lang="en"]) handles DE).
          var lang = localStorage.getItem('vt-lang') || 'de';
          if (lang === 'en') {
            document.documentElement.setAttribute('data-lang', 'en');
          } else {
            document.documentElement.removeAttribute('data-lang');
          }
        });

        // MutationObserver watches for images injected dynamically (room modals, etc.)
        // Guard prevents duplicate observers if this script block ever re-executes.
        document.addEventListener('DOMContentLoaded', function () {
          if (window.__vtMutObserver) return;
          window.__vtMutObserver = true;
          new MutationObserver(function (mutations) {
            mutations.forEach(function (m) {
              if (m.type === 'attributes' && m.target.nodeName === 'IMG') {
                var img = m.target;
                img.classList.remove('img-loaded');
                watchImg(img);
              }
              if (m.type === 'childList') {
                m.addedNodes.forEach(function (n) {
                  if (n.nodeName === 'IMG') watchImg(n);
                  else if (n.querySelectorAll) n.querySelectorAll('img').forEach(watchImg);
                });
              }
            });
          }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['src'] });
        });
      })();
    </script>
  </body>
</html>

<script>
  import { initBlendReveal } from '../scripts/blend-reveal';
  document.addEventListener('astro:page-load', () => initBlendReveal());
</script>

<style>
/* Page transition — fast fade-out, gentle fade-up on enter */
::view-transition-old(root) {
  animation: vt-out 0.18s cubic-bezier(0.4, 0, 1, 1) both;
}
::view-transition-new(root) {
  animation: vt-in 0.32s cubic-bezier(0, 0, 0.2, 1) both;
}
@keyframes vt-out {
  to { opacity: 0; }
}
@keyframes vt-in {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

.site-footer {
  border-top: 1px solid var(--border);
  padding-block: var(--sp-md);
  margin-top: var(--sp-lg);
}
.site-footer .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-sm);
}
.footer-wordmark {
  font-family: var(--font-serif);
  font-size: 1.1rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 300;
}
.footer-nav a {
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--muted);
}
.footer-nav a:hover { color: var(--ink); }
.footer-copy {
  font-size: 0.75rem;
  color: var(--muted);
  letter-spacing: 0.05em;
}
</style>
